[resource]
script = ExtResource("10_wtt7h")
id = &"timing"
display_name = "时机"
display_names = {
"en": "Timing"
}
description = "时机槽：放进去的道具按材质定「什么时候」（每种材质各不同，来源标签兜底），按用途定方向（造成 / 受到）并乘节奏系数（武器快、盾中、防具慢），按稀有度定多久一次。"
material = Array[ExtResource("1_5y6vs")]([SubResource("Resource_6r7ig"), SubResource("Resource_iv7u8"), SubResource("Resource_kx4o6"), SubResource("Resource_p81pj"), SubResource("Resource_h8ipy"), SubResource("Resource_hbt5q"), SubResource("Resource_w0w6u"), SubResource("Resource_l5sma"), SubResource("Resource_13pbg"), SubResource("Resource_hfbih"), SubResource("Resource_qbqmk"), SubResource("Resource_v0wpc"), SubResource("Resource_i4xbh"), SubResource("Resource_qx4v6")])
purpose = Array[ExtResource("1_5y6vs")]([SubResource("Resource_2v228"), SubResource("Resource_jjvna"), SubResource("Resource_sr4aq"), SubResource("Resource_2dh86")])
rarity = Array[ExtResource("1_5y6vs")]([SubResource("Resource_epg7f"), SubResource("Resource_0nlf3"), SubResource("Resource_vlvck"), SubResource("Resource_wvjs0"), SubResource("Resource_sony3"), SubResource("Resource_fxbap"), SubResource("Resource_7gbfw")])
