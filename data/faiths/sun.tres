[resource]
script = ExtResource("13_0jkdj")
id = &"sun"
display_name = "日神"
display_names = {
"en": "The Sun God"
}
god = "日神（太阳、火、周期性重复）"
gods = {
"en": "The Sun God (the sun, fire, cyclical repetition)"
}
description = "恒常（周期循环）被人类推向太阳、又夺了火；帝国诸神之一，日神一族地位崇高"
