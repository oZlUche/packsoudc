[resource]
script = ExtResource("12_fcqfh")
id = &"sun"
display_name = "日神"
display_names = {
"en": "The Sun God"
}
god = "日神（太阳、火、周期性重复）"
gods = {
"en": "The Sun God (the sun, fire, cyclical repetition)"
}
description = "恒常（周期循环）被人类推向太阳、又夺了火；帝国诸神之一，日神一族地位崇高"
descriptions = {
"en": "Constancy (the recurring cycle), which humans pushed onto the sun before stealing its fire; one of the Empire's gods, and the Sun God's people hold high standing."
}
core_line = "日月：进入战斗时为白昼，6 秒后换成黑夜，之后每 6 秒一换；白昼伤害 +15%，黑夜急速 +15%"
core_lines = {
"en": "Sun and Moon: battles start in Day, which turns to Night after 6 seconds and alternates every 6 seconds; Day +15% damage, Night +15% Haste"
}
thresholds = Array[int]([42, 117, 217])
deeds = Array[ExtResource("5_vxfes")]([SubResource("Resource_nxral")])
offerings = Array[ExtResource("7_d5eql")]([SubResource("Resource_t1fft"), SubResource("Resource_r2xcc"), SubResource("Resource_gdva3"), SubResource("Resource_fmsvn")])
