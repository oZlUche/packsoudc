[resource]
script = ExtResource("12_xhs8b")
id = &"earth"
display_name = "大地之神"
display_names = {
"en": "God of the Earth"
}
god = "大地之神（体积、空间）"
gods = {
"en": "God of the Earth (volume, space)"
}
description = "帝国祭祀的主神之一，但信徒很少，对应种族也极为低调"
descriptions = {
"en": "One of the chief gods in the Empire's rites, but with very few followers; its people keep a very low profile."
}
core_line = "天地：边缘贴近棋盘边界的道具成为【大地】，非【大地】道具中贴近棋盘中央的道具成为【穹顶】"
core_lines = {
"en": "Heaven and Earth: items whose edge touches the Board's border become Earth; of the rest, items near the Board's centre become Dome"
}
thresholds = Array[int]([42, 117, 217])
deeds = Array[ExtResource("5_texte")]([SubResource("Resource_tr00d"), SubResource("Resource_uajvw")])
offerings = Array[ExtResource("7_gfojj")]([SubResource("Resource_eoqlt")])
perks = Array[ExtResource("8_81xyc")]([SubResource("Resource_iqm5g"), SubResource("Resource_72j3p"), SubResource("Resource_udmsc")])
