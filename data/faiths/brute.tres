[resource]
script = ExtResource("13_h1qlm")
id = &"brute"
display_name = "蛮神"
display_names = {
"en": "The Brute"
}
god = "蛮神（暴力与杀戮：力 / 冲撞）"
gods = {
"en": "The Brute (violence and slaughter: force / impact)"
}
description = "自然的概念（石头砸下也是暴力）；北境蛮族信祂，帝国边缘行省大多也信，帝国诸神之一，但地位不高"
descriptions = {
"en": "A concept of nature (a falling stone is violence too). Worshipped by the northern barbarians and by most of the Empire's border provinces; one of the Empire's gods, but of low standing."
}
thresholds = Array[int]([42, 117, 217])
deeds = Array[ExtResource("5_thvtn")]([SubResource("Resource_w6b0e"), SubResource("Resource_umwjh")])
offerings = Array[ExtResource("7_7cvah")]([SubResource("Resource_qgcs4"), SubResource("Resource_dwbhk"), SubResource("Resource_dyeg3")])
