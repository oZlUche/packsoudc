[gd_resource type="Resource" script_class="NpcDef" format=3]

[ext_resource type="Script" path="res://core/meta/npcs/npc_line.gd" id="1_a6um5"]
[ext_resource type="Script" path="res://core/run/events/event_condition.gd" id="2_01xmg"]
[ext_resource type="Script" path="res://core/meta/npcs/npc_def.gd" id="3_r0rl5"]
[ext_resource type="Script" path="res://core/meta/npcs/npc_special.gd" id="4_1bm52"]

[sub_resource type="Resource" id="Resource_ysiyo"]
script = ExtResource("1_a6um5")
id = &"guide_1"
kind = &"guide"
text = "精英敌人有概率掉落额外的好东西"
texts = {
"en": "Elite foes have a chance to drop something extra."
}

[sub_resource type="Resource" id="Resource_kxwx1"]
script = ExtResource("1_a6um5")
id = &"guide_2"
kind = &"guide"
text = "越往里走，我摆出来的货越好，嘿嘿"
texts = {
"en": "The deeper you go, the finer the wares I lay out. Heh."
}

[sub_resource type="Resource" id="Resource_y1t7s"]
script = ExtResource("1_a6um5")
id = &"guide_3"
kind = &"guide"
text = "东西卖给我就好，我肯定出个公道价格，嘿嘿"
texts = {
"en": "Sell it to me, friend. I always give a fair price. Heh."
}

[sub_resource type="Resource" id="Resource_jwfa7"]
script = ExtResource("1_a6um5")
id = &"guide_4"
kind = &"guide"
text = "待得越久，就越出不去"
texts = {
"en": "The longer you linger, the harder it is to leave."
}

[sub_resource type="Resource" id="Resource_5d60i"]
script = ExtResource("1_a6um5")
id = &"guide_5"
kind = &"guide"
text = "拿不动的先托付给出口那儿接应的人，他们比你先到家"
texts = {
"en": "Hand what you can't carry to the crew waiting at the exit. They'll be home before you."
}

[sub_resource type="Resource" id="Resource_rpkwe"]
script = ExtResource("1_a6um5")
id = &"guide_6"
kind = &"guide"
text = "别太贪心，拿的东西越多，就越走不动路"
texts = {
"en": "Don't be greedy. The more you carry, the slower you walk."
}

[sub_resource type="Resource" id="Resource_7plk4"]
script = ExtResource("1_a6um5")
id = &"greet_1"
kind = &"greet"
text = "哟，来客人了。慢慢看，都是好东西，嘿嘿"
texts = {
"en": "Well, a customer. Take your time, it's all good stuff. Heh."
}

[sub_resource type="Resource" id="Resource_3psvl"]
script = ExtResource("1_a6um5")
id = &"greet_2"
kind = &"greet"
text = "又是你？活着就好，活着才能照顾我生意"
texts = {
"en": "You again? Good, you're alive. The living make better customers."
}

[sub_resource type="Resource" id="Resource_mfldd"]
script = ExtResource("1_a6um5")
id = &"greet_3"
kind = &"greet"
text = "这种地方还能碰上活人，真是缘分。看看货？"
texts = {
"en": "A living soul in a place like this. Must be fate. Care to browse?"
}

[sub_resource type="Resource" id="Resource_r2oko"]
script = ExtResource("1_a6um5")
id = &"greet_4"
kind = &"greet"
text = "别光站着，看上什么尽管拿，价钱好商量"
texts = {
"en": "Don't just stand there. Take what you fancy, the price can be talked over."
}

[sub_resource type="Resource" id="Resource_q2wyy"]
script = ExtResource("1_a6um5")
id = &"greet_5"
kind = &"greet"
text = "朋友，你来得正好，我刚把摊子摆好"
texts = {
"en": "Friend, perfect timing. I've only just laid out the stall."
}

[resource]
script = ExtResource("3_r0rl5")
id = &"shopkeeper"
display_name = "哈基姆"
display_names = {
"en": "Hakim"
}
portrait = &"npc_shopkeeper"
lines = Array[ExtResource("1_a6um5")]([SubResource("Resource_ysiyo"), SubResource("Resource_kxwx1"), SubResource("Resource_y1t7s"), SubResource("Resource_jwfa7"), SubResource("Resource_5d60i"), SubResource("Resource_rpkwe"), SubResource("Resource_7plk4"), SubResource("Resource_3psvl"), SubResource("Resource_mfldd"), SubResource("Resource_r2oko"), SubResource("Resource_q2wyy")])
