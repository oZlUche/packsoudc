[ext_resource type="Script" path="res://core/meta/npcs/npc_line.gd" id="1_6qc6i"]
[ext_resource type="Script" path="res://core/run/events/event_condition.gd" id="2_bnsme"]
[ext_resource type="Script" path="res://core/meta/npcs/npc_def.gd" id="3_rnbg0"]
[ext_resource type="Script" path="res://core/meta/npcs/npc_special.gd" id="4_2wuap"]

[sub_resource type="Resource" id="Resource_umfwl"]
script = ExtResource("1_6qc6i")
id = &"guide_1"
kind = &"guide"
text = "相中了又没钱？先给它拴上，下回来还在"
texts = {
"en": "Fancy it but short on coin? Tie it down and it'll still be here next time."
}

[sub_resource type="Resource" id="Resource_lha24"]
script = ExtResource("1_6qc6i")
id = &"guide_2"
kind = &"guide"
text = "嫌货不好？花点钱我给你换一批，不过越换越贵哦"
texts = {
"en": "Don't like the lot? Pay a little and I'll bring out another. It gets dearer each time, mind."
}

[sub_resource type="Resource" id="Resource_b7ym8"]
script = ExtResource("1_6qc6i")
id = &"guide_3"
kind = &"guide"
text = "买归买，你家库房得放得下"
texts = {
"en": "Buy all you like, so long as your storehouse has room."
}

[sub_resource type="Resource" id="Resource_ueu67"]
script = ExtResource("1_6qc6i")
id = &"guide_4"
kind = &"guide"
text = "隔壁几家翻来覆去就那几样，新鲜玩意儿只在我这儿"
texts = {
"en": "The other stalls sell the same old things. The surprises are all here."
}

[sub_resource type="Resource" id="Resource_wtfqr"]
script = ExtResource("1_6qc6i")
id = &"guide_5"
kind = &"guide"
text = "等你家底厚了，我的货色也跟着上档次"
texts = {
"en": "Once your house is better off, my wares go up a notch too."
}

[sub_resource type="Resource" id="Resource_ihgxu"]
script = ExtResource("1_6qc6i")
id = &"guide_6"
kind = &"guide"
text = "拴上的和打了星的我一件不收，袋子也不收"
texts = {
"en": "I won't take anything tied down or starred, and no bags."
}

[resource]
script = ExtResource("3_rnbg0")
id = &"stall_keeper"
display_name = "德米特里"
display_names = {
"en": "Demetrios"
}
portrait = &"npc_stall_keeper"
lines = Array[ExtResource("1_6qc6i")]([SubResource("Resource_umfwl"), SubResource("Resource_lha24"), SubResource("Resource_b7ym8"), SubResource("Resource_ueu67"), SubResource("Resource_wtfqr"), SubResource("Resource_ihgxu")])
