[resource]
script = ExtResource("9_5fdte")
id = &"ascension_9"
display_name = "进阶九"
display_names = {
"en": "Ascension IX"
}
description = "进阶八的一切，再加：走进侵蚀了 {erosion_item_layer_from_depth} 层以上的点，随机侵蚀一件随身道具，到 {erosion_item_layer_limit} 层永久损毁；正常撤离后，未损毁道具的侵蚀清零。在进阶八撤离一次后解锁。"
descriptions = {
"en": "Everything in Ascension VIII, and stepping into spots eroded {erosion_item_layer_from_depth}+ layers deep erodes a random carried item; at {erosion_item_layer_limit} layers it is destroyed for good. Extracting normally clears erosion on surviving items. Unlocked by extracting once on Ascension VIII."
}
challenge = "深处侵蚀道具"
challenges = {
"en": "Deep erosion eats items"
}
level = 9
requires_unlock = &"ascension_9"
grants_unlock = &"ascension_10"
mechanics = Array[ExtResource("2_k00fv")]([SubResource("Resource_lhri3"), SubResource("Resource_847xk")])
