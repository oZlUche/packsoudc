[resource]
script = ExtResource("11_nvo7f")
id = &"fire_bleed"
display_name = "燃血"
display_names = {
"en": "Seared Blood"
}
description = "对手叠上反应层数那么多层【燃血】：治疗无效，N 层就每秒受到 N 点火焰伤害、持续 N 秒（层数不掉），再反应就加层加秒。"
descriptions = {
"en": "The opponent gains Seared Blood equal to the reaction stacks: healing does nothing, and with N stacks they take N Fire damage each second for N seconds (stacks don't drop); reacting again adds stacks and seconds."
}
elements = Array[StringName]([&"fire", &"bleed"])
effects = Array[ExtResource("1_krjo3")]([SubResource("Resource_vkbic")])
scaling = [{
"effect": 0,
"field": "stacks",
"kind": "n"
}]
