requires_unlock = &"prologue3_done"
rules = Array[String](["横置的沙漏：从左边进去，穿过中间两条窄道到对侧；撤离点只在最右一列，中途没有。", "这里的敌人是机关：天生格挡，直接伤害先减一截；流血和中毒对它们无效，火、冰、雷照常。", "机关身上掉零件：齿轮臂、蒸汽阀、铆接护板。护板拿回来就是一面小盾。"])
step_limit = 40
safes = 1
chest_skin = &"imperial_camp"
map_skin = &"clockwork"
carry_budget = 600
