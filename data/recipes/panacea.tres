[gd_resource type="Resource" script_class="RecipeDef" format=3]

[ext_resource type="Script" path="res://core/inventory/recipe_def.gd" id="1_gh15g"]

[resource]
script = ExtResource("1_gh15g")
id = &"panacea"
display_name = "万灵药"
display_names = {
"en": "Panacea"
}
inputs = Array[StringName]([&"antidote_satchel", &"styptic_dressing"])
output = &"panacea"
adjacent = true
note = "止血敷料贴着解毒药囊放、点锤：合成万灵药。"
notes = {
"en": "Put the Styptic Dressing next to the Antidote Satchel and tap the hammer: they make a Panacea."
}
