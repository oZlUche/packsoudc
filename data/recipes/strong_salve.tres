[ext_resource type="Script" path="res://core/inventory/recipe_def.gd" id="1_rxs6i"]

[resource]
script = ExtResource("1_rxs6i")
id = &"strong_salve"
display_name = "浓缩伤药"
display_names = {
"en": "Strong Salve"
}
inputs = Array[StringName]([&"salve", &"beeswax"])
