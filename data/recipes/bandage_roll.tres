[gd_resource type="Resource" script_class="RecipeDef" format=3]

[ext_resource type="Script" path="res://core/inventory/recipe_def.gd" id="1_1cife"]

[resource]
script = ExtResource("1_1cife")
id = &"bandage_roll"
display_name = "绷带卷"
display_names = {
"en": "Bandage Roll"
}
inputs = Array[StringName]([&"bandage", &"linen_bolt"])
output = &"bandage_roll"
adjacent = true
note = "亚麻布卷贴着纱布放、点锤：卷成绷带。"
notes = {
"en": "Put the Linen Bolt next to the Bandage and tap the hammer: it rolls into a Bandage Roll."
}
