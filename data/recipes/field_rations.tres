[gd_resource type="Resource" script_class="RecipeDef" format=3]

[ext_resource type="Script" path="res://core/inventory/recipe_def.gd" id="1_nudv1"]

[resource]
script = ExtResource("1_nudv1")
id = &"field_rations"
display_name = "行军军粮"
display_names = {
"en": "Field Rations"
}
inputs = Array[StringName]([&"salted_meat", &"beeswax"])
output = &"field_rations"
note = "把蜂蜡块拖到腌肉干上：封成军粮。"
notes = {
"en": "Drag the Beeswax onto the Salted Meat: it seals into Field Rations."
}
