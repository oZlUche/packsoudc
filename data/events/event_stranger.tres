[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://core/run/events/event_option.gd" id="1_chx3k"]
[ext_resource type="Script" path="res://core/run/events/event_outcome.gd" id="2_doguw"]
[ext_resource type="Script" path="res://core/run/events/outcomes/change_money.gd" id="3_nvu4j"]
[ext_resource type="Script" path="res://core/run/events/outcomes/grant_map_buff.gd" id="4_xby02"]
[ext_resource type="Script" path="res://core/run/events/outcomes/say.gd" id="5_dahyu"]
[ext_resource type="Script" path="res://core/run/events/event_condition.gd" id="6_v7ers"]
[ext_resource type="Script" path="res://core/run/events/conditions/can_afford.gd" id="7_pqjsx"]
