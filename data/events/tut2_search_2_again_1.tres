[resource]
script = ExtResource("5_rkf7e")
id = &"tut2_search_2_again_1"
title = "毒药瓶"
text = "一个{b}毒药瓶{/b}。它自己也能下毒，只是慢（四秒一次）。{c:good}把它拖到匕首上{/c}配成一对，{b}走到下一个点时{/b}就合成涂毒匕首：借匕首的快手，一刀一层毒，叠得飞快。毒{b}无视护甲和护盾{/b}。合成的时候会提示你；要是包里装不下新东西，它会进暂存区，记得放回包里。

再搜一次。"
options = Array[ExtResource("1_g5urj")]([SubResource("Resource_v1ilt")])
