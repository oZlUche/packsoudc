[resource]
script = ExtResource("5_rkf7e")
id = &"tut2_search_2_again_1"
title = "{item:poison_vial}"
text = "一个{item:poison_vial}。它自己也能下毒，只是慢（每 {item_stat:poison_vial:seconds} 秒一次）。{c:good}把它放到{item:knife}旁边（挨着）{/c}，{b}走到下一个点时{/b}就自动合成{item:poisoned_knife}：借{item:knife}的快手，一刀一层毒，叠得飞快。毒{b}无视防护和护盾{/b}。合成的时候会提示你；要是包里装不下新东西，它会进{zone:暂存区}，记得放回包里。

再搜一次。"
options = Array[ExtResource("1_g5urj")]([SubResource("Resource_v1ilt")])
