[sub_resource type="Resource" id="Resource_be2eq"]
script = ExtResource("3_5pej1")
item = &"charm_sun"

[sub_resource type="Resource" id="Resource_xidqa"]
script = ExtResource("4_o8gnc")
text = "两枚护符，两位神。最后放下的那枚说了算。"

[sub_resource type="Resource" id="Resource_gwmy6"]
script = ExtResource("1_thog3")
label = "接过日神的护符"
tags = Array[StringName]([&"offering"])
outcomes = Array[ExtResource("2_84bc3")]([SubResource("Resource_be2eq"), SubResource("Resource_xidqa")])

[resource]
script = ExtResource("6_h1qe8")
id = &"tut3_faith_call_sun"
title = "日神的低语"
text = "另一座祭坛，烧得正旺。一枚{item:charm_sun}摆在火边。

拿了放进包里，你信的就换成{faith:sun}：{faith:brute}那几行字会变灰（休眠），顶端栏的徽记换成{faith:sun}的。{b}两位神的信力各记各的，不会丢{/b}。

想换回来：{b}右键{/b}{item:charm_brute}（或者把它拿起来再放下）—— 最后放下的那枚信物说了算。换神没有代价。"
options = Array[ExtResource("1_thog3")]([SubResource("Resource_gwmy6")])
