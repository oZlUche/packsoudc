[sub_resource type="Resource" id="Resource_56weo"]
script = ExtResource("3_d8nab")

[sub_resource type="Resource" id="Resource_tdj37"]
script = ExtResource("4_ka5hl")
pool = &"metal_cargo"

[sub_resource type="Resource" id="Resource_18pbc"]
script = ExtResource("5_q35rn")
text = "轮子滚回石面，车主把答应的{reward_name}搬到你脚边。"
texts = {
"en": "The wheel rolls back onto the stone, and the owner sets the promised {reward_name} at your feet."
}

[sub_resource type="Resource" id="Resource_a2a6e"]
script = ExtResource("7_r1db2")

[sub_resource type="Resource" id="Resource_g17xk"]
script = ExtResource("1_2fro2")
label = "抬起轮轴（体力 −{spend_vitality_amount}，{reward_name}）"
labels = {
"en": "Lift the axle (Vitality −{spend_vitality_amount}, {reward_name})"
}
requires = Array[ExtResource("6_jry0u")]([SubResource("Resource_a2a6e")])
outcomes = Array[ExtResource("2_wlxyt")]([SubResource("Resource_56weo"), SubResource("Resource_tdj37"), SubResource("Resource_18pbc")])

[sub_resource type="Resource" id="Resource_t0oly"]
script = ExtResource("4_ka5hl")
pool = &"light_salvage"

[sub_resource type="Resource" id="Resource_5l1ja"]
script = ExtResource("5_q35rn")
text = "车主摆摆手，你收起了路边的{reward_name}。"
texts = {
"en": "The owner waves you on, and you pick up the {reward_name} by the road."
}

[sub_resource type="Resource" id="Resource_f0c4d"]
script = ExtResource("1_2fro2")
label = "收拢路旁杂物（轻便材料 ×{give_pool_item_count}）"
labels = {
"en": "Gather the roadside scraps (light material ×{give_pool_item_count})"
}
outcomes = Array[ExtResource("2_wlxyt")]([SubResource("Resource_t0oly"), SubResource("Resource_5l1ja")])

[sub_resource type="Resource" id="Resource_1n67g"]
script = ExtResource("1_2fro2")
label = "离开"
labels = {
"en": "Leave"
}

[resource]
script = ExtResource("8_ibmyo")
id = &"event_stuck_cart"
title = "陷住的货车"
titles = {
"en": "The Stuck Cart"
}
text = "货车斜陷在碎石里，车主正收拢散落的货物。“帮我抬起轮轴，金属货里分你一件。”他指向车底卡住的货箱，路旁另堆着已经顾不上收的绳布杂物。"
texts = {
"en": "A cart lies tilted in the rubble while its owner gathers the spilled load. \"Help me lift the axle and you can have one piece of the metal goods.\" He points at the crate wedged under the cart. Rope and cloth scraps he hasn't bothered with lie piled by the road."
}
options = Array[ExtResource("1_2fro2")]([SubResource("Resource_g17xk"), SubResource("Resource_f0c4d"), SubResource("Resource_1n67g")])
