[ext_resource type="Script" path="res://core/run/events/event_outcome.gd" id="2_xhdw7"]
[ext_resource type="Script" path="res://core/run/events/outcomes/give_item.gd" id="3_4hxw4"]
[ext_resource type="Script" path="res://core/run/events/outcomes/say.gd" id="4_mldol"]
