[resource]
script = ExtResource("4_6klw0")
id = &"tut3_outro"
title = "军团的交代"
text = "「三趟都活着回来了。」来接你的人没多看你一眼，只把一卷空白的纸推过来。「下一趟没有图。那边的废墟每次进去都长得不一样，路得你自己走出来。」

「记住两样。头一样，别久留：进去之后每走一步，日晷就走一格，走完了，没人来接你。走到一半，离你进去那个口最近的免费出口会被封死，地图上会提前标出来。」

「第二样，越往里越值钱，也越要命。最里头坐着这片废墟的主人，把它放倒，直接带着东西出来结算；不想碰它，就从外面几环的出口走。」

「路上有做买卖的、能歇脚的，还有我们埋下的保险箱，鼠标停在点上就看得见。塞进保险箱的东西，就算你死在里头，也会送回来。」

{c:dim}看不懂的词，Esc 菜单里的{ui:百科}都有一页。{/c}"
image = "res://assets/chest/bg/cursed_depths.png"
options = Array[ExtResource("1_te5vh")]([SubResource("Resource_l6t5a")])
