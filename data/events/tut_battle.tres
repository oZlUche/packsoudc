[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://core/run/events/event_option.gd" id="1_v12vg"]
[ext_resource type="Script" path="res://core/run/events/event_outcome.gd" id="2_v0atl"]
[ext_resource type="Script" path="res://core/run/events/outcomes/proceed.gd" id="3_bmll3"]
[ext_resource type="Script" path="res://core/run/events/event_condition.gd" id="4_xytmh"]
[ext_resource type="Script" path="res://core/run/events/conditions/has_item.gd" id="5_tobpy"]
[ext_resource type="Script" path="res://core/run/events/outcomes/next_event.gd" id="6_2xk7h"]
[ext_resource type="Script" path="res://core/run/events/event_def.gd" id="7_p1jvn"]

[sub_resource type="Resource" id="Resource_ap0xx"]
script = ExtResource("3_bmll3")

[sub_resource type="Resource" id="Resource_lyamr"]
script = ExtResource("5_tobpy")
tag = &"weapon"
where = 0

[sub_resource type="Resource" id="Resource_w1tc3"]
script = ExtResource("1_v12vg")
label = "开打"
requires = Array[ExtResource("4_xytmh")]([SubResource("Resource_lyamr")])
outcomes = Array[ExtResource("2_v0atl")]([SubResource("Resource_ap0xx")])

[sub_resource type="Resource" id="Resource_vqrdw"]
script = ExtResource("6_2xk7h")
event = &"tut_battle"

[sub_resource type="Resource" id="Resource_dfsg2"]
script = ExtResource("1_v12vg")
label = "先整理背包（B）"
outcomes = Array[ExtResource("2_v0atl")]([SubResource("Resource_vqrdw")])

[resource]
script = ExtResource("7_p1jvn")
id = &"tut_battle"
title = "整理"
text = "前面有人守着。

战斗是自动的：只有放进包里的东西会参战，武器自己出手，护甲替你挨打。挨着放的东西之间还会互相加成。

先整理背包，把搜到的武器和护甲放进包里，再开打。暂存区里的东西一挪步就会留在原地。"
options = Array[ExtResource("1_v12vg")]([SubResource("Resource_w1tc3"), SubResource("Resource_dfsg2")])
