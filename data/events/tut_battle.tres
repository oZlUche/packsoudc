[ext_resource type="Script" path="res://core/run/events/event_option.gd" id="1_hinyr"]
[ext_resource type="Script" path="res://core/run/events/event_outcome.gd" id="2_ovqxy"]
[ext_resource type="Script" path="res://core/run/events/outcomes/proceed.gd" id="3_v12vg"]
