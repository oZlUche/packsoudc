[sub_resource type="Resource" id="Resource_tobpy"]
script = ExtResource("1_hinyr")
label = "进入战前准备"
outcomes = Array[ExtResource("2_ovqxy")]([SubResource("Resource_xytmh")])

[resource]
script = ExtResource("5_bmll3")
id = &"tut_battle"
title = "整理"
text = "前面有人守着。

开打之前先过一道战前准备：左边是对手的棋盘（带了什么、多少血、大概多少输出），右边是你自己的棋盘和暂存区。战斗是自动的：只有放进包里的东西参战，武器自己出手，护甲替你挨打，挨着放的东西之间还会互相加成。

在准备屏里把搜到的武器和护甲拖进包里；拖出棋盘就是弃置，会掉进暂存区（不参战，打完还在）。整理好了按「开战」，胜负在那一瞬就定了，之后是回放。"
options = Array[ExtResource("1_hinyr")]([SubResource("Resource_tobpy")])
