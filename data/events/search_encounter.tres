[resource]
script = ExtResource("6_cc02l")
id = &"search_encounter"
title = "有人来了"
titles = {
"en": "Someone's Coming"
}
text = "翻动的声响惊动了附近的人。什么都没来得及拿，对方已经到了跟前。"
