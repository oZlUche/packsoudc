[sub_resource type="Resource" id="Resource_a3enw"]
script = ExtResource("1_3rytr")
label = "进入战前准备"
labels = {
"en": "Go to Pre-battle"
}
hint_when_hidden = "先把{item:poison_vial}贴着{item:knife}放，点接缝上的小锤合成{item:poisoned_knife}（按 {key:B} 打开背包）。"
hints_when_hidden = {
"en": "First put the {item:poison_vial} next to the {item:knife} and click the hammer on the seam to craft a {item:poisoned_knife} (press {key:B} to open your pack)."
}
requires = Array[ExtResource("4_j8tyq")]([SubResource("Resource_qy2y1")])
outcomes = Array[ExtResource("2_xotvq")]([SubResource("Resource_5e0yo")])

