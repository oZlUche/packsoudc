[resource]
script = ExtResource("7_3yd0j")
id = &"tut_elite"
title = "守卫"
text = "最后一道门有精英守着：更硬，带的东西也更好。输给精英扣的体力更多。

和刚才一样先进{ui:战前准备}：看清对手的棋盘，把新搜到的也放进包里，调整好位置再按{ui:开战}。

它披着甲，普通刀剑每下都要被削掉一截；{item:poisoned_knife}的毒不看这个。"
options = Array[ExtResource("1_0mh2h")]([SubResource("Resource_rvsn3"), SubResource("Resource_451ot"), SubResource("Resource_5e0yo")])
