[sub_resource type="Resource" id="Resource_rvsn3"]
script = ExtResource("1_0mh2h")
label = "进入战前准备"
hint_when_hidden = "先把{item:poison_vial}拖到{item:knife}上面合成{item:poisoned_knife}（按 {key:B} 打开背包）。"
requires = Array[ExtResource("4_6gsw8")]([SubResource("Resource_2bubv")])
outcomes = Array[ExtResource("2_qjp6d")]([SubResource("Resource_j8tyq")])

[sub_resource type="Resource" id="Resource_3tq8t"]
script = ExtResource("3_atyw6")

[sub_resource type="Resource" id="Resource_y6bsp"]
