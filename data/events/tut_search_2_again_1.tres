[resource]
script = ExtResource("5_5t4dn")
id = &"tut_search_2_again_1"
title = "还有"
titles = {
"en": "There's More"
}
text = "翻出一把{item:scimitar}和一个{item:poison_vial}。{item:poison_vial}自己也能下毒，只是慢。{c:good}把它贴着{item:knife}放、点接缝上的小锤{/c}，两件合成一把{item:poisoned_knife}：借{item:knife}的快手，一刀一层毒。毒{b}无视格挡和护甲{/b} —— 前面那个守卫举着盾，正好用它。{item:scimitar}也带上：放血和毒碰在一起会起反应，到时候看。

下面还压着东西，再翻一次。"
texts = {
"en": "Out come a {item:scimitar} and a {item:poison_vial}. The {item:poison_vial} can poison on its own, just slowly. {c:good}Put it next to the {item:knife} and click the hammer on the seam{/c}, and the two craft into a {item:poisoned_knife}: the {item:knife}'s quick hand, one stack of poison per cut. Poison {b}ignores Block and Armor{/b}. The guard up ahead carries a shield, so this is the tool for him. Take the {item:scimitar} too: bleed and poison react when they meet. You'll see.

There's still something buried underneath. Search once more."
}
options = Array[ExtResource("1_fvluw")]([SubResource("Resource_0t2gg")])
