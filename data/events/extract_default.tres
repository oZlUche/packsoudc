[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://core/run/events/event_option.gd" id="1_3heij"]
[ext_resource type="Script" path="res://core/run/events/event_outcome.gd" id="2_7rcik"]
[ext_resource type="Script" path="res://core/run/events/outcomes/extract.gd" id="3_d6uot"]
[ext_resource type="Script" path="res://core/run/events/event_condition.gd" id="4_vwjvj"]
[ext_resource type="Script" path="res://core/run/events/outcomes/revisit_later.gd" id="5_jfcj4"]
[ext_resource type="Script" path="res://core/run/events/outcomes/commission_act.gd" id="6_7e6gq"]
[ext_resource type="Script" path="res://core/run/events/outcomes/next_event.gd" id="7_w51j2"]
[ext_resource type="Script" path="res://core/run/events/conditions/commission_ready.gd" id="8_x228w"]
[ext_resource type="Script" path="res://core/run/events/event_def.gd" id="9_mwd8w"]

[sub_resource type="Resource" id="Resource_tvd86"]
script = ExtResource("3_d6uot")

[sub_resource type="Resource" id="Resource_axfa7"]
script = ExtResource("1_3heij")
label = "撤离"
labels = {
"en": "Extract"
}
outcomes = Array[ExtResource("2_7rcik")]([SubResource("Resource_tvd86")])

[sub_resource type="Resource" id="Resource_4tn1y"]
script = ExtResource("5_jfcj4")

[sub_resource type="Resource" id="Resource_ochjq"]
script = ExtResource("1_3heij")
label = "再看看"
labels = {
"en": "Not yet"
}
outcomes = Array[ExtResource("2_7rcik")]([SubResource("Resource_4tn1y")])

[sub_resource type="Resource" id="Resource_71wbr"]
script = ExtResource("6_7e6gq")

[sub_resource type="Resource" id="Resource_rev5h"]
script = ExtResource("7_w51j2")
event = &"extract_default"

[sub_resource type="Resource" id="Resource_mxv4i"]
script = ExtResource("8_x228w")

[sub_resource type="Resource" id="Resource_2rap2"]
script = ExtResource("1_3heij")
label = "查验这处出口"
labels = {
"en": "Inspect this exit"
}
hide_when_locked = true
requires = Array[ExtResource("4_vwjvj")]([SubResource("Resource_mxv4i")])
outcomes = Array[ExtResource("2_7rcik")]([SubResource("Resource_71wbr"), SubResource("Resource_rev5h")])

[sub_resource type="Resource" id="Resource_g7y8s"]
script = ExtResource("6_7e6gq")
action = &"deliver"

[sub_resource type="Resource" id="Resource_tbtib"]
script = ExtResource("7_w51j2")
event = &"extract_default"

[sub_resource type="Resource" id="Resource_a7itg"]
script = ExtResource("8_x228w")
action = &"deliver"

[sub_resource type="Resource" id="Resource_k2dij"]
script = ExtResource("1_3heij")
label = "把信交给接应员"
labels = {
"en": "Hand the letter to the contact"
}
hide_when_locked = true
requires = Array[ExtResource("4_vwjvj")]([SubResource("Resource_a7itg")])
outcomes = Array[ExtResource("2_7rcik")]([SubResource("Resource_g7y8s"), SubResource("Resource_tbtib")])

[resource]
script = ExtResource("9_mwd8w")
id = &"extract_default"
title = "撤离点"
titles = {
"en": "Extraction Point"
}
text = "能出去的地方。{c:warn}撤了这一局就结束{/c}：棋盘上的东西带回{zone:仓库}、包回包架，{zone:地上}的留在这儿，钱带出去。

费用：{extract_fee} 币（零即免费）。"
texts = {
"en": "A way out. {c:warn}Extract and this run ends{/c}: what's on your board goes back to the {zone:仓库} and your bags to the Bag Rack, what's on the {zone:地上} stays here, and your coins come with you.

Fee: {extract_fee} coins (zero means free)."
}
options = Array[ExtResource("1_3heij")]([SubResource("Resource_axfa7"), SubResource("Resource_ochjq"), SubResource("Resource_2rap2"), SubResource("Resource_k2dij")])
