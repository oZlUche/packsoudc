[resource]
script = ExtResource("5_3heij")
id = &"extract_default"
title = "撤离点"
titles = {
"en": "Extraction Point"
}
text = "能出去的地方。{c:warn}撤了这一局就结束{/c}：棋盘上的东西带回{zone:仓库}、包回包架，{zone:地上}的留在这儿，钱带出去。

费用：{extract_fee} 币（零即免费）。"
texts = {
"en": "A way out. {c:warn}Extract and this run ends{/c}: what's on your board goes back to the {zone:仓库} and your bags to the Bag Rack, what's on the {zone:地上} stays here, and your coins come with you.

Fee: {extract_fee} coins (zero means free)."
}
options = Array[ExtResource("1_wwjr2")]([SubResource("Resource_d6uot"), SubResource("Resource_vwjvj")])
