[resource]
script = ExtResource("12_rev5h")
id = &"extract_default"
title = "撤离点"
titles = {
"en": "Extraction Point"
}
text = "能出去的地方。{c:warn}撤了这一局就结束{/c}：棋盘上的东西带回{zone:仓库}、包回包架，{zone:地上}的留在这儿，钱带出去。{extract_fee_line}"
texts = {
"en": "A way out. {c:warn}Extract and this run ends{/c}: what's on your board goes back to the {zone:仓库} and your bags to the Bag Rack, what's on the {zone:地上} stays here, and your coins come with you.{extract_fee_line}"
}
options = Array[ExtResource("1_vwjvj")]([SubResource("Resource_g7y8s"), SubResource("Resource_a7itg"), SubResource("Resource_8uxa1"), SubResource("Resource_7ughn"), SubResource("Resource_xla8e")])
