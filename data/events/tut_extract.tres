[resource]
script = ExtResource("5_4g5m7")
id = &"tut_extract"
title = "撤离"
titles = {
"en": "Extract"
}
text = "到撤离点了。撤了这一局就结束：包里的东西带回{zone:仓库}，{zone:地上}的留在这儿。死在里面的话，带着的东西就都没了。

序章到此为止，撤出去直接进下一张：路会分岔。"
texts = {
"en": "You've reached the extraction point. Extract and this run ends: what's in your bag goes back to the {zone:仓库}, and what's on the {zone:地上} stays here. Die in a run and everything you carried is gone.

That's the end of the Prologue. Extract and you go straight to the next map: the road forks."
}
options = Array[ExtResource("1_0aq40")]([SubResource("Resource_frcm2"), SubResource("Resource_2d0ii")])
