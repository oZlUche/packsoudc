[ext_resource type="Script" path="res://core/run/events/event_outcome.gd" id="2_a2eua"]
[ext_resource type="Script" path="res://core/run/events/outcomes/proceed.gd" id="3_b2fyj"]
[ext_resource type="Script" path="res://core/run/events/event_condition.gd" id="4_80eby"]
[ext_resource type="Script" path="res://core/run/events/conditions/faith_active.gd" id="5_xd17f"]
[ext_resource type="Script" path="res://core/run/events/outcomes/revisit_later.gd" id="6_dxigf"]
