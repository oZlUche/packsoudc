[resource]
script = ExtResource("5_6rvsp")
id = &"tut_search_2_again_2"
title = "包装不下了"
text = "纱布和口粮翻出来了，可包已经快满了 —— 放不进包里的东西只能留在暂存区，走的时候会丢在这里。

取舍一下：把最有用的放进包里，用不上的就别带了。再翻一次一定会惊动什么，惊动了就打，打赢了对方身上的东西归你。"
options = Array[ExtResource("1_yxexq")]([SubResource("Resource_acvxe")])
