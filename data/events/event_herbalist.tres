[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://core/run/events/event_option.gd" id="1_pmprw"]
[ext_resource type="Script" path="res://core/run/events/event_outcome.gd" id="2_57g6w"]
[ext_resource type="Script" path="res://core/run/events/outcomes/change_money.gd" id="3_jqgkn"]
[ext_resource type="Script" path="res://core/run/events/outcomes/give_pool_item.gd" id="4_83rmk"]
[ext_resource type="Script" path="res://core/run/events/outcomes/say.gd" id="5_0n5ml"]
[ext_resource type="Script" path="res://core/run/events/event_condition.gd" id="6_wfdit"]
[ext_resource type="Script" path="res://core/run/events/conditions/can_afford.gd" id="7_w6fwf"]
[ext_resource type="Script" path="res://core/run/events/outcomes/lose_item.gd" id="8_rxfno"]
[ext_resource type="Script" path="res://core/run/events/conditions/has_item.gd" id="9_3fo48"]
[ext_resource type="Script" path="res://core/run/events/event_def.gd" id="10_lsy4c"]

[sub_resource type="Resource" id="Resource_27dve"]
script = ExtResource("3_jqgkn")
reward_key = &"med"

[sub_resource type="Resource" id="Resource_4tyt0"]
script = ExtResource("4_83rmk")
pool = &"medicine"
key = &"med"

[sub_resource type="Resource" id="Resource_qrol8"]
script = ExtResource("5_0n5ml")
text = "他收好钱，将封好的{reward_name}放到你面前。"
texts = {
"en": "He pockets the coins and sets the sealed {reward_name} in front of you."
}

[sub_resource type="Resource" id="Resource_d781a"]
script = ExtResource("7_w6fwf")
reward_key = &"med"

[sub_resource type="Resource" id="Resource_vwu1g"]
script = ExtResource("1_pmprw")
label = "购买{reward_name}（{reward_price}）"
labels = {
"en": "Buy the {reward_name} ({reward_price})"
}
requires = Array[ExtResource("6_wfdit")]([SubResource("Resource_d781a")])
outcomes = Array[ExtResource("2_57g6w")]([SubResource("Resource_27dve"), SubResource("Resource_4tyt0"), SubResource("Resource_qrol8")])

[sub_resource type="Resource" id="Resource_0evtx"]
script = ExtResource("8_rxfno")
item = &"dried_herbs"
count = 2

[sub_resource type="Resource" id="Resource_scdrn"]
script = ExtResource("4_83rmk")
pool = &"medicine"
key = &"med"

[sub_resource type="Resource" id="Resource_gs1h5"]
script = ExtResource("5_0n5ml")
text = "药贩闻了闻草束，把{reward_name}推了过来。"
texts = {
"en": "The seller sniffs the bundle and pushes the {reward_name} across."
}

[sub_resource type="Resource" id="Resource_do6hl"]
script = ExtResource("9_3fo48")
item = &"dried_herbs"
count = 2
takeable = true

[sub_resource type="Resource" id="Resource_qvf47"]
script = ExtResource("1_pmprw")
label = "用{item:dried_herbs} ×{has_item_count}换{reward_name}"
labels = {
"en": "Trade {has_item_count} {item:dried_herbs} for the {reward_name}"
}
requires = Array[ExtResource("6_wfdit")]([SubResource("Resource_do6hl")])
outcomes = Array[ExtResource("2_57g6w")]([SubResource("Resource_0evtx"), SubResource("Resource_scdrn"), SubResource("Resource_gs1h5")])

[sub_resource type="Resource" id="Resource_ouo0n"]
script = ExtResource("1_pmprw")
label = "不买"
labels = {
"en": "Don't buy anything"
}

[resource]
script = ExtResource("10_lsy4c")
id = &"event_herbalist"
title = "墙根的药摊"
titles = {
"en": "The Wall-side Remedy Stall"
}
text = "一名药贩把封好的药品摆在墙影里，摊布上压着半截帝国路税木牌。“想便宜些，就拿干草药来换。”他指向其中一份，包装仍然完整。"
texts = {
"en": "A remedy seller has laid out sealed medicines in the shade of the wall, half an Imperial road-toll tag weighing down the cloth. \"Want it cheaper? Trade me dried herbs.\" He points at one parcel, its wrapping still intact."
}
options = Array[ExtResource("1_pmprw")]([SubResource("Resource_vwu1g"), SubResource("Resource_qvf47"), SubResource("Resource_ouo0n")])
