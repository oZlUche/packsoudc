[resource]
script = ExtResource("4_3sc5w")
id = &"briefing_legion_skipped"
title = "军团的交代"
titles = {
"en": "The Legion's Briefing"
}
text = "「听说你在别处走过几趟。下一趟没有图，废墟每次都不一样。别久留：每走一步，日晷就走一格，走完了没人来接你；走到一半，离你进去那个口最近的免费出口会被封死，地图上提前标着。」

「越往里越值钱，也越要命。最里头坐着这片废墟的主人，放倒它就直接带着东西出来结算；不想碰，就从外面几环的出口走。」

「路上有做买卖的、能歇脚的，鼠标停在点上就看得见。免费出口有我们的人接应，拿不动的先托付给他们，就算你死在里头也会送回来。」

{c:dim}看不懂的词，Esc 菜单里的{ui:百科}都有一页。{/c}"
texts = {
"en": "\"Word is you've made a few trips elsewhere. The next one has no map. The ruins change every time. Don't linger: every step you take moves the sundial one notch, and when it runs out, nobody comes for you. Halfway through, the free exit nearest to where you went in gets sealed. It's marked on the map ahead of time.\"

\"The deeper you go, the more it's worth, and the more likely it kills you. At the very center sits the master of these ruins. Put it down and you walk straight out with your loot to Results. If you'd rather not, leave by an exit in the outer rings.\"

\"Along the way there are traders and places to rest. Hover over a spot to see what it is. Our people wait at the free exits: hand them what you can't carry and it gets sent back, even if you die in there.\"

{c:dim}Any word you don't know has a page in the {ui:百科}, under the Esc menu.{/c}"
}
image = "res://assets/chest/bg/cursed_depths.png"
options = Array[ExtResource("1_x8mh6")]([SubResource("Resource_rewgh")])
