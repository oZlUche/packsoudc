[resource]
script = ExtResource("8_yj42u")
id = &"tut3_rest_2"
title = "第二座神坛"
text = "到第二阶了，神坛上多了两个特殊操作：

「祈求赐福」花 {faith_perk:brute:altar_bless:cost} 信力，把一件东西换成{faith:brute}赐福的版本；「献祭生命上限」每次扣 {faith_perk:brute:altar_sacrifice_hp:hp_cost} 点生命上限，换耐力上限和急速。

{b}只能选一个{/b}：选了，这座神坛就关了，献祭也不能再做 —— 这就是二选一。"
options = Array[ExtResource("1_dnsk8")]([SubResource("Resource_ca2i3"), SubResource("Resource_5yw3j"), SubResource("Resource_ejklv")])
