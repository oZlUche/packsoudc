[sub_resource type="Resource" id="Resource_ium5k"]
script = ExtResource("3_mbrks")
item = &"charm_brute"

[sub_resource type="Resource" id="Resource_1iy0e"]
script = ExtResource("4_76k2b")
text = "蛮神的护符在掌心发烫。先把它放进包里。"
texts = {
"en": "The Brute's charm burns in your palm. Put it in a bag first."
}

[sub_resource type="Resource" id="Resource_8h5w3"]
script = ExtResource("1_norlb")
