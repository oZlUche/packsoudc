[resource]
script = ExtResource("6_xubpb")
id = &"tut3_faith_call"
title = "蛮神的低语"
text = "祭坛上摆着一堆碎骨，血迹还没干透。你听见有人在耳边低吼：{b}杀，再杀。{/b}一枚骨制的护符从骨堆里滚到你脚边。

这是一枚{b}信物{/b}：{item:charm_brute}，只占一格。{b}把它放进包里{/b}就算信了{faith:brute}（走之前就放：{zone:暂存区}里的东西会留在这个点上）；信了之后，地图左上会多一行「信力」，打仗、受伤、献祭都会让它涨，涨够了就升阶，阶越高神给的越多。"
options = Array[ExtResource("1_norlb")]([SubResource("Resource_8h5w3")])
