[resource]
script = ExtResource("4_tndf0")
id = &"tut2_search_1_done"
title = "板甲"
text = "又翻出一件{b}板甲{/b}：开战时给一大截一次性护盾，先替你挨，挨完就没了。几下重击它接得住；绵绵不断的小刀会把它磨光，然后就是你自己挨。

前面分岔：{c:warn}把鼠标停在两个战斗点上看看对手{/c}，再决定带盾还是带甲、走哪一边。装不下的那件留在暂存区，走了就没了。"
options = Array[ExtResource("1_dyv0g")]([SubResource("Resource_laii8")])
