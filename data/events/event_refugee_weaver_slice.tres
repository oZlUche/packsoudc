[sub_resource type="Resource" id="Resource_d3855"]
script = ExtResource("3_810nn")
item = &"linen_bolt"

[sub_resource type="Resource" id="Resource_taixr"]
script = ExtResource("4_bn346")

[sub_resource type="Resource" id="Resource_lud6f"]
script = ExtResource("5_3ikgf")
text = "她展开布边，看过没有霉斑的部分，把钱放进你手中。"
texts = {
"en": "She unrolls the edge, checks the part free of mildew and puts the coins in your hand."
}

[sub_resource type="Resource" id="Resource_68jii"]
script = ExtResource("7_jo8nt")
item = &"linen_bolt"
takeable = true

[sub_resource type="Resource" id="Resource_mywf3"]
script = ExtResource("1_3jit4")
label = "交出{item:linen_bolt} ×{lose_item_count}（+{change_money_amount}）"
labels = {
"en": "Hand over {item:linen_bolt} ×{lose_item_count} (+{change_money_amount})"
}
requires = Array[ExtResource("6_l3rpd")]([SubResource("Resource_68jii")])
outcomes = Array[ExtResource("2_r333n")]([SubResource("Resource_d3855"), SubResource("Resource_taixr"), SubResource("Resource_lud6f")])

[sub_resource type="Resource" id="Resource_voj7v"]
script = ExtResource("5_3ikgf")
text = "你收好材料，她低头继续缝补那条旧腰带。"
texts = {
"en": "You put your materials away, and she bends back over the old belt."
}

[sub_resource type="Resource" id="Resource_kw2tt"]
script = ExtResource("1_3jit4")
label = "保留材料"
labels = {
"en": "Keep your materials"
}
outcomes = Array[ExtResource("2_r333n")]([SubResource("Resource_voj7v")])

[resource]
script = ExtResource("8_yu0oe")
id = &"event_refugee_weaver_slice"
title = "补衣人的针"
titles = {
"en": "The Mender's Needle"
}
text = "避风处挂着几件补过许多次的外衣。补衣人指了指断开的腰带：“皮子或者布都行。我不缺针，缺的是能缝上去的东西。”她打开钱袋，让你看见里面确实还有零钱。"
texts = {
"en": "A few coats, patched many times over, hang in the lee of the wind. The mender points at a broken belt. \"Leather or cloth, either will do. I've needles enough; what I lack is something to sew on.\" She opens her purse to show you there really are coins in it."
}
options = Array[ExtResource("1_3jit4")]([SubResource("Resource_mywf3"), SubResource("Resource_kw2tt")])
