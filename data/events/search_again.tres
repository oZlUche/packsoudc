[resource]
script = ExtResource("6_ucwwp")
id = &"search_again"
title = "翻过一遍"
titles = {
"en": "Searched Once"
}
text = "翻出来的东西已经拿了。还可以再翻一遍，但翻得越久，越可能惊动附近的人。"
texts = {
"en": "You've taken what turned up. You can search again, but the longer you dig, the likelier you are to wake someone nearby."
}
options = Array[ExtResource("1_scupj")]([SubResource("Resource_lpdtw"), SubResource("Resource_byoaf")])
