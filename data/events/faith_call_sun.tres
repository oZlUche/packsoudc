[sub_resource type="Resource" id="Resource_6ktk3"]
script = ExtResource("4_oe13u")
text = "日神的护符温热不退。"
texts = {
"en": "The Sun God's charm stays warm."
}

[sub_resource type="Resource" id="Resource_5jkrl"]
script = ExtResource("1_14pxn")
label = "拿起铜牌"
labels = {
"en": "Pick up the copper token"
}
tags = Array[StringName]([&"offering"])
