[resource]
script = ExtResource("6_0jwkf")
id = &"faith_call_earth"
title = "大地之神的匣"
text = "祭坛是一整块没有接缝的石头。石面上凹进去一个拳头大的洞，里面是一只空心的石匣 —— 能装一件小东西。"
options = Array[ExtResource("1_m8ys8")]([SubResource("Resource_5e8x2"), SubResource("Resource_djldp")])
