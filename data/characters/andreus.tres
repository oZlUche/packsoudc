[sub_resource type="Resource" id="Resource_8iq08"]
script = ExtResource("7_yo25q")
id = &"familiar_paths"
display_name = "熟门熟路"
display_names = {
"en": "Old Paths"
}
description = "每走 {travel_discount_every} 步，下一步不计入倒计时。"
descriptions = {
"en": "Every {travel_discount_every} steps, the next step doesn't count toward the Countdown."
}
