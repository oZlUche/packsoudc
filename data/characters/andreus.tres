[sub_resource type="Resource" id="Resource_yjads"]
script = ExtResource("6_u22wk")
id = &"ambush"
display_name = "偷袭"
display_names = {
"en": "Ambush"
}
description = "开战时敌人先失去三成生命。能用 {uses} 次，每到休息点补 {rest_recharge} 次。"
descriptions = {
"en": "The enemy starts three tenths down on Health. {uses} uses, +{rest_recharge} per rest spot."
}
uses = 3
rest_recharge = 1
show_prebattle = true

