[resource]
script = ExtResource("2_ujyeu")
id = &"andreus"
display_name = "安德烈乌斯"
display_names = {
"en": "Andreus"
}
description = "擅长避战的奴隶探索者。先手偷袭，输了就用钱买命。生命 {max_hp}、体力 {vitality_max} 都是最低的。"
descriptions = {
"en": "A slave explorer who avoids fights. He strikes first from hiding and buys his life back when he loses. Lowest Health {max_hp} and Vitality {vitality_max}."
}
base_stats = {
"max_hp": 45,
"max_stamina": 55,
"regen_stamina": 4
}
vitality_max = 3
board_size = Vector2i(7, 6)
starting_bags = Array[StringName]([&"bag_leather", &"bag_leather"])
weight_capacity = 48
skills = Array[ExtResource("3_pn8uy")]([SubResource("Resource_yjads"), SubResource("Resource_lxxwv")])
