[sub_resource type="Resource" id="Resource_ecief"]
script = ExtResource("10_im2m6")
id = &"slip"
display_name = "脱身"
description = "开战前溜走：这一场不打、不扣体力、也没有战利品，点算用过（核心点溜不掉）；猎手面前用，必定逃掉。"
uses = 2
cooldown_steps = 4

[resource]
script = ExtResource("1_pn8uy")
id = &"andreus"
display_name = "安德烈乌斯"
display_names = {
"en": "Andreus"
}
description = "擅长逃跑的奴隶探索者。生命最低（{max_hp}）、背得最少，但走得远、溜得掉。"
base_stats = {
"max_hp": 50
}
starting_bags = Array[StringName]([&"bag_leather", &"bag_leather"])
