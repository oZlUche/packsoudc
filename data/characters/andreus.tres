[sub_resource type="Resource" id="Resource_53naf"]
script = ExtResource("6_yjads")
id = &"ambush"
display_name = "偷袭"
display_names = {
"en": "Ambush"
}
description = "开战时敌人先失去三成生命。能用 {uses} 次，每到休息点补 {rest_recharge} 次。"
descriptions = {
"en": "The enemy starts three tenths down on Health. {uses} uses, +{rest_recharge} per rest spot."
}
uses = 2
rest_recharge = 1
show_prebattle = true

[sub_resource type="Resource" id="Resource_8iq08"]
script = ExtResource("7_yo25q")

[sub_resource type="Resource" id="Resource_x06lg"]
script = ExtResource("8_lxxwv")
id = &"ransom"
display_name = "求饶"
display_names = {
"en": "Beg for Mercy"
}
description = "打输了可以用金币和道具抵掉体力损失。核心点与搜索遭遇不能。"
descriptions = {
"en": "Lost a fight? Pay coins and items instead of Vitality (not at the core or in searches)."
}
passive = Array[ExtResource("4_lwem7")]([SubResource("Resource_8iq08")])

