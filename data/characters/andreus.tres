[sub_resource type="Resource" id="Resource_kfy4k"]
script = ExtResource("7_yo25q")
id = &"slippery"
display_name = "溜得掉"
display_names = {
"en": "Slippery"
}
description = "猎手更难发现你，从猎手面前逃跑更容易；首次战败于敌人时不扣体力。"
descriptions = {
"en": "Hunters have a harder time spotting you and fleeing from them is easier; the first time you lose to an enemy, you lose no Vitality."
}
passive = Array[ExtResource("4_lwem7")]([SubResource("Resource_x06lg"), SubResource("Resource_c4ici"), SubResource("Resource_ecief")])

[sub_resource type="Resource" id="Resource_iqqh8"]
script = ExtResource("11_nsl5r")
id = &"slip"
display_name = "脱身"
display_names = {
"en": "Slip"
}
description = "开战前脱离：不战斗、不扣体力、无战利品，该点视为已用（核心点不可用）；对猎手使用必定逃脱。"
descriptions = {
"en": "Slip away before a battle: no fight, no Vitality lost, no loot, and the spot counts as used (not at the core). Always escapes when used on a hunter."
}
uses = 2
cooldown_steps = 4

[resource]
script = ExtResource("2_37qd7")
id = &"andreus"
display_name = "安德烈乌斯"
display_names = {
"en": "Andreus"
}
description = "擅长逃跑的奴隶探索者。生命最低（{max_hp}）、棋盘最窄、背得最少，但带的钱多、走得远、溜得掉。"
descriptions = {
"en": "A slave explorer who is good at running. Lowest Health ({max_hp}), the narrowest board and the least he can carry, but he brings more money, travels far and slips away."
}
base_stats = {
"max_hp": 45,
"max_stamina": 55,
"regen_stamina": 4
}
board_size = Vector2i(7, 6)
starting_funds = 120
starting_bags = Array[StringName]([&"bag_leather", &"bag_leather"])
weight_capacity = 40
skills = Array[ExtResource("3_u22wk")]([SubResource("Resource_8iq08"), SubResource("Resource_kfy4k"), SubResource("Resource_iqqh8")])
