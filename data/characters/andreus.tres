[resource]
script = ExtResource("2_37qd7")
id = &"andreus"
display_name = "安德烈乌斯"
display_names = {
"en": "Andreus"
}
description = "擅长避战的奴隶探索者。棋盘最大、背得最多、带的钱也最多：先手偷袭、输了就用钱买命。生命 {max_hp}、体力 {vitality_max} 都是最低的。"
descriptions = {
"en": "A slave explorer who avoids fights. Biggest board, load and purse: he ambushes first and buys his life back. Lowest Health {max_hp} and Vitality {vitality_max}."
}
base_stats = {
"max_hp": 45,
"max_stamina": 45,
"regen_stamina": 4
}
vitality_max = 3
board_size = Vector2i(9, 6)
starting_funds = 120
starting_bags = Array[StringName]([&"bag_leather", &"bag_leather"])
weight_capacity = 64
skills = Array[ExtResource("3_u22wk")]([SubResource("Resource_53naf"), SubResource("Resource_x06lg"), SubResource("Resource_ecief"), SubResource("Resource_ev8go")])
