[sub_resource type="Resource" id="Resource_lxxwv"]
script = ExtResource("8_2ooe2")
id = &"ransom"
display_name = "求饶"
display_names = {
"en": "Beg for Mercy"
}
description = "打输了或逃跑失败，可以用金币和道具抵掉体力损失。核心点不能。"
descriptions = {
"en": "Lost a fight or failed to flee? Pay coins and items instead of Vitality (not at the core)."
}
