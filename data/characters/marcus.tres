[resource]
script = ExtResource("1_khapf")
id = &"marcus"
display_name = "马库斯"
display_names = {
"en": "Marcus"
}
description = "擅长战斗的军团士兵。一个皮革包、一个小包，生命 {max_hp}、耐力 {max_stamina}、耐力回得最快：打得狠、打得久、打赢了得的多。"
descriptions = {
"en": "A legion soldier who is good at fighting. One leather bag and one small bag, Health {max_hp}, Stamina {max_stamina} and the fastest Stamina regeneration: hits hard, lasts long and earns more from wins."
}
base_stats = {
"max_hp": 55,
"max_stamina": 65,
"regen_stamina": 5
}
starting_funds = 100
starting_bags = Array[StringName]([&"bag_leather", &"bag_small"])
weight_capacity = 48
skills = Array[ExtResource("2_iqgrf")]([SubResource("Resource_f2n3j"), SubResource("Resource_i0bx0"), SubResource("Resource_hplct")])
