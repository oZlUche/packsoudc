[resource]
script = ExtResource("2_iy1av")
id = &"marcus"
display_name = "马库斯"
display_names = {
"en": "Marcus"
}
description = "擅长战斗的军团士兵。胸前的军功牌记着每一场胜仗，牌边的武器越打越狠；耐力 {max_stamina}、耐力回复最快。"
descriptions = {
"en": "A legion soldier who is good at fighting. The phalera on his chest counts every win, and the weapons beside it hit harder and harder. Stamina {max_stamina} and the fastest Stamina Regen."
}
base_stats = {
"max_hp": 55,
"max_stamina": 65,
"regen_stamina": 5
}
