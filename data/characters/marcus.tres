[resource]
script = ExtResource("2_khapf")
id = &"marcus"
display_name = "马库斯"
display_names = {
"en": "Marcus"
}
description = "擅长战斗的军团士兵。随身一块军功牌：打赢一场记一笔，牌越亮、牌边的武器越狠。生命 {max_hp}、耐力 {max_stamina}、耐力回得最快。"
descriptions = {
"en": "A legion soldier who is good at fighting. He carries a phalera: every win earns Honor, and the brighter it gets, the harder the weapons around it hit. Health {max_hp}, Stamina {max_stamina} and the fastest Stamina regeneration."
}
base_stats = {
"max_hp": 55,
"max_stamina": 65,
"regen_stamina": 5
}
starting_funds = 100
starting_bags = Array[StringName]([&"bag_leather", &"bag_small"])
weight_capacity = 48
skills = Array[ExtResource("3_iqgrf")]([SubResource("Resource_tkx2e")])
fixed_items = Array[ExtResource("1_1pf8y")]([SubResource("Resource_8hk74")])
