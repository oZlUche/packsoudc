[resource]
script = ExtResource("1_mx3k3")
id = &"brutus"
display_name = "布鲁图斯"
display_names = {
"en": "Brutus"
}
description = "擅长生存的奴隶探索者。生命 {max_hp}、体力 {vitality_max}、棋盘最宽，扛得住、缓得过来；只是耐力回得慢、带的钱少，也没有逃跑和爆发的手段。"
descriptions = {
"en": "A slave explorer who is good at surviving. Health {max_hp}, Vitality {vitality_max} and the widest board: he takes a beating and recovers. But his Stamina regenerates slowly, he brings little money, and he has no way to flee or burst."
}
base_stats = {
"max_hp": 70,
"max_stamina": 55,
"regen_stamina": 3
}
vitality_max = 7
board_size = Vector2i(9, 6)
starting_funds = 80
starting_bags = Array[StringName]([&"bag_leather", &"bag_leather"])
weight_capacity = 56
skills = Array[ExtResource("2_oevla")]([SubResource("Resource_878ss"), SubResource("Resource_y0m8p"), SubResource("Resource_4qbaa")])
