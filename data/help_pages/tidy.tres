[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_mq0l6"]

[resource]
script = ExtResource("1_mq0l6")
id = &"tidy"
display_name = "整理"
category = &"bag"
order = 3
text = "{zone:仓库}的「整理」把格子里的东西重排一遍：占用的聚到左上，空格聚到右下。顺序是先同类再大小：武器，盾与防具，信仰道具，药剂与食物，弹药、工具与试剂，材料、零件与宝石，最后是珍宝与其他；同类里占格多的先放、小件去填缝，同大小稀有度高的在前。

整理永远不丢东西：有一件放不下就整批放回原位，什么都不变。它只认不要求包的自由容器，棋盘上摆的是阵，不归它管；同容器内挪位不算置入，不会改信物的激活顺序。"
related = Array[String](["warehouse", "quick_place"])
