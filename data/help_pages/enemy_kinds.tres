[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_86j5j"]

[resource]
script = ExtResource("1_86j5j")
id = &"enemy_kinds"
display_name = "敌人的三类"
display_names = {
"en": "Three Kinds of Enemies"
}
category = &"combat"
order = 8
text = "敌人分三类。{b}人{/b}和你一样背着包，东西放在包里，打赢了掉他的包和身上的东西。{b}机关{/b}和{b}魔兽{/b}没有包，东西直接摆在棋盘上，也不掉包：机关天生带格挡，不会中毒、流血，打赢了掉零件；魔兽身上摆的是器官，牙、腺、皮之类。

同一件东西在机关和魔兽手里是另一套打法：不看相邻、不吃信仰，只按它那份野性数值出手。掉到你手里就是普通的那一件，相邻和信仰照常算。"
texts = {
"en": "Enemies come in three kinds. {b}Humans{/b} carry Bags just like you and keep their things in them; beat one and it drops its Bag and everything it carries. {b}Clockwork{/b} and {b}Beasts{/b} have no Bags: their items sit directly on the Board, and they drop no Bag. Clockwork enemies have built-in Block and cannot be Poisoned or made to Bleed; beat them and they drop parts. Beasts carry organs on their Board: fangs, glands, hides and the like.

The same item plays differently in the hands of Clockwork and Beasts: it ignores adjacency and Faith and acts only on its own wild stats. Once it drops into your hands, it is the ordinary version of that item, and adjacency and Faith count as usual."
}
related = Array[String](["battle_and_prebattle", "direct_damage_and_block", "elements_and_reactions"])
see_items = Array[StringName]([&"brass_gear", &"beast_fang", &"fire_gland"])
