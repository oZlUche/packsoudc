[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_od24r"]

[resource]
script = ExtResource("1_od24r")
id = &"growth_and_rooting"
display_name = "生长与扎根"
category = &"bag"
order = 10
text = "{faith:nature}的种子和树苗会{b}生长{/b}：整件放在棋盘上的包里时，全局倒计时每走一步（走路和原地等待都算，打仗不算）就长一点，到一阶换个名字、效果变强。长过一阶就{b}扎根{/b}，拖不动了；长到最后一阶{b}连包扎根{/b}，它和它的包都动不了。

还没扎根时拿下棋盘（比如放到{zone:地上}），回来就得从头长；在棋盘上挪来挪去不算。自然之神不是当前信仰时它{b}休眠{/b}：不长也不退，扎下的根还在，加成不算。"
related = Array[String](["god_nature", "countdown_and_closing", "switch_and_dormant"])
see_items = Array[StringName]([&"ironwood_sapling", &"moonherb_seed", &"thorn_seed"])
