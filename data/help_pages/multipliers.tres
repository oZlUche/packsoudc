[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_05ddn"]

[resource]
script = ExtResource("1_05ddn")
id = &"multipliers"
display_name = "乘区"
category = &"combat"
order = 6
text = "每件道具的属性终值这样算：基础值乘上（一加所有乘算之和），再加上所有加算之和。只有一个乘区：不管加成来自包体、邻接、信仰还是 buff，所有乘算先相加，再乘一次；加算在乘完之后相加，不吃任何百分比放大。

所以两份同样的乘算合起来是加成翻倍，而不是彼此连乘；加算前期强，后期随乘算堆叠自然贬值。乘算之和低到负一倍以下时按零算，终值只剩加算部分。单位级的标准轴是公式之外的最后一步，乘在道具级终值之上。中途不取整，只在落到血量或显示时才取整。

---"
related = Array[String](["haste", "buffs_and_stacks", "direct_damage_and_block"])
