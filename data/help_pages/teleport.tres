[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_ah2pa"]

[resource]
script = ExtResource("1_ah2pa")
id = &"teleport"
display_name = "传送点"
category = &"map"
order = 8
text = "传送点是一种特殊的路：两端可以隔得很远，走它不经过途中任何点，花的是这条路自己写着的行动点，通常比走一步多。地图上画成紫色虚线。

传送和走一步是同一套结算：花行动点、侵蚀推进、目的地的事照常发生，离开的点上{zone:暂存区}里的东西照样留在那里。有没有传送点、花几点，由这一章的地图配置定，有的图一条也没有。

---"
related = Array[String](["map_and_steps", "staging_zone"])
