[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_yoh5e"]

[resource]
script = ExtResource("1_yoh5e")
id = &"grant_receive_slots"
display_name = "增益槽与受益槽"
category = &"bag"
order = 5
text = "道具轮廓外的相邻格可能标着格位，邻居占住它就点亮。增益槽是「我给邻居」：站在这些格子上、标签符合的邻居各得一份写着的加成，有的还会挂上一条规则，比如毒箭挨着弓，弓每次出手就多带一层中毒。受益槽是「邻居给我」：每被点亮一格，自己得一份加成。

一件邻居只能点亮一个增益槽和一个受益槽，大件压住三格也只算一个；同类格位各格同质，谁占哪格没有区别。格位随物品一起旋转。通过槽连在一起的两件是连结的，配件能听见那把武器出手。这些加成在开战前算一次，{zone:地上}的东西不算邻居。"
related = Array[String](["bags", "auto_battle", "multipliers", "增益槽", "受益槽"])
see_items = Array[StringName]([&"poison_arrows", &"longbow"])
