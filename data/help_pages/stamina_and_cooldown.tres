[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_md5pl"]

[resource]
script = ExtResource("1_md5pl")
id = &"stamina_and_cooldown"
display_name = "耐力与冷却"
display_names = {
"en": "Stamina and Cooldown"
}
category = &"combat"
order = 4
text = "武器出手要花耐力，耐力按每秒回复速度自动补回，回复按时间线性结算。冷却到点时看当前耐力够不够实际消耗：不够就跳过这一次出手，冷却照常清零重走，等于实打实丢掉一次机会。带几把耗耐力的武器就是这样被耐力管着。

攒次数、每场限次、按概率这些门和耐力一样都在消耗层，不过就跳过、冷却照走。开战时每件道具从头起算一个完整冷却。耐力消耗有一条连乘轴：每层灵巧把当前消耗再省掉一小截，层数之间相乘而不是相加。"
texts = {
"en": "Weapons spend Stamina to attack. Stamina refills automatically at its per-second regen rate, steadily over time. When a cooldown finishes, the game checks whether your current Stamina covers the actual cost: if it doesn't, that attack is skipped and the cooldown resets and runs again as usual, so you genuinely lose a chance to attack. That is how Stamina keeps a build with several Stamina-hungry weapons in check.

Gates such as charge counts, per-battle limits and chance rolls sit in the same cost layer as Stamina: fail one and the attack is skipped while the cooldown keeps running. When a battle starts, every item begins a full cooldown from zero. Stamina cost has a multiplicative axis: each stack of Nimble trims a little more off the current cost, and stacks multiply rather than add."
}
related = Array[String](["haste", "auto_battle", "耐力", "耗耐力", "冷却"])
