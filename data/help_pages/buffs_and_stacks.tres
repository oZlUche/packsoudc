[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_1dldp"]

[resource]
script = ExtResource("1_1dldp")
id = &"buffs_and_stacks"
display_name = "buff 与叠层"
category = &"combat"
order = 3
text = "战斗里一切属性变化都由 buff 承载，包括生命上限。不特别说明时 buff 永续、可叠层：叠上就一直在，直到被清除或战斗结束，效果按层数累加；会过期的是例外，往往是不可叠层的那种。上限涨了当前值同量涨，上限降了当前值截到新上限。

作用于角色本身的通用增减走标准轴：加速与减速、强攻与虚弱、易伤与坚韧、回春与失血等等，正负层直接相抵，buff 栏里按层数画一格。加时叠的那几层记在系统层，净化只动内容层，所以解不掉。buff 自己也能带规则，灼烧每层每秒掉血就是这么来的。所有 buff 战斗结束全部清空。"
related = Array[String](["auto_battle", "direct_damage_and_armor", "叠层", "永续", "中毒", "流血"])
