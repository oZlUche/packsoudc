[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_7xdwe"]

[resource]
script = ExtResource("1_7xdwe")
id = &"map_and_steps"
display_name = "地图与走步"
display_names = {
"en": "Map and Steps"
}
text = "地图是一张点和路组成的图。每次只能走到相邻的一个点，路是双向的，走回头路没有限制；走一条路计它写着的步数，通常是一步。走过的点可以再经过、再停留，但那里的事不会再发生第二次。

地图屏按 {key:B} 开背包，鼠标停在点上能看浮窗。踩上一个没用过的点，它的事立刻发生：战斗先进战前准备，搜索与商店开会话，事件给选项。有倒计时的图按走过的步数扣倒计时，猎手与侵蚀也按步推进。"
texts = {
"en": "The map is a graph of nodes and paths. You move to one adjacent node at a time; paths go both ways, and you can backtrack freely. Each path costs the number of steps written on it, usually one. You can pass through or stop at a visited node again, but what happened there won't happen a second time.

On the map screen, press {key:B} to open your Pack, and hover over a node to see its tooltip. Step onto an unused node and its event happens at once: battles go to Pre-battle first, search spots and shops open a session, and events offer choices. On maps with a Countdown, each step you walk takes from the Countdown, and hunters and Erosion also advance step by step."
}
related = Array[String](["node_types", "countdown_and_closing", "staging_zone", "teleport"])
