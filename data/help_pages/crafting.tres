[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_t8ry6"]

[resource]
script = ExtResource("1_t8ry6")
id = &"crafting"
display_name = "合成"
display_names = {
"en": "Crafting"
}
category = &"bag"
order = 4
text = "两件能合成的道具在棋盘上贴着放，接缝上会浮出一枚小锤。点它先看一眼要用掉哪两件、合出什么（没合成过也没见过的成品是问号），按「合成」才合：两件消失，成品落在两件原来的格子里。放不下自动找位，再不行到{zone:地上}。

锁着的、随身之物不会被合掉。合成只在一局里发生。"
texts = {
"en": "Put two items that combine next to each other on the board and a small hammer appears on the seam. Click it to see which two items will be used and what they make (a result you have never made or seen shows as a question mark), then press Fuse. Both items disappear and the result takes their cells. If it doesn't fit, it finds a spot automatically; failing that, it goes to the {zone:地上}.

Locked and pinned items are never used up. Crafting only happens during a run."
}
see_items = Array[StringName]([&"knife", &"poison_vial", &"poisoned_knife", &"salted_meat", &"bandage_roll"])
