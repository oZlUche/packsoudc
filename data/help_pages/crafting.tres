[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_t8ry6"]

[resource]
script = ExtResource("1_t8ry6")
id = &"crafting"
display_name = "合成"
display_names = {
"en": "Crafting"
}
category = &"bag"
order = 4
text = "拿起一件道具，能和它合成的道具身上会标一枚小锤。拖到其中一件上松手，先看一眼要用掉哪两件、合出什么（没合成过也没见过的成品是问号），按「合成」才合：两件消失，成品落在被压的那件的位置，放不下自动找位。取消就放回原处。棋盘和{zone:地上}的都能合。

锁着的、随身之物不会被合掉。合成只在一局里发生。"
texts = {
"en": "Pick up an item and every item it can combine with is marked with a small hammer. Drop it on one of them to see which two items will be used and what they make (a result you have never made or seen shows as a question mark), then press Fuse. Both items disappear and the result lands where the item underneath was; if it doesn't fit, it finds a spot automatically. Cancel puts it back. Items on the board and on the {zone:地上} both count.

Locked and pinned items are never used up. Crafting only happens during a run."
}
see_items = Array[StringName]([&"knife", &"poison_vial", &"poisoned_knife", &"salted_meat", &"bandage_roll"])
