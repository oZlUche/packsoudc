[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_a8uya"]

[resource]
script = ExtResource("1_a8uya")
id = &"achievements"
display_name = "成就"
category = &"meta"
order = 3
text = "成就是局外的里程碑，看的是跨局累计的数：撤离几次、战败几次、单局背出的价值、图鉴点亮多少、击败核心、拿到某件特殊道具等等。一局结算之后和读档之后各查一次，新完成的在地图日志里报一句。

有的成就给解锁：开出新的道具、地图或难度，比如背出足够的价值解锁进阶难度。成就页写着途径与进度，能按全部、已解锁、未解锁切；隐藏成就完成前只显示问号。「全部解锁」开着时成就不计。"
related = Array[String](["codex", "save_slots"])
