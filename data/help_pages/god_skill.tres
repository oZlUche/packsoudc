[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_12xdj"]

[resource]
script = ExtResource("1_12xdj")
id = &"god_skill"
display_name = "技巧之神"
display_names = {
"en": "God of Skill"
}
category = &"faith"
order = 9
text = "{faith:skill}管尺度、变形与结构，锻造、战斗技巧和各种手艺都归祂，矮人、盗贼与工匠信祂。奉祂时，一场里叠起连击，经验值再多给；每局头一回得到一种工艺道具也给。献祭爱武器、防具、工艺品，带暴击属性的道具倍率最高。

奉了祂就有【连击】：武器每攻击一次叠一层，额外攻击也算，每层急速提高 {faith_perk:skill:skill_momentum:haste_per}%，不设上限；有一次攻击因为耐力不够没打出来，连击清零。进入对局和 {level:qual} 级各选一张技巧之神的质变牌（寻隙、架势、残心、破势、以攻待守、锋芒、一气呵成、大巧若拙……），有的让层数越堆越有用，有的在清零时给回报；升级时还会出技巧之神的基础牌。"
texts = {
"en": "{faith:skill} governs measure, transformation and structure. Forging, combat technique and every craft belong to this god, worshipped by dwarves, thieves and artisans. While you follow this god, you gain extra XP when you build Combo, and when you obtain a kind of Crafted item for the first time in a run. Offerings favor weapons, armor and crafted goods, and items with Crit stats earn the highest multiplier.

Following this god grants Combo: each weapon attack, extra attacks included, builds one stack, and each stack raises your Haste by {faith_perk:skill:skill_momentum:haste_per}%, with no cap; when an attack fails for lack of Stamina, Combo resets to zero. At the start of a run and at levels {level:qual} you pick one of this god's Transformations (Find the Gap, Stance, Zanshin, Break Momentum, Offense as Defense, Keen Edge, In One Breath, Artless Art and more): some make a high Combo pay off, others reward the reset. Level-ups also offer this god's base cards."
}
related = Array[String](["faith_power_and_tiers", "altar_offering"])
see_items = Array[StringName]([&"charm_skill"])
needs_faith = true
