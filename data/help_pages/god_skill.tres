[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_12xdj"]

[resource]
script = ExtResource("1_12xdj")
id = &"god_skill"
display_name = "技巧之神"
category = &"faith"
order = 9
text = "{faith:skill}管尺度、变形与结构，锻造、战斗技巧和各种手艺都归祂，矮人、盗贼与工匠信祂。信力看的是获得金属道具，按格子数给；还看一场战斗里出手过的不同武器有几种，每场有上限。献祭爱金属、防具、工艺品，带暴击属性的道具倍率最高。

这位神现在只有两道阈值，等级效果还没有加入，升阶暂时没有额外功能；赐福模板也还没有。护符能激活祂、攒信力，别的等作者定。"
related = Array[String](["faith_power_and_tiers", "altar_offering"])
see_items = Array[StringName]([&"charm_skill"])
