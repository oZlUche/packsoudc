[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_kxlwg"]

[resource]
script = ExtResource("1_kxlwg")
id = &"drag_and_rotate"
display_name = "拖放与旋转"
category = &"bag"
text = "左键按住一件道具就拿起来，拖的时候按 {key:R} 顺时针转一格，右键或 {key:Esc} 取消放回原处。落点按物品的左上角算，预览有三种颜色：绿是干净落点，黄是压着别人、放手会把人顶出来，红是地形不许，出界、没被包覆盖、跨了两个包、包不收这类标签都算。

顶出来一件直接拿在手上，多于一件全部进{zone:暂存区}。包不参与顶替：往包上丢东西是放进包里，拖一个包压到另一个包上是替换，旧包连内容物摘下、内容物进暂存区。装着东西的包能整体拖走，但换了朝向之后挂不住的内容物会脱落进暂存区。"
related = Array[String](["bags", "quick_place", "staging_zone", "合成"])
