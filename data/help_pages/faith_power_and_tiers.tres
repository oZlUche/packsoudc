[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_4t7vs"]

[resource]
script = ExtResource("1_4t7vs")
id = &"faith_power_and_tiers"
display_name = "信力与阶"
category = &"faith"
order = 1
text = "信力是按信仰要求的行为攒的点数，只给此刻激活的信仰记。每位神看的事不一样：有的看打出去和挨到的伤害，有的看道具出手、回血、置入或获得某类道具、踩点、赢下战斗。按场计的行为往往有每场上限。信力过了一道阈值就升一阶，阈值一道比一道高。

阶决定两样东西：信仰道具上写的按阶功能，与这位神的等级效果，到了的亮、没到的灰。有些加成不按阶而按信力累计，每攒够一截多一份、有上限。信了之后顶端栏有一枚这位神的徽记，鼠标停上去看信力、阶和增长方式。各神的池子各自记，切换不清零。"
related = Array[String](["anchor_activation", "altar_offering", "信力"])
