[resource]
script = ExtResource("1_4t7vs")
id = &"faith_power_and_tiers"
display_name = "信力与阶"
display_names = {
"en": "Faith Points and Ranks"
}
category = &"faith"
order = 1
text = "信力是按信仰要求的行为攒的点数，只给此刻激活的信仰记。每位神都看赢下战斗，再看这位神的战斗机制在这一场里真的发生了没有；有的还看置入或获得某类道具。输了不给打赢那份，已经做到的照给。按场计的行为有每场上限。信力过了一道阈值就升一阶，阈值一道比一道高。

阶决定两样东西：信仰道具上写的按阶功能，与这位神的等级效果，到了的亮、没到的灰。有些加成不按阶而按信力累计，每攒够一截多一份、有上限。信了之后顶端栏有一枚这位神的徽记，鼠标停上去看信力、阶和增长方式。各神的池子各自记，切换不清零。

祈愿是另一笔，专门拿来花：打完一场战斗、献祭都会进，有上限。神坛的祈求赐福、蛮神的立即击败花的都是祈愿。花祈愿不扣信力，阶不会掉。"
texts = {
"en": "Faith points are earned by doing what your Faith asks, and only the currently active Faith keeps count. Every god counts battles won, plus whether that god's battle mechanic actually happened in the battle; some also count placing or gaining certain kinds of items. A defeat gives no win bonus, but deeds already done still count. Deeds counted per battle have a per-battle cap. When your Faith points pass a threshold, you rise one Rank, and each threshold is higher than the last.

Rank decides two things: the Rank-based effects written on Faith items, and the god's tier effects. Those you have reached light up; the rest stay grey. Some bonuses scale with total Faith points rather than Rank, adding one more share for each chunk you collect, up to a cap. Once you follow a god, their emblem appears in the top bar; hover over it to see your Faith points, Rank and how to earn more. Each god's pool is tracked separately, and switching doesn't reset it.

Prayer is a separate pool, meant for spending: you gain it from finishing battles and from Offerings, up to a cap. Praying for a Blessing at an Altar and the Brute's instant defeat both spend Prayer. Spending Prayer never takes away Faith points, so your Rank never drops."
}
related = Array[String](["anchor_activation", "altar_offering", "信力"])
