[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_lu75r"]

[resource]
script = ExtResource("1_lu75r")
id = &"shop"
display_name = "商店"
category = &"map"
order = 2
text = "商店的货架是一格格栏位，商品是真的道具，看得见尺寸。把商品拖进自己的包就是买，放手时收钱，钱不够弹回架上；双击也是买，自动找位。把自己的东西拖进出售区就是卖，回定价的一部分。价格按道具的价值乘倍数，深处的店货更稀有。

刷新花钱换一批，每刷一次更贵。商店可以回头再逛：走了再回来，货架、刷新次数和卖掉的格子都还记着，刷新价不重置。包与珍宝不上架。局外的加成能让商店便宜一点。"
related = Array[String](["quick_place", "node_types"])
