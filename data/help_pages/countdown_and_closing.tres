[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_m7x6f"]

[resource]
script = ExtResource("1_m7x6f")
id = &"countdown_and_closing"
display_name = "倒计时与撤离点关闭"
category = &"map"
order = 5
text = "有倒计时的图只有这么多行动点：走一步按那条路的代价减，原地耗时也减；归零就是行动失败，当场按战败结算，只有保险箱里的带得出。上限和地图规模正相关，地图屏顶上一直写着剩多少，剩得少时变色提醒。

倒计时过半时，离出生点最近的免费撤离点关闭。从开局起它下面就挂着「剩几步关闭」的牌子，关了画红叉，站在上面也撤不了。从仓库带进来的东西有价值预算，超出的部分按比例换掉倒计时，开局屏上写着。"
related = Array[String](["map_and_steps", "extraction_and_defeat", "safe_box"])
