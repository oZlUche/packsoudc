[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_qdpdk"]

[resource]
script = ExtResource("1_qdpdk")
id = &"safe_box"
display_name = "托付"
display_names = {
"en": "Entrusting"
}
category = &"map"
order = 4
text = "免费撤离点上有接应的人。踩上去按「撤离」，确认框里除了撤离还有【托付】：开一块小格子，放进去的东西交给他们，视为已带出 —— 不管这一局最后撤离还是失败，结算时都回仓库，结算屏单独一格画着它们。拖着放或棋盘上双击进格子，没交出去之前格子里双击回棋盘；包放不进去。

关上格子或走开，新放的就交出去了，拿不回来；空格留着，出口还开着就能回来再托一次，一局共用这一块。付费出口不接托付；免费出口过半关门，托付也跟着关。格子的大小由局外规则定，科技能扩格。"
texts = {
"en": "Free extraction points have people waiting for you. Step on one and press Extract: besides Extract, the confirm box offers Entrust. It opens a small grid, and whatever you put in is handed to them and counts as carried out: whether you extract or fail this run, it goes to the Warehouse at Results, where it gets its own section. Drag items in or double-click them on the Board; until they are handed over, double-click them in the grid to bring them back. Bags don't fit.

Close the grid or walk away and what you just put in is handed over for good; empty cells stay, so while the exit is open you can come back and entrust more. One grid is shared for the whole run. Paid exits don't take entrusted items, and when the free exit closes halfway through, entrusting closes with it. The grid's size is set by out-of-run rules, and tech can add cells."
}
related = Array[String](["extraction_and_defeat", "quick_place", "tech_tree"])
