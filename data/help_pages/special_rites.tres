[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_fy2nc"]

[resource]
script = ExtResource("1_fy2nc")
id = &"special_rites"
display_name = "特殊操作"
category = &"faith"
order = 3
text = "到了阶的神会在神坛上刷出特殊操作按钮，升阶当场多出来。各神都有「祈求赐福」：花一笔信力，把包里能被赐福的最值钱那件换成这位神的赐福版。再往上各神不同：蛮神献祭生命上限换耐力上限与急速，日神祈祷攒局内永久的火焰加成，大地之神锻炼加棋盘行数、或把当前点改造成别的类型。

做了一次特殊操作，这个休息点的神坛就关了，献祭也不能再做；想两样都要就得找下一个休息点。有的操作要先挑一项，比如改造此点要选类型；大地的改造在关掉神坛那一刻才发生。特殊操作改的数跟着这一局走，不进下一局。"
related = Array[String](["altar_offering", "god_brute", "god_sun", "god_earth"])
