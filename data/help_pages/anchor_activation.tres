[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_nm4gf"]

[resource]
script = ExtResource("1_nm4gf")
id = &"anchor_activation"
display_name = "信物与激活"
display_names = {
"en": "Anchors and Activation"
}
category = &"faith"
text = "信仰靠道具维系。带着某位神印记的道具就是信物（赐福版的武器防具除外），每位神至少有一枚一格的护符。拿到信物不会自动改信：把它放进棋盘，再点它说明窗下的「奉为主信仰」，才算信了这位神；任何时刻只奉一位。

奉了之后，这位神的道具按阶解锁功能，别的神的道具休眠。主信物离开棋盘，联系就中断：神赐全部停用，也不涨信力，但不会自动换成别的神；同一位神的信物回到棋盘，联系就恢复。信物多半是从地图上的祭坛事件里拿到的，撤离时会回到仓库，开局屏上也可以选这一局奉谁。"
texts = {
"en": "Faith is held through items. An item that carries a god's mark is an Anchor (Blessed weapons and armor excepted), and every god has at least one one-cell Charm. Picking up an Anchor doesn't change your Faith: put it on the board, then press Make main faith under its tooltip to follow that god. You follow only one god at a time.

Once you do, that god's items unlock their effects by Rank, and other gods' items go dormant. If your main Anchor leaves the board, the connection is lost: the god's gifts stop and you earn no Faith, but you don't switch to another god on your own. Bring an Anchor of the same god back onto the board and the connection returns. Anchors mostly come from Altar events on the map. They return to the Warehouse when you extract, and on the Setup screen you can choose which god to follow for the run."
}
related = Array[String](["anchor_and_right_click", "switch_and_dormant", "faith_power_and_tiers"])
see_items = Array[StringName]([&"charm_brute", &"charm_sun", &"charm_nature", &"charm_earth"])
