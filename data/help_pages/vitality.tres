[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_2ftam"]

[resource]
script = ExtResource("1_2ftam")
id = &"vitality"
display_name = "体力"
order = 5
text = "体力是这一局「还剩几条命」，和战斗里的生命、耐力不是一回事：那两样每场重置，体力跨战斗保留。输一场普通战斗扣体力，精英扣得更多，输给猎手也扣；归零就是战败。核心那一场是例外，输了不论剩多少体力都直接战败。

休息点能回体力，扎营多花行动点多回一些；安德烈乌斯输给节点敌人的头一次免罚，科技「不屈」让每次败仗少扣一点（最少还是扣一点）；侵蚀区里走路、逃跑失败、某些事件也会扣。上限由角色定，章节与局外加成能加。{char}的体力在地图屏上一直看得见。"
related = Array[String](["battle_and_prebattle", "rest_point", "erosion", "hunters"])
