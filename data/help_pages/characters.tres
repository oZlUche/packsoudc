[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_f4th6"]

[resource]
script = ExtResource("1_f4th6")
id = &"characters"
display_name = "三个角色"
order = 7
text = "每个角色的不同只有两样：初始面板（生命、耐力、体力上限、初始包、负重上限）和技能（两个被动、一个主动），外加一条明显的短板。主动技能在地图右栏是一个按钮，次数与冷却写在按钮上；被动一直生效。科技对每个角色都生效，和角色的被动叠加。

安德烈乌斯擅长逃跑。被动「熟门熟路」：认得路，每走几步下一步不花行动点。被动「溜得掉」：猎手更难发现他，逃跑更容易，头一回输给节点敌人不扣体力。主动「脱身」：在战前准备屏上溜走，这一场不打、不扣体力、也没有战利品；猎手面前用必定逃掉；核心点溜不掉。短板是生命和负重都最低。

布鲁图斯擅长生存。被动「野地里长大」：休息多回体力，侵蚀扣体力时少扣。被动「坚韧」：战斗里生命掉到三成以下时得到一层护盾，每场一次。主动「咬牙」：在地图上恢复体力。他的体力上限最高，但没有逃跑和爆发的手段。

马库斯擅长战斗。被动「军功」：打赢的钱更多。被动「操练」：耐力回得更快。主动「突击」：下一场战斗先扣掉对方三成生命。他的耐力最高，但初始格子最少，地图上没有任何便利。"
related = Array[String](["vitality", "battle_and_prebattle", "hunters", "rest_point"])
