[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_f4th6"]

[resource]
script = ExtResource("1_f4th6")
id = &"characters"
display_name = "三个角色"
display_names = {
"en": "The Three Characters"
}
order = 7
text = "每个角色的不同只有两样：初始面板（棋盘大小、生命、耐力、耐力回复、体力上限、初始包、负重上限、开局钱）和技能（两个被动），外加一条明显的短板。被动一直生效。科技对每个角色都生效，和角色的被动叠加；生命、体力、负重、开局钱这几条科技按角色自己的数加百分比，所以底子不同的人差距会越拉越大。

安德烈乌斯擅长逃跑。被动「熟门熟路」：每走几步，下一步不计入倒计时。被动「溜得掉」：猎手更难发现他，逃跑更容易，头一回输给节点敌人不扣体力。他带的钱最多；短板是棋盘最窄，生命和负重都最低。

布鲁图斯擅长生存。被动「野地里长大」：休息多回体力。被动「坚韧」：战斗里生命掉到三成以下时立刻得到一笔护甲，每场一次。他的棋盘最宽，生命和体力上限最高；但耐力回得慢、带的钱少，也没有逃跑和爆发的手段。

马库斯擅长战斗。被动「军功」：打赢的钱更多。被动「操练」：战斗里耐力快见底时立刻回一段，每场一次。他的耐力最高、耐力回得最快，但初始包的格子最少，地图上没有任何便利。"
texts = {
"en": "Characters differ in only two things: their starting stats (board size, Health, Stamina, Stamina regen, max Vitality, starting bags, Load limit and starting coins) and their skills (two passives), plus one clear weakness. Passives are always active. Tech applies to every character and stacks with their passives; the Health, Vitality, Load and starting-coin techs add a percentage of each character's own numbers, so characters with different bases pull further apart over time.

Andreus excels at escaping. Passive \"Old Paths\": every few steps, the next step doesn't count against the Countdown. Passive \"Slippery\": hunters have a harder time spotting him, escaping is easier, and his first loss to a node enemy costs no Vitality. He carries the most coins; his weakness is the narrowest board and the lowest Health and Load.

Brutus excels at survival. Passive \"Raised in the Wild\": resting restores more Vitality. Passive \"Tough\": in battle, when his Health drops below thirty percent, he gains a burst of Armor at once, once per battle. He has the widest board and the highest max Health and Vitality, but his Stamina regenerates slowly, he carries few coins, and he has no way to escape or burst.

Marcus excels at combat. Passive \"Spoils of War\": he earns more coins from victories. Passive \"Drill\": in battle, when his Stamina is nearly empty, he instantly regains a chunk of it, once per battle. He has the highest Stamina and the fastest Stamina regen, but his starting bags have the fewest cells, and he gets no help on the map."
}
related = Array[String](["vitality", "battle_and_prebattle", "hunters", "rest_point"])
