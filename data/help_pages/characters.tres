[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_f4th6"]

[resource]
script = ExtResource("1_f4th6")
id = &"characters"
display_name = "三个角色"
display_names = {
"en": "The Three Characters"
}
order = 7
text = "每个角色的不同只有两样：初始面板（棋盘大小、生命、耐力、耐力回复、体力上限、初始包、负重上限、开局钱）和技能，有的角色还带一件钉在棋盘上的随身之物。技能一直生效。科技对每个角色都生效，和角色的技能叠加；生命、体力、负重、开局钱这几条科技按角色自己的数加百分比，所以底子不同的人差距会越拉越大。

安德烈乌斯擅长避战。他的棋盘最大、负重最高、带的钱最多。「偷袭」：战前准备屏上多一把键，按了直接开打，敌人开战就失去三成生命；次数有限，每到一个休息点补一次。「求饶」：会扣体力的一场打输了，对方开价，把金币和道具放上天平的左盘，够了就成交、这一场不扣体力；核心点与搜索遭遇不能求饶。「熟门熟路」：每走几步，下一步不计入倒计时。「溜得掉」：猎手更难发现他，逃跑更容易。他的生命和体力上限都是最低的。

布鲁图斯擅长生存，犯了错也缓得过来。被动「野地里长大」：休息多回体力。被动「坚韧」：战斗里生命掉到三成以下时立刻得到一笔护甲，每场一次。他的棋盘是最宽的之一，生命和体力上限最高；但耐力回得慢、带的钱少。

马库斯擅长战斗。他随身一块军功牌，钉在棋盘中间：每打赢一场记军功，精英和核心记得更多；攒够了就升一阶，从铜到桂冠。牌边的武器伤害更高、出手更快、耗的耐力更少，阶越高圈越大。被动「操练」：战斗里耐力快见底时立刻回一段，每场一次。他的耐力最高、耐力回得最快。"
texts = {
"en": "Characters differ in only two things: their starting stats (board size, Health, Stamina, Stamina regen, max Vitality, starting bags, Load limit and starting coins) and their skills; some also carry a signature item pinned to the board. Skills are always in effect. Tech applies to every character and stacks with their skills; the Health, Vitality, Load and starting-coin techs add a percentage of each character's own numbers, so characters with different bases pull further apart over time.

Andreus excels at avoiding fights. He has the biggest board, the highest Load and the most coins. \"Ambush\": the pre-battle screen gets an extra key that starts the fight at once, and the enemy begins it three tenths down on Health; uses are limited, and each rest spot restores one. \"Beg for Mercy\": when he loses a fight that costs Vitality, the enemy names a price; put coins and items on the left pan of the scale, and once it is enough the deal is struck and the fight costs no Vitality. It doesn't work at the core or in search encounters. \"Old Paths\": every few steps, the next step doesn't count against the Countdown. \"Slippery\": hunters have a harder time spotting him, and escaping is easier. His Health and max Vitality are the lowest.

Brutus excels at survival; his mistakes don't kill him. Passive \"Raised in the Wild\": resting restores more Vitality. Passive \"Tough\": in battle, when his Health drops below thirty percent, he gains a burst of Armor at once, once per battle. His board is one of the widest and his max Health and Vitality are the highest, but his Stamina regenerates slowly and he carries few coins.

Marcus excels at combat. He carries a phalera pinned to the middle of his board: every won fight earns Honor, more for elites and the core, and enough Honor raises its rank from Bronze to Laurel. The weapons around it hit harder, strike faster and use less Stamina, over a wider ring as the rank rises. Passive \"Drill\": in battle, when his Stamina is nearly empty, he instantly regains a chunk of it, once per battle. He has the highest Stamina and the fastest Stamina regen."
}
related = Array[String](["vitality", "battle_and_prebattle", "hunters", "rest_point"])
