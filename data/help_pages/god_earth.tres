[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_rx8x0"]

[resource]
script = ExtResource("1_rx8x0")
id = &"god_earth"
display_name = "大地之神"
category = &"faith"
order = 8
text = "{faith:earth}管结构、秩序、体积与空间，信徒不多。信力看的是中体积及以上的道具出手，每场有上限；还看踩点，头一回踩上岔路给得多，再踩任何用过的点也给一点。献祭只收大块的东西，换的信力还要乘格子数。大地之神赐福中体积以上的道具，赐福版激活即加耐力上限。

一阶起开战的耐力上限更高；二阶在神坛上锻炼，棋盘每次加一行、不限次；三阶头一回踩上一个点就得到一件对应类型的道具，进{zone:暂存区}：战斗给武器、精英给防具、事件给符号或零件、核心给珍宝；四阶在神坛上把当前点改造成别的类型，不限次。大地的护符本身是一只一格的空心石匣，能装一件小东西。"
related = Array[String](["special_rites", "faith_power_and_tiers", "altar_offering"])
see_items = Array[StringName]([&"charm_earth"])
