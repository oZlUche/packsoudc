[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_aq4yk"]

[resource]
script = ExtResource("1_aq4yk")
id = &"tech_tree"
display_name = "科技"
display_names = {
"en": "Tech"
}
category = &"meta"
order = 1
text = "科技是局外的成长，排成一棵树：底下是根，往上长，前置都至少点了一级才能点上面的。每个节点有一级或几级，每级要钱，高一些的级还要建材；建材是没有战斗属性的材料，从搜索与掉落里来。右边面板写着名称、现在与下一级的效果、费用。

上交即消耗：双击仓库里的一件或拖进上交区，交给选中的节点，可以跨几局分批交，交了不能退；材料齐了、钱也够，「升级」才亮，钱在按下时一次扣。现有的科技给仓库加行、给保险箱扩格，或在每一局开局时带来一条局外加成：生命、体力上限、负重、开局钱、多搜几次、商店便宜、掉落更好、侦察、败仗少扣体力。生命、体力上限、负重和开局钱按角色自己的数加百分比，底子越厚加得越多。"
texts = {
"en": "Tech is your growth between runs, laid out as a tree: the root is at the bottom and it grows upward, and you can only take a node once every node before it has at least one level. Each node has one level or several. Every level costs coins, and the higher levels also need building materials: materials with no combat stats that come from searching and drops. The panel on the right shows the node's name, its current and next-level effects, and the cost.

Handing in uses things up: double-click an item in the Warehouse or drag it into the hand-in area to give it to the selected node. You can hand things in over several runs, and nothing handed in is returned. Once the materials are complete and you have the coins, Upgrade lights up, and the coins are taken all at once when you press it. The current techs add rows to the Warehouse, add cells to the Safe, or give a bonus at the start of every run: Health, max Vitality, Load, starting coins, extra searches, cheaper shops, better drops, Scouting, and less Vitality lost per defeat. Health, max Vitality, Load and starting coins add a percentage of your character's own values, so the higher the base, the more you gain."
}
related = Array[String](["warehouse", "safe_box"])
see_items = Array[StringName]([&"steel_ingot", &"hardwood_plank", &"rivet_box"])
