[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_aq4yk"]

[resource]
script = ExtResource("1_aq4yk")
id = &"tech_tree"
display_name = "科技"
category = &"meta"
order = 1
text = "科技是局外的成长，排成一棵树：底下是根，往上长，前置都至少点了一级才能点上面的。每个节点有一级或几级，每级要钱，高一些的级还要建材；建材是没有战斗属性的材料，从搜索与掉落里来。右边面板写着名称、现在与下一级的效果、费用。

上交即消耗：双击仓库里的一件或拖进上交区，交给选中的节点，可以跨几局分批交，交了不能退；材料齐了、钱也够，「升级」才亮，钱在按下时一次扣。现有的科技给仓库加行、给保险箱扩格，或在每一局开局时带来一条局外加成：生命、体力上限、负重、开局钱、多搜几次、商店便宜、掉落更好、侦察、败仗少扣体力。生命、体力上限、负重和开局钱按角色自己的数加百分比，底子越厚加得越多。"
related = Array[String](["warehouse", "safe_box"])
see_items = Array[StringName]([&"steel_ingot", &"hardwood_plank", &"rivet_box"])
