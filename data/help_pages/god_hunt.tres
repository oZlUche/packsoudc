[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_ytcch"]

[resource]
script = ExtResource("1_ytcch")
id = &"god_hunt"
display_name = "狩猎之神"
display_names = {
"en": "God of the Hunt"
}
category = &"faith"
order = 10
text = "{faith:hunt}管比较、差异与拆解，帝国不祭祀祂，民间猎人信祂。信力看的是打赢战斗，把对手拆到第一档再多给；每局头一回把一种兽材置入背包也给，越稀有给得越多。献祭爱兽材与食物，兽材的倍率最高。

奉了祂就会【拆解】：开战盯上对手最拿手的一项，护甲、恢复、攻击节奏，都没有就让它「暴露」；武器打中给对手攒拆解，攒到一定点数就削弱那一项，只在这一场。没到一阶只拆一半；一阶拆满第一档；二阶还能拆到第二档；三阶拆完第二档再打赢，掉落偏向兽材与素材。"
texts = {
"en": "{faith:hunt} governs comparison, difference and dissection. The Empire does not worship this god, but common hunters do. Faith points come from winning battles, with extra when you take the foe down to the first Dismantle stage, and from placing a kind of beast part into your pack for the first time in a run, more for rarer kinds. This god favors Offerings of beast parts and food, with beast parts earning the highest multiplier.

Following this god lets you Dismantle: at the start of battle you mark the foe's best strength, Armor, recovery or attack tempo, or leave it Exposed if it has none; weapon hits build Dismantle on the foe, and enough of it weakens that strength for this battle. Below Rank one you only get half; Rank one completes the first stage; Rank two adds a second stage; at Rank three, winning after the second stage makes the loot lean toward beast parts and materials."
}
related = Array[String](["faith_power_and_tiers", "altar_offering", "hunters"])
see_items = Array[StringName]([&"charm_hunt"])
