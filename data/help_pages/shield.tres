[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_nuhc7"]

[resource]
script = ExtResource("1_nuhc7")
id = &"shield"
display_name = "护盾"
category = &"combat"
order = 2
text = "护盾是先于生命被扣的一层资源。开战时按护盾上限充满，之后不自己回复；带护盾上限的护甲越多，开战时这一层越厚，也有道具在战斗中往上叠。能被护盾吸收的伤害先扣护盾，扣完才扣血。

中毒和流血无视护盾，直接伤在里面；反伤与火焰照样被护盾吸收。受伤前效果看到的是护盾吸收之后剩下的那部分。战斗结束护盾清零，下一场重新按上限充。"
related = Array[String](["direct_damage_and_armor", "buffs_and_stacks", "护盾"])
see_items = Array[StringName]([&"plate_cuirass", &"warding_charm"])
