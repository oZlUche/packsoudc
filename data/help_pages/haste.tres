[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_hn3nj"]

[resource]
script = ExtResource("1_hn3nj")
id = &"haste"
display_name = "急速"
category = &"combat"
order = 5
text = "急速是出手速度的倍率，基准是一倍：冷却的实际时长等于周期除以急速，急速越高冷却越短；冷却有下限，快到一定程度不再变快。它是一条属性，所以包体、邻接、信仰加成、急速药都能改它，这些加成在急速自己的乘区里相加。

冷却是快照语义：出手那一刻按当时的速率算死下一次时刻，之后不再重算，所以战斗中新来的急速只影响再下一次出手，正在走的这一轮不变快。作用于角色本身的加速与减速走标准轴，层数相抵之后再乘到急速的终值上。"
related = Array[String](["stamina_and_cooldown", "multipliers", "急速", "冷却"])
