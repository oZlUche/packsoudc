[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_jir6o"]

[resource]
script = ExtResource("1_jir6o")
id = &"belt_skills"
display_name = "腰带与随身技能"
category = &"bag"
order = 8
text = "屏幕右下角那排圆槽是{b}腰带{/b}，放的是随身技能：用一次少一个的小招，不是道具 —— 不占棋盘、没有重量、不进包也不进仓库，撤离时没用完的就没了。每个槽放一种，同一种叠在一起，角上的数字是还剩几个；槽的数量有限，都占满了就买不进新的一种。

双击圆槽用一个，用不了的时候槽上会说为什么。有的只能在地图上用，比如{b}急救包{/b}回体力（体力满了用不了）；有的只能在战前准备屏用，比如{b}烟雾弹{/b}：这一仗直接躲开，不打、没有战利品、也不掉体力，但核心的战斗躲不开。随身技能现在从商店的「随身」一行买，买下直接进腰带。"
related = Array[String](["shop", "vitality", "battle_and_prebattle"])
