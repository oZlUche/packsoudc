[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_4aean"]

[resource]
script = ExtResource("1_4aean")
id = &"god_nature"
display_name = "自然之神"
category = &"faith"
order = 7
text = "{faith:nature}管回归与容纳，和生命密切相关，信徒极广。信力看的是带自然印记的道具出手，以及战斗内的回血，都有每场上限。献祭爱自然之物、食物与防具。自然之神赐福防具和自然道具，赐福版激活即加生命，再按信力累计加防护。

一阶起开战就带着每秒回血；二阶在神坛上献祭食物时顺带恢复体力，每个神坛有上限；三阶开战时按包里的食物给护盾，越稀有的食物给得越多；四阶食物的效果翻倍，献祭食物回的体力也翻倍；五阶进入加时后大量回血。"
related = Array[String](["special_rites", "faith_power_and_tiers", "altar_offering"])
see_items = Array[StringName]([&"charm_nature", &"ration"])
