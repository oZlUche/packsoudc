[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_4aean"]

[resource]
script = ExtResource("1_4aean")
id = &"god_nature"
display_name = "自然之神"
display_names = {
"en": "God of Nature"
}
category = &"faith"
order = 7
text = "{faith:nature}管回归与容纳，和生命密切相关，信徒极广。奉祂时，一场里新生、枯萎各积到一成生命，经验值各再多给。献祭爱自然之物、食物与防具。自然之神赐福盾牌、防具和自然道具，赐福版激活即加生命，再按经验值累计：盾牌加格挡，别的加护甲上限。

奉了祂就有【枯萎】和【新生】：敌人每失去一点生命，身上多一层枯萎；你每恢复一点生命，身上多一层新生，持续伤害、持续恢复都算。进入对局和 {level:qual} 级各选一张自然之神的质变牌（凋零、生长、护佑、收割、丰饶、轮回……），升级时还会出自然之神的基础牌。二阶还能在神坛上献祭食物时顺带恢复体力。"
texts = {
"en": "{faith:nature} governs return and containment, is closely bound to life, and has followers almost everywhere. While you follow this god, you gain extra XP when your Rebirth and the enemy's Wither each reach a tenth of Health in a battle. Offerings favor natural things, food and armor. The God of Nature blesses shields, armor and natural items: a Blessed version adds Health on activation, then builds with your XP, adding Block to shields and max Armor to everything else.

Following them grants Wither and Rebirth: each point of Health the enemy loses gives it a stack of Wither, and each point you restore gives you a stack of Rebirth, including damage and healing over time. At the start of a run and at levels {level:qual} you pick one of the God of Nature's qualitative cards (Withering Blight, Growth, Sheltering Bark, Reaping, Bounty, Cycle...), and level-ups also offer the god's base cards. At the second tier you can also restore Vitality when offering food at an Altar."
}
related = Array[String](["special_rites", "faith_power_and_tiers", "altar_offering"])
see_items = Array[StringName]([&"charm_nature", &"ration"])
needs_faith = true
