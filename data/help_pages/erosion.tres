[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_caayo"]

[resource]
script = ExtResource("1_caayo")
id = &"erosion"
display_name = "侵蚀"
category = &"map"
order = 7
text = "侵蚀是进阶难度才有的机制：从某一步起，地图从最外一圈开始逐层向内被侵蚀，每隔一段再进一层。推进前几步会预警，快被侵蚀的那一圈闪红环，地图上写着下一档还有几步。

被侵蚀的点永远能走，只是有代价：走进去扣体力，越深扣越多；侵蚀得深了还可能毁掉包里最值钱的一件，有的难度还丢钱。最内一圈也被侵蚀后进入终局，更重的效果从此生效。出口在外面、宝藏在里面、外面正在烂掉，每一步都在问值不值得再深入。"
related = Array[String](["vitality", "countdown_and_closing", "extraction_and_defeat"])
