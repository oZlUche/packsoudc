[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_4m05r"]

[resource]
script = ExtResource("1_4m05r")
id = &"direct_damage_and_armor"
display_name = "直接伤害与防护"
category = &"combat"
order = 1
text = "一切扣血都走同一条管线：先看类型能不能被护盾吸收，再过受伤前效果，减伤、免疫、反转都在这里，再按百分比与固定增减算，然后才轮到防护。防护只减直接伤害，也就是武器出手造成的那一下，固定减掉写着的数、减到零为止；为负是破绽，反而多挨。

buff 造成的伤害不是直接伤害：中毒、流血、灼烧都绕过防护，中毒与流血连护盾也无视。只有直接攻击会招致反应，反伤、吸血这类规则不会被持续伤害触发，所以两件反伤道具不会互相对轰。伤害类型和乘区是两回事：乘区放大伤害的数值，类型决定它吃不吃护盾与防护。"
related = Array[String](["shield", "buffs_and_stacks", "multipliers", "直接伤害", "防护"])
see_items = Array[StringName]([&"tower_shield", &"poisoned_knife"])
