[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_pt0vv"]

[resource]
script = ExtResource("1_pt0vv")
id = &"god_brute"
display_name = "蛮神"
category = &"faith"
order = 5
text = "{faith:brute}是暴力与杀戮本身，石头砸下来也是暴力，北境蛮族信祂。信力看的是打出去和挨到的伤害，每场有上限；失去体力也算，输了也不白输。献祭爱骨制品、血肉、武器和大块的东西，骨制品与血肉的倍率尤其高。蛮神赐福武器，赐福版激活即增伤，再按信力累计加攻击。

一阶起血越少伤害越高；二阶可以在神坛上献祭生命上限换耐力上限与急速，能反复做，但生命上限有底；三阶在战前准备屏上花体力直接秒杀精英；四阶血归零后还能坚持一小段时间、期间耐力无限，到期血还是零才倒下，一场只一次。"
related = Array[String](["special_rites", "faith_power_and_tiers", "altar_offering"])
see_items = Array[StringName]([&"charm_brute", &"strength_sigil", &"tibia_violence"])
