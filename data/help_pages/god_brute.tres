[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_pt0vv"]

[resource]
script = ExtResource("1_pt0vv")
id = &"god_brute"
display_name = "蛮神"
display_names = {
"en": "The Brute"
}
category = &"faith"
order = 5
text = "{faith:brute}是暴力与杀戮本身，石头砸下来也是暴力，北境蛮族信祂。奉祂时，一场里挨了打积起怒气、低血打赢，经验值各再多给。献祭爱兽材、武器和大块的东西，兽材的倍率尤其高。蛮神赐福武器，赐福版激活即增伤，再按经验值累计加攻击。

奉了祂就有【怒气】：受到对手的伤害按掉的血积怒气，每一笔各自持续 {faith_perk:brute:brute_rage:duration_sec} 秒，不设上限。怒气本身不加属性；进入对局和 {level:qual} 级各选一张蛮神的质变牌（破甲、困兽、死斗、神罚、怒火中烧、痛觉残留、以血还血、恨意、血甲……），决定怒气怎么用，升级时还会出蛮神的基础牌，让怒气更长、更多、更凶。二阶还可以在神坛上献祭生命上限，换经验值或这局的造成伤害与急速。"
texts = {
"en": "{faith:brute} is violence and slaughter itself; even a falling stone is violence. The northern barbarians worship this god. While you follow this god, building Rage from the hits you take and winning at low Health each give extra XP. The Brute favors Offerings of beast parts, weapons and large things, with beast parts earning especially high multipliers. The Brute blesses weapons: a Blessed version deals extra damage on activation and gains more attack as your XP builds up.

Following this god grants Rage: damage from the foe builds Rage by the Health you lose; each batch lasts {faith_perk:brute:brute_rage:duration_sec} seconds on its own, and Rage has no cap. Rage itself grants no stats; at the start of a run and at levels {level:qual} you pick one of the Brute's Transformations (Sunder, Cornered Beast, Last Stand, Divine Wrath, Seething Fury, Lingering Pain, Blood for Blood, Spite, Blood Armor and more) to decide how Rage is spent, and level-ups also offer the Brute's base cards that make Rage last longer, stack higher and hit harder. At Rank two you can also offer up max Health at an Altar for XP or for extra damage and Haste this run."
}
related = Array[String](["special_rites", "faith_power_and_tiers", "altar_offering"])
see_items = Array[StringName]([&"charm_brute", &"tibia_violence"])
needs_faith = true
