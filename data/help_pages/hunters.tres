[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_uamvg"]

[resource]
script = ExtResource("1_uamvg")
id = &"hunters"
display_name = "猎手"
category = &"map"
order = 6
text = "猎手是进阶难度才有的机制：地图上会动的单位，不和节点互动，只找你。你每走一步它们动一回合，各在自己的领地里按自己的性子走，靠近、远离、游荡、埋伏或巡逻，互不进对方的领地。有的一直看得见，有的靠近才看见，有的隐形，侦察能让隐形的提前显形。

进了感知范围地图日志会说一句；够得着就先弹一屏「迎战 / 逃跑」。逃跑按成功率掷，没逃掉扣体力照打。迎战的对手按你当时的段位现造，打赢它死、掉落更多；打输按它的定义扣体力，它可能退走、消失，或把你赶回上一个点并驻守。"
related = Array[String](["vitality", "battle_and_prebattle", "erosion"])
