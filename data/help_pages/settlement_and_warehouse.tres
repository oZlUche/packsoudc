[gd_resource type="Resource" script_class="HelpPageDef" format=3]

[ext_resource type="Script" path="res://core/text/help_page_def.gd" id="1_fpt81"]

[resource]
script = ExtResource("1_fpt81")
id = &"settlement_and_warehouse"
display_name = "结算与仓库"
order = 6
text = "一局结束就进结算屏。撤离了，棋盘原样带回来，拖进{zone:仓库}或一键置入，带回来的每件在图鉴里计一次，剩的钱全部带出；没置入的可以留着，进开局屏时它们会放进那一屏的暂存区，拖上包就带走，不管的出发就没了。战败只有保险箱里的东西。

仓库是基地的一块格子，不要求包，所以包进不了仓库，只记进图鉴。仓库里的东西能在开局屏拖进初始包带进下一局；带入有价值预算，超了按比例换掉倒计时。结算屏还写着这一局的步数、几场胜负与信力节奏。

---"
related = Array[String](["warehouse", "codex", "safe_box", "staging_zone"])
