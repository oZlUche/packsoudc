[resource]
script = ExtResource("14_bnrvp")
id = &"magic_staff"
display_name = "魔法杖"
display_names = {
"en": "Magic Staff"
}
description = "不放晶石就是根木棍；杖头两侧的装载槽放魔晶石，按顺时针一颗一颗读，打出各自的元素伤害。颗与颗之间走单次冷却，一轮读完歇一个总冷却。装着魔晶石时出手不耗耐力。"
descriptions = {
"en": "Without a Crystal it's just a stick. Put Crystals in the loading slots on either side of its head; it reads them one at a time, clockwise, dealing each one's elemental damage. One single Cooldown between Crystals, one total Cooldown of rest after each full round. While a Crystal is loaded, it costs no Stamina."
}
shape = SubResource("Resource_vikiy")
rarity = 1
tags = Array[StringName]([&"weapon", &"melee", &"staff", &"magic", &"wood"])
combat = SubResource("Resource_b04a4")
adjacency = SubResource("Resource_1ekhf")
