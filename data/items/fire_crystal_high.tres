[resource]
script = ExtResource("20_u1pje")
id = &"fire_crystal_high"
display_name = "火焰魔晶核"
display_names = {
"en": "Greater Fire Crystal"
}
description = "放在法杖的装载槽上：法杖伤害 +{amount}，打出火焰伤害，打中后给对手施加两层【灼伤】。余焰：开战时先给对手两层【灼伤】。能供给 {max_charges} 场，用完就碎，碎了只能卖钱。"
descriptions = {
"en": "Set it in a staff's loading slot: staff Damage +{amount}, deals Fire damage, and each hit gives the opponent two stacks of Burn. Embers: at battle start, gives the opponent two stacks of Burn. Lasts {max_charges} battles, then shatters; a shattered one is only worth selling."
}
shape = SubResource("Resource_wi3nx")
rarity = 4
value = 650
tags = Array[StringName]([&"part", &"material", &"magic", &"gem", &"crystal", &"valuable"])
adjacency = SubResource("Resource_iavsm")
wear = SubResource("Resource_7gome")
crystal_family = &"fire"
