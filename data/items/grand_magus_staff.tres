[resource]
script = ExtResource("14_y81ep")
id = &"grand_magus_staff"
display_name = "大魔导杖"
display_names = {
"en": "Grand Magus Staff"
}
description = "大魔导师的杖，出手最快。杖头两侧和上方都有装载槽，放魔晶石，按顺时针一颗一颗读，打出各自的元素伤害。颗与颗之间走单次冷却，一轮读完歇一个总冷却。装着魔晶石时出手不耗耐力。"
descriptions = {
"en": "A grand magus's staff, the quickest of all. Loading slots on either side of its head and one above it take Crystals; it reads them one at a time, clockwise, dealing each one's elemental damage. One single Cooldown between Crystals, one total Cooldown of rest after each full round. While a Crystal is loaded, it costs no Stamina."
}
shape = SubResource("Resource_lrbwe")
rarity = 4
tags = Array[StringName]([&"weapon", &"melee", &"staff", &"magic"])
material = "wood"
combat = SubResource("Resource_vneu0")
adjacency = SubResource("Resource_pqiek")
