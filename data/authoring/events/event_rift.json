{
  "id": "event_rift",
  "title": "裂隙",
  "titles": {
    "en": "The Rift"
  },
  "text": "地面裂开一道缝，底下有风。跳进去会落到别处，落在哪儿说不准。",
  "texts": {
    "en": "The ground splits open, and wind rises from below. Jump in and you land somewhere else. No telling where."
  },
  "options": [
    {
      "label": "跳进去",
      "labels": {
        "en": "Jump in"
      },
      "outcomes": [
        {
          "type": "teleport",
          "min_steps": 2,
          "max_steps": 5
        },
        {
          "type": "say",
          "text": "风把你卷了进去。",
          "texts": {
            "en": "The wind pulls you in."
          }
        }
      ]
    },
    {
      "label": "顺着风走到底（需要步数 ≥ {steps_within_min_steps}）",
      "labels": {
        "en": "Follow the wind to the end (needs steps ≥ {steps_within_min_steps})"
      },
      "requires": [
        {
          "type": "steps_within",
          "min_steps": 4
        }
      ],
      "outcomes": [
        {
          "type": "teleport",
          "target": "FARTHEST",
          "min_steps": 2,
          "action_cost": 2
        },
        {
          "type": "spend_vitality"
        }
      ]
    },
    {
      "label": "绕开",
      "labels": {
        "en": "Go around"
      }
    }
  ]
}
