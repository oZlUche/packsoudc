{
  "id": "extract_default",
  "title": "撤离点",
  "titles": {
    "en": "Extraction Point"
  },
  "text": "能出去的地方。{c:warn}撤了这一局就结束{/c}：棋盘上的东西带回{zone:仓库}、包回包架，{zone:地上}的留在这儿，钱带出去。\n\n费用：{extract_fee} 币（零即免费）。",
  "texts": {
    "en": "A way out. {c:warn}Extract and this run ends{/c}: what's on your board goes back to the {zone:仓库} and your bags to the Bag Rack, what's on the {zone:地上} stays here, and your coins come with you.\n\nFee: {extract_fee} coins (zero means free)."
  },
  "options": [
    {
      "label": "撤离",
      "labels": {
        "en": "Extract"
      },
      "outcomes": [
        {
          "type": "extract"
        }
      ]
    },
    {
      "label": "再看看",
      "labels": {
        "en": "Not yet"
      },
      "outcomes": [
        {
          "type": "revisit_later"
        }
      ]
    },
    {
      "label": "查验这处出口",
      "labels": {
        "en": "Inspect this exit"
      },
      "hide_when_locked": true,
      "requires": [
        {
          "type": "commission_ready"
        }
      ],
      "outcomes": [
        {
          "type": "commission_act"
        },
        {
          "type": "next_event",
          "event": "extract_default"
        }
      ]
    },
    {
      "label": "把信交给接应员",
      "labels": {
        "en": "Hand the letter to the contact"
      },
      "hide_when_locked": true,
      "requires": [
        {
          "type": "commission_ready",
          "action": "deliver"
        }
      ],
      "outcomes": [
        {
          "type": "commission_act",
          "action": "deliver"
        },
        {
          "type": "next_event",
          "event": "extract_default"
        }
      ]
    },
    {
      "label": "托付",
      "labels": {
        "en": "Entrust"
      },
      "hide_when_locked": true,
      "requires": [
        {
          "type": "entrust_ready"
        }
      ],
      "outcomes": [
        {
          "type": "open_safe"
        }
      ]
    }
  ]
}
