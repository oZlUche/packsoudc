  },
  "options": [
    {
      "label": "给他 {change_money_amount|abs} 币",
      "labels": {
        "en": "Give him {change_money_amount|abs} coins"
      },
      "requires": [
        {
          "type": "can_afford"
        }
      ],
      "outcomes": [
        {
          "type": "change_money",
          "amount": -10
        },
        {
          "type": "grant_map_buff",
          "buff": "marked"
        },
        {
          "type": "say",
          "text": "他记住了你的脸。",
          "texts": {
            "en": "He remembers your face."
          }
        }
      ]
    },
    {
      "label": "不理他",
      "labels": {
        "en": "Ignore him"
      },
      "outcomes": [
        {
          "type": "say",
          "text": "他缩回了手。",
          "texts": {
            "en": "He pulls his hand back."
          }
        }
      ]
    }
  ]
