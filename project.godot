; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="背包搜打撤"
run/main_scene="res://ui/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/背包搜打撤"
config/custom_user_dir_name.linux="godot/app_userdata/背包搜打撤"

[autoload]

; 开发期导航：任何场景里按 F1 回启动选择器。见 ui/dev_nav.gd
DevNav="*res://ui/dev_nav.gd"
; 204：声音 —— 总线、音效播放器、按钮音钩子。见 ui/audio.gd
Audio="*res://ui/audio.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

confirm={
