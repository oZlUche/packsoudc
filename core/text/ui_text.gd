	"slots.sep": {"zh": "　", "en": " · "},
	"slots.confirm_delete_slot": {"zh": "再点一次确认删除（%s）", "en": "Click again to confirm (%s)"},
	# —— 计数（英文单复数）：[method count] 取；`_one` 是数为 1 时的写法 ——
	"unit.page": {"zh": "%d 页", "en": "%d pages"},
	"unit.page_one": {"zh": "%d 页", "en": "%d page"},
	"unit.item": {"zh": "%d 件", "en": "%d items"},
	"unit.item_one": {"zh": "%d 件", "en": "%d item"},
}


## 取一句；没有的键原样返回
static func t(key: String) -> String:
	return pick(TEXT.get(key, null), key)


## 数 + 量词：「3 页」/ 3 pages；数为 1 且有 `<unit>_one` 时取它（英文单数）
static func count(n: int, unit: String) -> String:
	return t(key_for(unit, n)) % n


## 按数取键：数为 1 且有 `<key>_one`（英文单数的写法）就取它，否则原键
static func key_for(key: String, n: int) -> String:
	return key + "_one" if n == 1 and TEXT.has(key + "_one") else key


## 同 [method t]，按 [param n] 分单复数（见 [method key_for]）
static func tn(key: String, n: int) -> String:
	return t(key_for(key, n))


## 一张「语言 → 文字」的小表按当前语言取；没有就中文、再没有给 [param fallback]；传进来的不是表就原样
## （null 给 [param fallback]）。界面文字、分类名、属性名……凡是 `{zh, en}` 小表都走这一条回退规则
static func pick(entry: Variant, fallback: String = "") -> String:
	if entry is Dictionary:
		var d := entry as Dictionary
		return String(d.get(lang, d.get("zh", fallback)))
	return String(entry) if entry != null else fallback


## 下一种语言（主菜单点一下切）
static func next_lang(current: String) -> String:
	var i := LANGS.find(current)
	return LANGS[(i + 1) % LANGS.size()] if i >= 0 else LANGS[0]


## 从设置里读当前语言
static func apply(settings: GameSettings) -> void:
	if settings != null and LANGS.has(settings.language):
		lang = settings.language
