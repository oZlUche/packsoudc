extends SceneTree
## 游戏测试 v9.55（PR #1032）：大地之神【玉石俱焚】开战界面红框 +「消耗」，上锁后标记换件，真点开战后那件没了。参数 <outdir>
const TAG := "JD1032"
const D383 := preload("res://tests/ui/test_departure_383.gd")
##HEAD##
var _c1: ItemInstance = null
var _chose := false
var _w1: ItemInstance = null
var _w2: ItemInstance = null
var _cr: ItemInstance = null

func _settle() -> bool:
	var scr := _flow.screen
	if scr == GameFlow.Screen.EVENT:
		if bool(_flow.last_payload.get("briefing", false)): _flow.close_briefing()
		else:
			var top = _game.overlay() if _game.overlay() != null else _game.base()
			if top != null and top.has_method("choose_event"): top.choose_event(0)
			elif top != null and top.has_method("proceed"): top.proceed()
			else: _flow.resume()
		return false
	if scr != GameFlow.Screen.MAP: return false
	for c in root.find_children("*", "CoachOverlay", true, false):
		(c as CoachOverlay).next(); return false
	return true


func _start_click() -> void:
	var sb: Button = _ms().get("_new_run_btn")
	if sb != null and sb.is_visible_in_tree(): _click(sb)
	elif sb != null: sb.pressed.emit()


func _setup_go() -> void:
	var sp: Node = null
	for n in root.find_children("*", "", true, false):
		if n.has_method("step_difficulty") and n.has_method("depart"): sp = n
	if sp == null: return
	var gb = sp.god_book() if sp.has_method("god_book") else null
	if gb != null: sp.close_god_book(); return
	for c in root.find_children("*", "CoachOverlay", true, false):
		(c as CoachOverlay).next(); return
	if not _chose and sp.faith_panel() != null:
		_chose = true
		L("开局屏奉大地之神：%s" % str(sp.choose_god(&"earth"))); return
	if sp.needs_spawn(): sp.pick_spawn(sp._preview.entry_ids()[0]); return
	if not sp.next_page(): sp.depart()


func _assist() -> void:
	var bk := _flow.meta.commissions
	bk.arrived[String(Pantheon.FACTION)] = 0
	bk.rep[String(Pantheon.FACTION)] = 100
	bk.signed[String(Pantheon.FACTION)] = 1
	if not _flow.meta.temples.has(&"earth"): _flow.meta.temples.append(&"earth")
	_flow.sync_commissions(); _flow.save_meta(); _flow.meta.changed.emit()
	L("测试辅助：万神院到来、声望 100、解锁大地神殿")


func _pre() -> Node:
	for n in root.find_children("*", "", true, false):
		if n.has_method("can_start") and n.has_method("start_battle") and (n as CanvasItem).is_visible_in_tree(): return n
	return null


func _doom() -> int:
	var p := _pre()
	if p == null: return -2
	var bv = p._inv.get("board_view") if p._inv != null else null
	return (bv as InventoryView).doom_uid if bv is InventoryView else -3


func _nm(uid: int) -> String:
	var it := _flow.run.board.get_item(uid) if uid >= 0 else null
	return "%s(uid %d，值 %d)" % [Names.of(it.def), uid, ItemValue.of_in(it, _flow.run.board)] if it != null else "无(%d)" % uid


func _process(_d: float) -> bool:
	_f += 1
	if _f % 250 == 0: print("%s ♥ f %d st %d 屏 %d wait %d" % [TAG, _f, _st, _flow.screen if _flow != null else -1, _wait])
	if _flow == null:
		_flow = _game.flow
		return false
	if _f > 9000:
		L("超时 st %d 屏 %d" % [_st, _flow.screen]); shot("timeout"); quit(1); return true
	if _wait > 0:
		_wait -= 1
		return false
	var scr := _flow.screen
	if _st < 3:
		if _boot(): _st = 3
		return false
	match _st:
		3:
			_assist()
			_tab("expedition"); _wait = 30; _st = 4
		4:
			_start_click(); _wait = 40; _st = 5
		5:
			if scr == GameFlow.Screen.META:
				_start_click(); _wait = 40; return false
			if scr == GameFlow.Screen.SETUP:
				_setup_go(); _wait = 20; return false
			if not _settle(): _wait = 10; return false
			if _flow.run.phase == RunState.Phase.PICK_SPAWN:
				_game.base().pick_spawn(_flow.run.map.entry_ids[0]); _wait = 20; return false
			var lp: Array = root.find_children("*", "LevelPickPanel", true, false)
			for p in lp:
				if (p as Control).is_visible_in_tree():
					(p as LevelPickPanel).choose(0); _wait = 30; return false
			var run := _flow.run
			var lv := LevelModule.of(run)
			L("进图：奉「%s」；没拿牌时 jade_uid = %d" % [String(run.active_faith_id()), EarthHeavenPerk.jade_uid(run)])
			lv.taken["god_earth_jade"] = 1
			_w1 = ItemInstance.create(run.items.get_def(&"flame_bonesteel_broadsword"))
			_w2 = ItemInstance.create(run.items.get_def(&"shortsword"))
			_cr = ItemInstance.create(run.items.get_def(&"earth_crystal")); _cr.set_stack(5)
			var placed := []
			for it in [_w1, _w2, _cr]: placed.append(run.board.try_add(it))
			run.board.touch()
			L("测试辅助：记上【玉石俱焚】；放传说骨钢大剑、短剑、5 个大地结晶（放进去 %s）；现在要消耗：%s" % [str(placed), _nm(EarthHeavenPerk.jade_uid(run))])
			_st = 6
		6:
			var moves: Array = _flow.run.travel.available_moves()
			var pick := -1
			for mv in moves:
				if NodeEvents.effective_type(_flow.run.map.get_node(int(mv))) == &"battle": pick = int(mv); break
			if pick < 0: L("相邻没有普通战斗点：%s" % str(moves)); _st = 99; return false
			L("走到相邻的普通战斗点 %d" % pick)
			_flow.step_to(pick); _wait = 60; _st = 7
		7:
			if scr == GameFlow.Screen.EVENT: _settle(); _wait = 10; return false
			if scr != GameFlow.Screen.PREBATTLE: L("（没进战前屏，屏 %d）" % scr); _st = 99; return false
			L("战前屏标的：%s；jade_uid：%s" % [_nm(_doom()), _nm(EarthHeavenPerk.jade_uid(_flow.run))])
			L("　　我方编进战斗的玉石俱焚伤害：%d" % EarthHeavenPerk.effect_for(LevelModule.of(_flow.run), _flow.run.board, _flow.run).jade)
			L("　　排版：%s" % _overflow(_pre()))
			shot("prebattle_doom"); _st = 8
		8:
			var top := EarthHeavenPerk.jade_uid(_flow.run)
			var it := _flow.run.board.get_item(top)
			if it != null: it.set_locked(true)
			_flow.run.board.touch()
			_pre()._refresh(); _wait = 20; _st = 9
		9:
			L("把它锁上后：战前屏标的 %s" % _nm(_doom()))
			shot("prebattle_doom_locked"); _st = 10
		10:
			var top := _doom()
			L("按开战（这一场应消耗 %s）：%s" % [_nm(top), str(_pre().start_battle())])
			_c1 = _flow.run.board.get_item(top)
			_wait = 120; _st = 11
		11:
			var gone := _c1 != null and not _flow.run.board.has_item(_c1.uid)
			var st := ""
			if _c1 != null and _c1.def.id == &"earth_crystal": st = "，结晶剩 %d 个" % (_c1.stack_count() if _flow.run.board.has_item(_c1.uid) else 0)
			L("开战后（屏 %d）：%s %s%s；骨钢大剑 %s、短剑 %s" % [scr, Names.of(_c1.def) if _c1 != null else "?", "没了" if gone else "还在", st,
				"在" if _flow.run.board.has_item(_w1.uid) else "没", "在" if _flow.run.board.has_item(_w2.uid) else "没"])
			shot("after_battle"); _st = 99
		99:
			L("完 err=0"); quit(0); return true
	return false
