extends SceneTree
## 游戏测试 v9.34 / v9.35（PR #1012）：选【耐行】后左上心数当场变；进点开着叠层时顶栏、经验条不被压暗；左上状态 / 委托石板两节收起、展开、下一局记住。参数 <outdir>
const TAG := "HS1012"
const D383 := preload("res://tests/ui/test_departure_383.gd")
##HEAD##
var _q: Array = []
var _bad := 0
var _runs := 0


func _dismiss() -> bool:
	for n in root.find_children("*", "Button", true, false):
		var b := n as Button
		if b.is_visible_in_tree() and (b.text == "知道了" or b.text.to_lower() == "got it"): _click(b); return true
	return false


func _w(id: StringName) -> HudWidget:
	for n in root.find_children("*", "HudWidget", true, false):
		var w := n as HudWidget
		if w.id == id and w.is_inside_tree(): return w
	return null


func _slate() -> Node:
	for n in root.find_children("*", "", true, false):
		if n.get_script() != null and String(n.get_script().resource_path).ends_with("status_slate_widget.gd") and (n as Control).is_visible_in_tree(): return n
	return null


func _slate_line() -> String:
	var s := _slate()
	if s == null: return "（石板没出来）"
	var st = s.find_child("Section_status", true, false)
	var cm = s.find_child("Section_commissions", true, false)
	return "状态节 %s 展开 %s 行 %s；委托节 %s 展开 %s 行 %s；石板 %s" % [("显示" if st != null and st.visible else "不显示"), str(s.is_open(&"status")), str(st.row_texts()) if st != null else "-", ("显示" if cm != null and cm.visible else "不显示"), str(s.is_open(&"commissions")), str(cm.row_texts()) if cm != null else "-", str((s as Control).get_global_rect())]


func _assist() -> void:
	var bk := _flow.meta.commissions
	for f in Commissions.factions():
		bk.arrived[String(f.id)] = 0
	for id in Commissions.FEATURES:
		bk.grants[String(id)] = true
	D383._two_menus(_flow)
	_flow.sync_commissions(); _flow.save_meta(); _flow.meta.changed.emit()


func _setup_go() -> void:
	var sp: Node = null
	for n in root.find_children("*", "", true, false):
		if n.has_method("step_difficulty") and n.has_method("depart"): sp = n
	if sp == null: return
	var gb = sp.god_book() if sp.has_method("god_book") else null
	if gb != null: sp.close_god_book(); return
	for c in root.find_children("*", "CoachOverlay", true, false):
		(c as CoachOverlay).next(); return
	if sp.needs_spawn(): sp.pick_spawn(sp._preview.entry_ids()[0]); return
	if not sp.next_page(): sp.depart()


func _settle() -> bool:
	var scr := _flow.screen
	if scr == GameFlow.Screen.EVENT:
		if bool(_flow.last_payload.get("briefing", false)): _flow.close_briefing()
		else:
			var top = _game.overlay() if _game.overlay() != null else _game.base()
			if top != null and top.has_method("choose_event"): top.choose_event(0)
			elif top != null and top.has_method("proceed"): top.proceed()
			else: _flow.resume()
		return false
	if scr != GameFlow.Screen.MAP: return false
	for c in root.find_children("*", "CoachOverlay", true, false):
		(c as CoachOverlay).next(); return false
	return true


## 开一局走到地图，回 true
func _to_map() -> bool:
	var scr := _flow.screen
	if scr == GameFlow.Screen.META:
		if _dismiss(): _wait = 30; return false
		var sb: Button = _ms().get("_new_run_btn")
		if sb != null: sb.pressed.emit()
		_wait = 40; return false
	if scr == GameFlow.Screen.SETUP: _setup_go(); _wait = 20; return false
	if not _settle(): _wait = 10; return false
	if _flow.run.phase == RunState.Phase.PICK_SPAWN:
		_game.base().pick_spawn(_flow.run.map.entry_ids[0]); _wait = 20; return false
	for p in root.find_children("*", "LevelPickPanel", true, false):
		if (p as Control).is_visible_in_tree(): (p as LevelPickPanel).choose(0); _wait = 30; return false
	return true


func _process(_d: float) -> bool:
	_f += 1
	if _f % 300 == 0: print("%s ♥ f %d st %d 屏 %d" % [TAG, _f, _st, _flow.screen if _flow != null else -1])
	if _flow == null:
		_flow = _game.flow
		return false
	if _f > 14000: L("超时 st %d 屏 %d" % [_st, _flow.screen]); shot("timeout"); quit(1); return true
	if _wait > 0: _wait -= 1; return false
	var scr := _flow.screen
	if _st < 3:
		if _boot(): _st = 3
		return false
	match _st:
		1000:
			if _q.is_empty(): return false
			var a: Array = _q.pop_front()
			(a[0] as Callable).call()
			_wait = int(a[1])
		3:
			_assist(); _tab("expedition"); _wait = 30; _st = 4
		4:
			if not _to_map(): return false
			_runs += 1
			# 测试辅助：随便接一个委托、加一个状态，让两节都有东西
			L("第 1 局到地图：%s" % _slate_line())
			shot("slate_start")
			_st = 5
		5:
			# 耐行：攒一级，把这一批换成耐行，真点
			var lv := LevelModule.of(_flow.run)
			lv.gain(lv.progress().y * 2.0 + 50.0, LevelModule.SRC_EVENT, "test")
			_wait = 30; _st = 6
		6:
			var lv := LevelModule.of(_flow.run)
			var vw := _w(&"vitality")
			set_meta("h0", vw.hearts() if vw != null else Vector2i(-1, -1))
			set_meta("m0", _flow.run.vitality.maximum)
			lv.offer()
			if lv.offer_ids.is_empty(): lv.offer_ids.append("card_vitality")
			else: lv.offer_ids[0] = "card_vitality"
			var panel: LevelPickPanel = null
			for p in root.find_children("*", "LevelPickPanel", true, false):
				if (p as Control).is_visible_in_tree(): panel = p
			L("待选 %d；这一批 %s；选牌窗 %s；体力 %d / %d，顶栏心 %s" % [lv.pending(), str(lv.offer()), "开着" if panel != null else "没开", _flow.run.vitality.current, _flow.run.vitality.maximum, str(get_meta("h0"))])
			if panel != null and panel.has_method("refresh"): panel.refresh()
			_wait = 20; _st = 7
		7:
			var panel: LevelPickPanel = null
			for p in root.find_children("*", "LevelPickPanel", true, false):
				if (p as Control).is_visible_in_tree(): panel = p
			if panel != null: panel.choose(0)
			else: LevelModule.of(_flow.run).pick(0)
			_wait = 2; _st = 8
		8:
			var vw := _w(&"vitality")
			var h: Vector2i = vw.hearts() if vw != null else Vector2i(-1, -1)
			L("拿了耐行（%d 张）两帧后：体力 %d / %d（原上限 %d）；顶栏心 %s（原 %s）" % [LevelModule.of(_flow.run).count_of(&"card_vitality"), _flow.run.vitality.current, _flow.run.vitality.maximum, get_meta("m0"), str(h), str(get_meta("h0"))])
			if _flow.run.vitality.maximum <= int(get_meta("m0")) or h == get_meta("h0"): _bad += 1; L("BAD 心没当场变")
			shot("after_vitality_card")
			_st = 9
		9:
			for p in root.find_children("*", "LevelPickPanel", true, false):
				if (p as Control).is_visible_in_tree(): (p as LevelPickPanel).choose(0); _wait = 20; return false
			# 进点：找个相邻的事件 / 搜索 / 战斗点
			var pick := -1
			for want in [&"event", &"search", &"battle"]:
				for m in _flow.run.travel.available_moves():
					if pick < 0 and NodeEvents.effective_type(_flow.run.map.get_node(int(m))) == want: pick = int(m)
			if pick < 0 and not _flow.run.travel.available_moves().is_empty(): pick = int(_flow.run.travel.available_moves()[0])
			L("走到相邻点 %d（%s）" % [pick, String(NodeEvents.effective_type(_flow.run.map.get_node(pick)))])
			set_meta("xp0", LevelModule.of(_flow.run).progress())
			_flow.step_to(pick); _wait = 60; _st = 10
		10:
			var lv := LevelModule.of(_flow.run)
			var hh = _game.base().get("_hud_host")
			var xb := _w(HudLayout.XP_BAR)
			L("进点后屏 %d，叠层 %s；顶栏抬到 z %s；经验 %s（进点前 %s）；经验条 z %s 在树 %s" % [scr, str(_game.overlay() != null), str(hh.get("lifted_z")) if hh != null else "-", str(lv.progress()), str(get_meta("xp0")), str(xb.z_index) if xb != null else "-", str(xb != null and xb.is_visible_in_tree())])
			shot("node_overlay")
			lv.gain(30.0, LevelModule.SRC_EVENT, "test")
			_wait = 3; _st = 11
		11:
			var xb := _w(HudLayout.XP_BAR)
			L("叠层开着时再得 30 经验：经验 %s；经验条 %s" % [str(LevelModule.of(_flow.run).progress()), xb.text_of() if xb != null and xb.has_method("text_of") else "-"])
			shot("node_overlay_xp")
			_st = 12
		12:
			if scr == GameFlow.Screen.PREBATTLE:
				_flow.start_battle(); _wait = 60; return false
			if scr == GameFlow.Screen.BATTLE or scr == GameFlow.Screen.LOOT:
				if scr == GameFlow.Screen.LOOT: _flow.resume()
				_wait = 30; return false
			if scr == GameFlow.Screen.SEARCH: _flow.close_search(); _wait = 30; return false
			for p in root.find_children("*", "LevelPickPanel", true, false):
				if (p as Control).is_visible_in_tree(): (p as LevelPickPanel).choose(0); _wait = 20; return false
			if not _settle(): _wait = 10; return false
			L("回到地图：%s" % _slate_line())
			var s := _slate()
			if s == null: _st = 99; return false
			var st = s.find_child("Section_status", true, false)
			var cm = s.find_child("Section_commissions", true, false)
			var kn: Control = st.knob if st != null and st.visible else null
			var kc: Control = cm.knob if cm != null and cm.visible else null
			_q = []
			if kn != null: _q.append([func(): _click(kn), 15])
			if kc != null: _q.append([func(): _click(kc), 15])
			_q.append([func():
				var gs = _flow.settings
				L("点两个圆钮收起：%s；设置 status_open %s commissions_open %s" % [_slate_line(), str(gs.status_open), str(gs.commissions_open)])
				if (kn != null and gs.status_open) or (kc != null and gs.commissions_open): _bad += 1
				var f := FileAccess.get_file_as_string("user://settings.json")
				L("　　磁盘上的设置：%s" % f.substr(maxi(0, f.find("status_open") - 2), 70).replace("\n", " "))
				shot("slate_collapsed")
				_st = 13, 5])
			_st = 1000
		13:
			# 这一局打完：体力耗尽再走一步
			L("测试辅助：直接撤离结束这一局")
			_flow.run.force_extract(); _flow.resume()
			_wait = 60; _st = 14
		14:
			if scr == GameFlow.Screen.RESULT: _flow.finish_result(); _wait = 60; return false
			if scr == GameFlow.Screen.META:
				L("第 1 局结束，回营地"); _tab("expedition"); _wait = 30; _st = 15; return false
			if scr == GameFlow.Screen.MAP and _flow.run != null and not _flow.run.is_over():
				L("（体力 %d，没结束；屏 %d）" % [_flow.run.vitality.current, scr]); _flow.save_and_quit(); _wait = 60; return false
			if scr in [GameFlow.Screen.EVENT, GameFlow.Screen.PREBATTLE, GameFlow.Screen.SEARCH, GameFlow.Screen.LOOT]: _flow.resume(); _wait = 30; return false
			if scr == GameFlow.Screen.MAIN_MENU: _flow.continue_game(); _wait = 60; return false
		15:
			if not _to_map(): return false
			var vw2 = _w(&"vitality")
			L("第 2 局体力 %d / %d；耐行张数 %d；顶栏心 %s" % [_flow.run.vitality.current, _flow.run.vitality.maximum, LevelModule.of(_flow.run).count_of(&"card_vitality"), str(vw2.hearts() if vw2 != null else Vector2i(-1, -1))])
			L("第 2 局（%s）到地图：%s" % ["新开的一局" if _flow.run != null and _flow.run.travel.history.size() <= 1 else "接着上一局", _slate_line()])
			var s := _slate()
			if s != null and s.is_open(&"commissions"): _bad += 1; L("BAD 下一局没记住收起")
			shot("slate_next_run")
			var st = s.find_child("Section_status", true, false) if s != null else null
			var kn: Control = st.knob if st != null and st.visible else null
			if kn != null:
				_q = [[func(): _click(kn), 15], [func(): L("再点状态的圆钮展开：%s" % _slate_line()); shot("slate_status_open"); _st = 99, 5]]
				_st = 1000
			else: _st = 99
		99:
			L("完 bad=%d" % _bad); quit(0); return true
	return false
