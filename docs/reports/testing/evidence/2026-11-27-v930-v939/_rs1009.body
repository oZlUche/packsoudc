extends SceneTree
## 游戏测试 v9.39（PR #1009）：结算页账单固定露 11 行，逐行显出自动往下滚停底部，点一下跳过也停底，滚轮一格一行，细滚动条，总分固定在底部横带。等级 ≥ 2 撤离。参数 <outdir>
const TAG := "RS1009"
const D383 := preload("res://tests/ui/test_departure_383.gd")
##HEAD##
var _bad := 0
var _samples := []
var _lg: LedgerView = null


func _dismiss() -> bool:
	for n in root.find_children("*", "Button", true, false):
		var b := n as Button
		if b.is_visible_in_tree() and (b.text == "知道了" or b.text.to_lower() == "got it"): _click(b); return true
	return false


func _setup_go() -> void:
	var sp: Node = null
	for n in root.find_children("*", "", true, false):
		if n.has_method("step_difficulty") and n.has_method("depart"): sp = n
	if sp == null: return
	var gb = sp.god_book() if sp.has_method("god_book") else null
	if gb != null: sp.close_god_book(); return
	for c in root.find_children("*", "CoachOverlay", true, false):
		(c as CoachOverlay).next(); return
	if sp.needs_spawn(): sp.pick_spawn(sp._preview.entry_ids()[0]); return
	if not sp.next_page(): sp.depart()


func _settle() -> bool:
	var scr := _flow.screen
	if scr == GameFlow.Screen.EVENT:
		if bool(_flow.last_payload.get("briefing", false)): _flow.close_briefing()
		else:
			var top = _game.overlay() if _game.overlay() != null else _game.base()
			if top != null and top.has_method("choose_event"): top.choose_event(0)
			elif top != null and top.has_method("proceed"): top.proceed()
			else: _flow.resume()
		return false
	if scr != GameFlow.Screen.MAP: return false
	for c in root.find_children("*", "CoachOverlay", true, false):
		(c as CoachOverlay).next(); return false
	return true


func _wheel(up: bool) -> void:
	var p := _lg.get_global_transform() * Vector2(400, 200)
	var c := root.get_final_transform() * p
	Input.warp_mouse(c)
	for down in [true, false]:
		var e := InputEventMouseButton.new()
		e.button_index = MOUSE_BUTTON_WHEEL_UP if up else MOUSE_BUTTON_WHEEL_DOWN
		e.pressed = down
		e.position = c
		e.global_position = c
		Input.parse_input_event(e)


func _process(_d: float) -> bool:
	_f += 1
	if _f % 300 == 0: print("%s ♥ f %d st %d 屏 %d" % [TAG, _f, _st, _flow.screen if _flow != null else -1])
	if _flow == null:
		_flow = _game.flow
		return false
	if _f > 12000: L("超时 st %d 屏 %d" % [_st, _flow.screen]); shot("timeout"); quit(1); return true
	if _wait > 0: _wait -= 1; return false
	var scr := _flow.screen
	if _st < 3:
		if _boot(): _st = 3
		return false
	match _st:
		3:
			D383._two_menus(_flow); _tab("expedition"); _wait = 30; _st = 4
		4:
			if scr == GameFlow.Screen.META:
				if _dismiss(): _wait = 30; return false
				var sb: Button = _ms().get("_new_run_btn")
				if sb != null: sb.pressed.emit()
				_wait = 40; return false
			if scr == GameFlow.Screen.SETUP: _setup_go(); _wait = 20; return false
			if not _settle(): _wait = 10; return false
			if _flow.run.phase == RunState.Phase.PICK_SPAWN:
				_game.base().pick_spawn(_flow.run.map.entry_ids[0]); _wait = 20; return false
			for p in root.find_children("*", "LevelPickPanel", true, false):
				if (p as Control).is_visible_in_tree(): (p as LevelPickPanel).choose(0); _wait = 20; return false
			var lv := LevelModule.of(_flow.run)
			if lv.level() < 3:
				lv.gain(lv.progress().y + 5.0, LevelModule.SRC_EVENT, "test"); _wait = 20; return false
			L("测试辅助：升到 %d 级；撤离" % lv.level())
			_flow.run.force_extract(); _flow.resume(); _wait = 5; _st = 5
		5:
			if scr != GameFlow.Screen.RESULT:
				if _f % 60 == 0: L("（屏 %d）" % scr)
				return false
			_lg = _game.base().ledger() if _game.base().has_method("ledger") else null
			if _lg == null:
				for n in root.find_children("*", "LedgerView", true, false): _lg = n
			if _lg == null: L("没找到账单"); _st = 99; return false
			L("账单：%d 行（明细 %d，最多往下翻 %d 行）；行 %s" % [_lg.rows().size(), _lg.detail_count(), _lg.max_scroll(), str(_lg.rows().map(func(r): return "%s=%s" % [r["label"], r.get("text", "")]))])
			_st = 6
		6:
			_samples.append("%d:%d" % [_f, _lg.scroll_rows()])
			if _f % 30 == 0 and _samples.size() < 60 and not _lg.is_revealed() and _lg.scroll_rows() == 1 and not has_meta("mid"): set_meta("mid", 1); shot("ledger_scrolling")
			if not _lg.is_revealed(): _wait = 6; return false
			_wait = 20; _st = 7
		7:
			var changes := []
			var last := -1
			for s in _samples:
				var v := int(String(s).split(":")[1])
				if v != last: changes.append(s); last = v
			L("逐行显出时翻到第几行（帧:翻过的行）变化：%s；显完翻过 %d 行（应 = 最多 %d）" % [str(changes), _lg.scroll_rows(), _lg.max_scroll()])
			if _lg.scroll_rows() != _lg.max_scroll(): _bad += 1
			shot("ledger_done_bottom")
			_wheel(true); _wait = 10; _st = 8
		8:
			var a := _lg.scroll_rows()
			_wheel(true); _wait = 10; set_meta("a", a); _st = 9
		9:
			var a: int = get_meta("a")
			L("滚轮上一格：翻过 %d 行；再上一格：%d 行" % [a, _lg.scroll_rows()])
			if a != maxi(0, _lg.max_scroll() - 1): _bad += 1
			shot("ledger_wheel_top")
			_wheel(false); _wait = 10; _st = 10
		10:
			L("滚轮下一格：翻过 %d 行" % _lg.scroll_rows())
			# 点一下跳过：重放一遍账单，开头就点
			var r = _game.base().get("_r")
			if r == null: L("（拿不到结果，跳过重放）"); _st = 99; return false
			_lg.setup(r, int(_flow.last_absorbed.get("lit", 0)))
			_wait = 20; _st = 11
		11:
			_click(_lg)
			_wait = 10; _st = 12
		12:
			L("重放账单开头点一下：全显 %s；翻过 %d 行（应 %d）" % [str(_lg.is_revealed()), _lg.scroll_rows(), _lg.max_scroll()])
			if not _lg.is_revealed() or _lg.scroll_rows() != _lg.max_scroll(): _bad += 1
			shot("ledger_skip_bottom")
			_st = 99
		99:
			L("完 bad=%d" % _bad); quit(0); return true
	return false
