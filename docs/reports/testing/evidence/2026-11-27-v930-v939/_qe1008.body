extends SceneTree
## 游戏测试 v9.31（PR #1008）：拖着道具 Q 逆时针 / E 顺时针、R 不转、滚轮照旧（仓库、苗圃、锅、背包、商店、战前）；地图左键 / 中键拖、轻点走、拖不误触、屏边小棋子。参数 <outdir>
const TAG := "QE1008"
const D383 := preload("res://tests/ui/test_departure_383.gd")
##HEAD##
var _q: Array = []
var _st_next := 0
var _rot0 := 0
var _inst: ItemInstance = null
var _gp := Vector2.ZERO
var _res := {}
var _mv: MapView = null
var _pan0 := Vector2.ZERO
var _cur0 := -1
var _target := -1
var _bad := 0


func _sub(key: String) -> void:
	_q = [[func(): _tab("logistics"), 30], [func(): _click(_ms()._sub_btns[key]), 40], [func(): _st = _st_next, 1]]
	_st = 1000


func _dismiss() -> bool:
	for n in root.find_children("*", "Button", true, false):
		var b := n as Button
		if b.is_visible_in_tree() and (b.text == "知道了" or b.text.to_lower() == "got it"): _click(b); return true
	return false


func _view_of(inst: ItemInstance) -> InventoryView:
	for n in root.find_children("*", "InventoryView", true, false):
		var v := n as InventoryView
		if v.is_visible_in_tree() and v.inventory != null and v.inventory.get_item(inst.uid) != null: return v
	return null


func _layer() -> DragLayer:
	for n in root.find_children("*", "DragLayer", true, false):
		if (n as DragLayer).is_dragging(): return n
	return null


func _btn(p: Vector2, button: int, down: bool) -> void:
	var c := root.get_final_transform() * p
	Input.warp_mouse(c)
	var e := InputEventMouseButton.new()
	e.button_index = button
	e.pressed = down
	e.position = c
	e.global_position = c
	if button == MOUSE_BUTTON_MIDDLE and down: e.button_mask = MOUSE_BUTTON_MASK_MIDDLE
	if button == MOUSE_BUTTON_LEFT and down: e.button_mask = MOUSE_BUTTON_MASK_LEFT
	Input.parse_input_event(e)


func _move(p: Vector2, mask: int = 0) -> void:
	var c := root.get_final_transform() * p
	Input.warp_mouse(c)
	var e := InputEventMouseMotion.new()
	e.position = c
	e.global_position = c
	e.button_mask = mask
	Input.parse_input_event(e)


func _key(code: int) -> void:
	for down in [true, false]:
		var e := InputEventKey.new()
		e.keycode = code
		e.physical_keycode = code
		e.pressed = down
		Input.parse_input_event(e)


func _r() -> int:
	var l := _layer()
	return int(l.get("_rot")) if l != null else -99


## 一块棋盘上的转向：排一串动作
func _rot_test(board: String, inst: ItemInstance, then: int) -> void:
	_inst = inst
	_st_next = then
	var v := _view_of(inst) if inst != null else null
	if v == null:
		L("【%s】找不到能抓的道具（%s）" % [board, Names.of(inst.def) if inst != null else "-"]); _bad += 1; _st = then; return
	var c0: Vector2i = inst.cells()[0]
	_gp = v.get_global_transform() * (v.cell_origin_px(inst.origin + c0) + Vector2.ONE * v.cell_px * 0.5)
	var r_before := inst.rotation
	_q = [
		[func(): _move(_gp); _btn(_gp, MOUSE_BUTTON_LEFT, true), 6],
		[func(): _move(_gp + Vector2(10, 6), MOUSE_BUTTON_MASK_LEFT), 6],
		[func(): _rot0 = _r(); L("【%s】抓起 %s（%s）：在拖 %s，朝向 %d" % [board, Names.of(inst.def), String(inst.def.id), str(_layer() != null), _rot0]); _key(KEY_Q), 6],
		[func(): _res["q"] = _r(); _key(KEY_E), 6],
		[func(): _res["qe"] = _r(); _key(KEY_E), 6],
		[func(): _res["e"] = _r(); _key(KEY_R), 6],
		[func(): _res["r"] = _r(); _btn(_gp + Vector2(10, 6), MOUSE_BUTTON_WHEEL_UP, true), 6],
		[func(): _res["wu"] = _r(); _btn(_gp + Vector2(10, 6), MOUSE_BUTTON_WHEEL_DOWN, true), 6],
		[func(): _res["wd"] = _r(); shot("%s_dragging" % board); _btn(_gp + Vector2(10, 6), MOUSE_BUTTON_RIGHT, true), 10],
		[func(): _btn(_gp + Vector2(10, 6), MOUSE_BUTTON_LEFT, false), 10],
		[func():
			var exp_q := posmod(_rot0 - 1, 4); var exp_e := posmod(_rot0 + 1, 4); var exp_wu := posmod(_rot0 + 2, 4)
			var ok: bool = _res["q"] == exp_q and _res["qe"] == _rot0 and _res["e"] == exp_e and _res["r"] == exp_e and _res["wu"] == exp_wu and _res["wd"] == exp_e
			var back := _view_of(inst) != null and inst.rotation == r_before and _layer() == null
			L("【%s】%s：Q → %d（应 %d），再 E → %d（应 %d），再 E → %d（应 %d），R → %d（应不变 %d），滚轮上 → %d（应 %d），滚轮下 → %d（应 %d）；右键放回：%s" % [board, "对" if ok else "不对", _res["q"], exp_q, _res["qe"], _rot0, _res["e"], exp_e, _res["r"], exp_e, _res["wu"], exp_wu, _res["wd"], exp_e, "回原处、朝向 %d" % inst.rotation if back else "没回原处（BAD）"])
			if not ok or not back: _bad += 1
			_st = _st_next, 5],
	]
	_st = 1000


func _assist() -> void:
	var bk := _flow.meta.commissions
	for f in Commissions.factions():
		bk.arrived[String(f.id)] = 0
	for id in Commissions.FEATURES:
		bk.grants[String(id)] = true
	D383._two_menus(_flow)
	Commissions.arrive(bk, 1)
	_assist_done(["growers_trial_sow", "growers_first_bed"], &"growers", 10)
	_flow.sync_commissions(); _flow.save_meta(); _flow.meta.changed.emit()


func _settle() -> bool:
	var scr := _flow.screen
	if scr == GameFlow.Screen.EVENT:
		if bool(_flow.last_payload.get("briefing", false)): _flow.close_briefing()
		else:
			var top = _game.overlay() if _game.overlay() != null else _game.base()
			if top != null and top.has_method("choose_event"): top.choose_event(0)
			elif top != null and top.has_method("proceed"): top.proceed()
			else: _flow.resume()
		return false
	if scr != GameFlow.Screen.MAP: return false
	for c in root.find_children("*", "CoachOverlay", true, false):
		(c as CoachOverlay).next(); return false
	return true


func _setup_go() -> void:
	var sp: Node = null
	for n in root.find_children("*", "", true, false):
		if n.has_method("step_difficulty") and n.has_method("depart"): sp = n
	if sp == null: return
	var gb = sp.god_book() if sp.has_method("god_book") else null
	if gb != null: sp.close_god_book(); return
	for c in root.find_children("*", "CoachOverlay", true, false):
		(c as CoachOverlay).next(); return
	if sp.needs_spawn(): sp.pick_spawn(sp._preview.entry_ids()[0]); return
	if not sp.next_page(): sp.depart()


func _node_gp(id: int) -> Vector2:
	return _mv.get_global_transform() * _mv.to_screen(_mv.positions()[id])


## 地图上一块空地（不在点、路、空位上），靠近屏中
func _empty_gp() -> Vector2:
	var r := _mv.get_global_rect()
	for k in 60:
		var p := r.get_center() + Vector2((k % 8 - 4) * 37.0, (k / 8 - 4) * 29.0)
		var c := _mv.to_canvas(_mv.get_global_transform().affine_inverse() * p)
		if _mv.node_at(c) < 0 and _mv.edge_at(c) == null and _mv.slot_at(c).is_empty(): return p
	return r.get_center()


func _process(_d: float) -> bool:
	_f += 1
	if _f % 300 == 0: print("%s ♥ f %d st %d 屏 %d" % [TAG, _f, _st, _flow.screen if _flow != null else -1])
	if _flow == null:
		_flow = _game.flow
		return false
	if _f > 14000: L("超时 st %d 屏 %d" % [_st, _flow.screen]); shot("timeout"); quit(1); return true
	if _wait > 0: _wait -= 1; return false
	var scr := _flow.screen
	if _st < 3:
		if _boot(): _st = 3
		return false
	match _st:
		1000:
			if _q.is_empty(): return false
			var a: Array = _q.pop_front()
			(a[0] as Callable).call()
			_wait = int(a[1])
		3:
			_assist()
			L("按键：逆时针 %s，顺时针 %s" % [str(InputKeys.keys_of(InputKeys.ROTATE_CCW)), str(InputKeys.keys_of(InputKeys.ROTATE_CW))])
			var w := _put("steel_greatsword")
			for id in ["fowl_leg", "big_pumpkin"]: _put(id, _flow.meta.canteen)
			var p := ItemInstance.create(_flow.items.get_def(&"rice_sack"), 0)
			p.uid = _flow.meta.allocate_uid()
			L("锅里放米袋：%s" % str(_flow.meta.canteen.pot.try_add(p)))
			set_meta("pot_item", p)
			set_meta("wh_item", w)
			_flow.save_meta(); _flow.meta.changed.emit()
			_flow.to_main_menu(); _wait = 30; _st = 4
		4:
			_flow.continue_game(); _wait = 40; _st = 5
		5:
			if scr != GameFlow.Screen.META: return false
			if _dismiss(): L("关掉一个告示"); _wait = 30; return false
			L("后勤小键 %s" % str(_ms()._sub_btns.keys()))
			_tab("warehouse"); _wait = 40; _st = 6
		6:
			var w: ItemInstance = null
			for it in _flow.meta.warehouse.items():
				if (it as ItemInstance).def.id == &"steel_greatsword": w = it
			_rot_test("仓库", w, 7)
		7:
			if not _ms()._sub_btns.has("canteen"): L("没有食堂小键"); _st = 9; return false
			_st_next = 8; _sub("canteen")
		8:
			var p: ItemInstance = null
			for it in _flow.meta.canteen.pot.items(): p = it
			if p == null: L("锅里没东西：%s" % str(_ids(_flow.meta.canteen.pot)))
			_rot_test("锅", p, 81)
		81:
			var s: ItemInstance = null
			for it in _flow.meta.canteen.store.items():
				if (it as ItemInstance).def.id == &"big_pumpkin": s = it
			_rot_test("食材仓库", s, 9)
		9:
			if not _ms()._sub_btns.has("nursery"): L("没有苗圃小键"); _st = 11; return false
			_st_next = 10; _sub("nursery")
		10:
			var np = _ms().nursery_panel()
			var why = np.sow(0, &"wild_berry") if np != null else "（没苗圃面板）"
			L("苗圃种一株野莓：%s" % ("成" if why == "" else why))
			_wait = 20; _st = 101
		101:
			var pl: Array = _flow.meta.nursery.plants(0)
			_rot_test("苗圃", pl[0] if not pl.is_empty() else null, 11)
		11:
			if _dismiss(): _wait = 30; return false
			_tab("expedition"); _wait = 30; _st = 12
		12:
			var sb: Button = _ms().get("_new_run_btn")
			if sb != null and sb.is_visible_in_tree(): _click(sb)
			elif sb != null: sb.pressed.emit()
			_wait = 40; _st = 13
		13:
			if scr == GameFlow.Screen.META and _dismiss(): _wait = 30; return false
			if scr == GameFlow.Screen.META:
				var sb: Button = _ms().get("_new_run_btn")
				if sb != null: sb.pressed.emit()
				_wait = 40; return false
			if scr == GameFlow.Screen.SETUP: _setup_go(); _wait = 20; return false
			if not _settle(): _wait = 10; return false
			if _flow.run.phase == RunState.Phase.PICK_SPAWN:
				_game.base().pick_spawn(_flow.run.map.entry_ids[0]); _wait = 20; return false
			for p in root.find_children("*", "LevelPickPanel", true, false):
				if (p as Control).is_visible_in_tree(): (p as LevelPickPanel).choose(0); _wait = 30; return false
			_game.base().toggle_bag(); _wait = 30; _st = 14
		14:
			var it: ItemInstance = null
			for x in _flow.run.board.items():
				if it == null and not (x as ItemInstance).def.tags.has(&"bag"): it = x
			_rot_test("背包", it, 15)
		15:
			_game.base().toggle_bag(); _wait = 30; _st = 41
		# —— 地图拖动 ——
		20:
			for n in root.find_children("*", "MapView", true, false):
				if (n as Control).is_visible_in_tree(): _mv = n
			if _mv == null: L("没地图"); _st = 99; return false
			shot("map_start")
			_pan0 = _mv.pan; _cur0 = _flow.run.travel.current_id
			var p := _empty_gp(); set_meta("p", p)
			_q = [
				[func(): _move(p); _btn(p, MOUSE_BUTTON_LEFT, true), 4],
				[func(): _move(p + Vector2(40, 20), MOUSE_BUTTON_MASK_LEFT), 3],
				[func(): _move(p + Vector2(80, 40), MOUSE_BUTTON_MASK_LEFT), 3],
				[func(): _move(p + Vector2(120, 60), MOUSE_BUTTON_MASK_LEFT), 3],
				[func(): _btn(p + Vector2(120, 60), MOUSE_BUTTON_LEFT, false), 10],
				[func():
					var d := _mv.pan - _pan0
					L("左键拖空地 (120, 60)：地图平移 %s；还在点 %d（原 %d）；屏 %d" % [str(d), _flow.run.travel.current_id, _cur0, _flow.screen])
					if d.length() < 100 or _flow.run.travel.current_id != _cur0: _bad += 1
					shot("map_left_dragged")
					_pan0 = _mv.pan
					_move(p); _btn(p, MOUSE_BUTTON_MIDDLE, true), 4],
				[func(): _move(p + Vector2(-50, -30), MOUSE_BUTTON_MASK_MIDDLE), 3],
				[func(): _move(p + Vector2(-100, -60), MOUSE_BUTTON_MASK_MIDDLE), 3],
				[func(): _btn(p + Vector2(-100, -60), MOUSE_BUTTON_MIDDLE, false), 10],
				[func():
					var d := _mv.pan - _pan0
					L("中键拖 (-100, -60)：地图平移 %s；还在点 %d" % [str(d), _flow.run.travel.current_id])
					if d.length() < 80: _bad += 1
					_st = 21, 5],
			]
			_st = 1000
		21:
			# 拖动起点落在相邻点上：不能误走
			var moves: Array = _flow.run.travel.available_moves()
			_target = -1
			for m in moves:
				if NodeEvents.effective_type(_flow.run.map.get_node(int(m))) == &"battle": _target = int(m)
			if _target < 0 and not moves.is_empty(): _target = int(moves[0])
			if _target < 0: L("没有相邻点"); _st = 99; return false
			_mv.focus(_target); _wait = 40; _st = 22
		22:
			var p := _node_gp(_target)
			_pan0 = _mv.pan
			L("相邻点 %d（%s）在屏上 %s" % [_target, String(NodeEvents.effective_type(_flow.run.map.get_node(_target))), str(p)])
			_q = [
				[func(): _move(p); _btn(p, MOUSE_BUTTON_LEFT, true), 4],
				[func(): _move(p + Vector2(30, 0), MOUSE_BUTTON_MASK_LEFT), 3],
				[func(): _move(p + Vector2(70, 10), MOUSE_BUTTON_MASK_LEFT), 3],
				[func(): _btn(p + Vector2(70, 10), MOUSE_BUTTON_LEFT, false), 20],
				[func():
					L("从相邻点上按下拖 (70, 10) 再松开：平移 %s；在点 %d（原 %d）；屏 %d（地图 %d）" % [str(_mv.pan - _pan0), _flow.run.travel.current_id, _cur0, _flow.screen, GameFlow.Screen.MAP])
					if _flow.run.travel.current_id != _cur0 or _flow.screen != GameFlow.Screen.MAP: _bad += 1; L("BAD 拖动误触了点")
					_st = 23, 5],
			]
			_st = 1000
		23:
			# 屏边小棋子
			_mv.stop_follow()
			_mv.pan += Vector2(1400, 900)
			_mv.queue_redraw()
			_wait = 20; _st = 24
		24:
			var r := _mv.offscreen_rect()
			L("把地图挪远：pan %s；屏边小棋子 %s" % [str(_mv.pan), str(r)])
			shot("map_pawn_offscreen")
			if r.size == Vector2.ZERO: L("（小棋子没出来，把 pan 再挪）"); _mv.pan = -_mv.pan; _mv.queue_redraw(); _wait = 20; _st = 241; return false
			_st = 25
		241:
			var r := _mv.offscreen_rect()
			L("反向挪：pan %s；屏边小棋子 %s" % [str(_mv.pan), str(r)])
			if r.size == Vector2.ZERO: _bad += 1; _st = 26; return false
			_st = 25
		25:
			var g := _mv.get_global_transform() * _mv.offscreen_rect().get_center()
			_pan0 = _mv.pan
			_q = [
				[func(): _move(g); _btn(g, MOUSE_BUTTON_LEFT, true), 2],
				[func(): _btn(g, MOUSE_BUTTON_LEFT, false), 90],
				[func():
					var want := _mv.focus_pan(_flow.run.travel.current_id)
					L("点屏边小棋子：pan %s → %s（自己的点该在 %s）；小棋子现在 %s；还在点 %d" % [str(_pan0), str(_mv.pan), str(want), str(_mv.offscreen_rect()), _flow.run.travel.current_id])
					if _mv.pan.distance_to(want) > 30 or _mv.offscreen_rect().size != Vector2.ZERO: _bad += 1; L("BAD 没回到自己")
					shot("map_recentered")
					_st = 26, 5],
			]
			_st = 1000
		26:
			_mv.focus(_target); _wait = 40; _st = 27
		27:
			var p := _node_gp(_target)
			_q = [
				[func(): _move(p); _btn(p, MOUSE_BUTTON_LEFT, true), 3],
				[func(): _move(p + Vector2(3, 2), MOUSE_BUTTON_MASK_LEFT), 2],
				[func(): _btn(p + Vector2(3, 2), MOUSE_BUTTON_LEFT, false), 60],
				[func():
					L("左键轻点相邻点 %d（按下后挪 3 px）：现在在点 %d；屏 %d" % [_target, _flow.run.travel.current_id, _flow.screen])
					if _flow.run.travel.current_id == _cur0 and _flow.screen == GameFlow.Screen.MAP: _bad += 1; L("BAD 轻点没走过去")
					_st = 28, 5],
			]
			_st = 1000
		28:
			if scr == GameFlow.Screen.MAP and _flow.run.travel.current_id == _cur0: L("（还没走）"); _st = 99; return false
			if scr != GameFlow.Screen.PREBATTLE:
				L("走到的不是战前屏（屏 %d），跳过战前" % scr); _st = 99; return false
			shot("prebattle")
			var it: ItemInstance = null
			for x in _flow.run.board.items():
				if it == null and not (x as ItemInstance).def.tags.has(&"bag"): it = x
			_rot_test("战前", it, 99)
		41:
			if not _settle(): _wait = 10; return false
			var belt := BeltModule.of(_flow.run)
			belt.add(&"earth_walk", 1); belt.changed.emit()
			var shop := -1
			for id in _flow.run.travel.available_moves():
				if NodeEvents.effective_type(_flow.run.map.get_node(int(id))) == &"shop": shop = int(id)
			if shop < 0:
				for id in EarthHeavenPerk.walk_targets(_flow.run):
					if NodeEvents.effective_type(_flow.run.map.get_node(int(id))) == &"shop": shop = int(id)
			if shop < 0:
				L("3 步之内没有商店：测试辅助在脚下这个点开一间商店")
				_flow.run.events._open_shop(_flow.run.map.get_node(_flow.run.travel.current_id)); _flow.resume()
				_wait = 60; _st = 42; return false
			L("测试辅助：去商店 %d" % shop)
			if _flow.run.travel.available_moves().has(shop): _flow.step_to(shop)
			else: _flow.earth_walk(shop)
			_wait = 60; _st = 42
		42:
			if scr == GameFlow.Screen.SHOP: _st = 43; return false
			if scr == GameFlow.Screen.EVENT: _settle(); _wait = 10; return false
			L("没进商店屏（屏 %d）" % scr); _st = 20
		43:
			shot("shop")
			var it: ItemInstance = null
			for x in _flow.run.board.items():
				if it == null and not (x as ItemInstance).def.tags.has(&"bag"): it = x
			_rot_test("商店", it, 44)
		44:
			if _flow.run.events.current_shop != null: _flow.run.events.current_shop.leave()
			_flow.resume(); _wait = 40; _st = 45
		45:
			if not _settle(): _wait = 10; return false
			_st = 20
		99:
			L("完 bad=%d" % _bad); quit(0); return true
	return false
