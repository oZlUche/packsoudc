extends SceneTree
## 游戏测试 v8.95（PR #966）：万神院神殿页定稿、《远道而来》、引导委托战败也算、告示栏每方保底。参数 <outdir>
## 新档拒教程 → 真走三局（每局走一步、测试辅助撤离）→ 万神院到来 → 后勤红点 → 万神院页：剪影、逐座悬停、点没落成的、点蛮神【确认解锁】→ 红点、解锁次数 →
## 测试辅助声望补到 150 → 解锁次数、再真点解锁日神、自然 → 出征选神界面（只有解锁的能奉）→ 奉蛮神开局 → 测试辅助加经验 → 选牌窗【重选】【跳过】真点 → 存档退出读回
const TAG := "CV966"
##HEAD##
var _k := 0
var _hi := 0
const GODS := ["brute", "sun", "nature", "skill", "hunt", "earth"]


func _sub(key: String) -> void:
	_click(_ms()._sub_btns[key])


func _dot(b: Control) -> String:
	if b == null: return "-"
	var d := b.get_node_or_null("RedDot") as RedDot
	return "无" if d == null or not d.visible else str(d.count)


func _pline() -> String:
	var m := _flow.meta
	return "到了 %s、声望 %d、挣到 %d 次、解锁了 %s、还剩 %d 次、能奉 %s；红点 后勤 %s 万神院 %s" % [str(Pantheon.arrived(m)), m.commissions.rep_of(Pantheon.FACTION), Pantheon.chances_earned(m), str(m.temples), Pantheon.chances(m),
		str(GODS.filter(func(x): return Pantheon.god_open(m, StringName(x)))), _dot(_ms()._tab_btns.get("logistics", null)), _dot(_ms()._sub_btns.get("pantheon", null))]


func _page() -> Control:
	return _ms().pantheon_panel()


func _temples_line() -> String:
	var o := []
	for g in GODS:
		var t := _named("Temple_" + g) as Button
		if t == null: o.append("%s 不在" % g); continue
		var img := t.find_child("Image", true, false) as TextureRect
		var nm := t.find_child("Name", true, false) as Label
		o.append("%s「%s」%s" % [g, nm.text if nm != null else "?", "剪影" if img != null and img.modulate.r < 0.5 else "亮"])
	var u := _named("Unlock") as Button
	var bar := _named("UnlockBar")
	var halo := []
	for g in GODS:
		var t := _named("Temple_" + g)
		if t != null and t.find_child("Halo", true, false) != null: halo.append(g)
		if t != null and t.find_child("Medal", true, false) != null: halo.append(g + "(徽)")
	return "%s；选中光/神徽 %s；底栏「%s」【%s】%s" % [" ".join(o), str(halo), _labels_under(bar).replace("\n", " ") if bar != null else "-", u.text if u != null else "-", "灰" if u == null or u.disabled else "亮"]


func _tip_visible() -> String:
	var o := []
	for w in root.find_children("*", "Window", true, false):
		if (w as Window).visible and w != root:
			o.append(_labels_under(w).left(200))
	for n in root.find_children("*", "PanelContainer", true, false):
		if String(n.name).to_lower().contains("tip") and (n as Control).is_visible_in_tree(): o.append(_labels_under(n).left(200))
	return str(o)


func _settle() -> bool:
	var scr := _flow.screen
	if scr == GameFlow.Screen.EVENT:
		if bool(_flow.last_payload.get("briefing", false)): _flow.close_briefing()
		else:
			var top = _game.overlay() if _game.overlay() != null else _game.base()
			if top != null and top.has_method("choose_event"): top.choose_event(0)
			elif top != null and top.has_method("proceed"): top.proceed()
			else: _flow.resume()
		return false
	if scr != GameFlow.Screen.MAP: return false
	for c in root.find_children("*", "CoachOverlay", true, false):
		(c as CoachOverlay).next(); return false
	return true


func _start_click() -> void:
	var sb: Button = _ms().get("_new_run_btn")
	if sb != null and sb.is_visible_in_tree(): _click(sb)
	elif sb != null: sb.pressed.emit()


func _setup_go() -> bool:
	if _flow.screen != GameFlow.Screen.SETUP: return false
	var sp: Node = null
	for n in root.find_children("*", "", true, false):
		if n.has_method("step_difficulty") and n.has_method("depart"): sp = n
	if sp == null: return false
	if sp.needs_spawn(): sp.pick_spawn(sp._preview.entry_ids()[0]); return false
	if not sp.next_page(): sp.depart()
	return false


func _bp() -> LevelPickPanel:
	var b = _game.base()
	return b.get("_level_pick_panel") if b != null else null


func _keys_line(p: LevelPickPanel) -> String:
	var o := []
	for nm in ["Reroll", "Remove", "Skip"]:
		var b := p.find_child(nm, true, false) as Button
		o.append("%s「%s」%s%s" % [nm, b.text if b != null else "-", "" if b != null and b.visible else "（不显示）", "（灰）" if b != null and b.disabled else ""])
	return " ".join(o)



func _bk() -> CommissionBook:
	return _flow.meta.commissions


func _herald() -> String:
	var bk := _bk(); var f := Commissions.faction(Pantheon.FACTION); var d := Commissions.def(&"pantheon_arrival")
	var pc := []
	for c in Commissions.of_faction(Pantheon.FACTION):
		if bk.state_of(c.id) != "": pc.append("%s=%s" % [String(c.id).trim_prefix("pantheon_"), bk.state_of(c.id)])
	return "撤离 %d 局；万神院到了 %s；接应中 %s；《远道而来》状态「%s」能接「%s」；拜访中「%s」；万神院委托 %s" % [bk.formal_extractions, str(Commissions.present(bk, f)), str(Commissions.heralding(bk, f)), bk.state_of(&"pantheon_arrival"), Commissions.why_not(bk, d), String(_flow.meta.visiting), str(pc)]


func _board() -> String:
	var bk := _bk(); var c := {}
	for nid in NoticeBoard.posted(bk): c[NoticeBoard._faction_of(bk, nid)] = int(c.get(NoticeBoard._faction_of(bk, nid), 0)) + 1
	var open := NoticeBoard.open_factions(bk).map(func(f): return String(f.id))
	return "开了常规的 %s；栏上没接的 %d 张，按方 %s；钉位 %d 个、空 %d" % [str(open), NoticeBoard.posted(bk).size(), str(c), bk.pins.size(), bk.pins.count("")]


func _cp() -> Control:
	return _ms().commission_panel()


func _story_line() -> String:
	var cp := _cp(); var g := cp.find_child("StoryGrid", true, false)
	if g == null: return "（没有剧情格）"
	var o := []
	for c in g.get_children():
		var keys := []
		for b in c.find_children("*", "Button", true, false):
			if (b as Button).is_visible_in_tree(): keys.append("%s%s" % [b.name, "（灰）" if (b as Button).disabled else ""])
		o.append("%s：%s %s" % [c.name, _labels_under(c).replace("\n", " ").left(160), str(keys)])
	return " ｜ ".join(o)


func _run_once(tag: String) -> void:
	set_meta("runtag", tag)


func _process(_d: float) -> bool:
	_f += 1
	if _flow == null:
		_flow = _game.flow
		return false
	if _f > 24000:
		L("超时 st %d 屏 %d" % [_st, _flow.screen]); shot("timeout"); quit(1); return true
	if _wait > 0:
		_wait -= 1
		return false
	var scr := _flow.screen
	if _st < 3:
		if _boot(): _st = 3
		return false
	match _st:
		3:
			L("新档进营地：%s；%s" % [_pline(), _herald()])
			_tab("expedition"); _wait = 30; _st = 4
		4:
			if scr == GameFlow.Screen.META:
				_start_click(); _wait = 40; _st = 5
		5:
			if scr == GameFlow.Screen.META:
				if _ms().god_pick() != null: L("（第 %d 局）出了选神界面" % (_k + 1)); _st = 99; return false
				_start_click(); _wait = 40; return false
			if scr == GameFlow.Screen.SETUP: _setup_go(); _wait = 20; return false
			if not _settle(): _wait = 10; return false
			if _flow.run.phase == RunState.Phase.PICK_SPAWN: _game.base().pick_spawn(_flow.run.map.entry_ids[0]); _wait = 20; return false
			var moves: Array = _flow.run.travel.available_moves()
			var pick := int(moves[0])
			for mv in moves:
				if not (NodeEvents.effective_type(_flow.run.map.get_node(int(mv))) in [&"battle", &"elite", &"core"]): pick = int(mv); break
			_flow.step_to(pick); _wait = 60; _st = 6
		6:
			if (scr == GameFlow.Screen.EVENT or scr == GameFlow.Screen.MAP) and not _settle(): _wait = 10; return false
			_flow.run.force_extract(); _flow.resume(); _wait = 40; _st = 7
		7:
			if scr == GameFlow.Screen.RESULT:
				_k += 1
				L("第 %d 局：走一步后测试辅助撤离；%s" % [_k, _herald()])
				if _k == 4: shot("result_4")
				_game.base().proceed(); _wait = 60; _st = 8
				return false
			if scr == GameFlow.Screen.EVENT or scr == GameFlow.Screen.MAP: _settle(); _wait = 10
		8:
			if scr != GameFlow.Screen.META: return false
			if _k < 3: _tab("expedition"); _wait = 30; _st = 4; return false
			if _k == 4: _wait = 60; _st = 20; return false
			_wait = 60; _st = 9
		9:
			var arr: Control = _ms().arrival()
			L("第 3 局后回营地：到来通知 %s；%s；%s" % [("「%s」" % _labels_under(arr).left(200)) if arr != null else "没有", _pline(), _herald()])
			L("　　后勤小键 %s" % str(_ms()._sub_btns.keys()))
			_tab("commissions"); _wait = 40; _st = 10
		10:
			var cp := _cp()
			if cp.sub() != "story": cp.show_sub("story"); _wait = 25; return false
			L("委托簿剧情页：%s" % _story_line())
			L("　　排版：%s" % _overflow(cp))
			shot("story_herald")
			var t := cp.find_child("Take_pantheon_arrival", true, false) as Button
			if t != null and t.is_visible_in_tree():
				_hover_at(t.get_global_rect().get_center()); _wait = 20; _st = 11; return false
			L("　　《远道而来》没有【接】键"); _st = 12
		11:
			_click(_cp().find_child("Take_pantheon_arrival", true, false) as Button); _wait = 30; _st = 12
		12:
			L("真点【接】以后：%s；剧情页 %s" % [_herald(), _story_line()])
			shot("story_taken")
			_tab("expedition"); _wait = 30; _st = 4
		20:
			var arr: Control = _ms().arrival()
			L("第 4 局（接着《远道而来》撤离）后回营地：到来通知 %s；%s；%s" % [("「%s」" % _labels_under(arr).left(300)) if arr != null else "没有", _pline(), _herald()])
			shot("arrival")
			if arr == null: _st = 22; return false
			var ok: Button = null
			for b in arr.find_children("*", "Button", true, false):
				if (b as Button).is_visible_in_tree(): ok = b
			_click(ok); _wait = 30; _st = 21
		21:
			L("点了到来通知的键：%s" % _pline())
			_tab("commissions"); _wait = 40; _st = 22
		22:
			var cp := _cp()
			if cp.sub() != "story": cp.show_sub("story"); _wait = 25; return false
			L("剧情页：%s" % _story_line())
			shot("story_ready")
			var fb := cp.find_child("Finish_pantheon_arrival", true, false) as Button
			if fb != null and fb.is_visible_in_tree(): _click(fb); _wait = 40; _st = 23; return false
			L("　　《远道而来》没有【完成】键"); _st = 24
		23:
			L("真点《远道而来》【完成】：%s；%s" % [_herald(), _pline()])
			_wait = 20; _st = 24
		24:
			if _ms().get("_tab_btns") != null: _tab("logistics")
			_wait = 30; _st = 25
		25:
			if not _ms()._sub_btns.has("pantheon"): L("后勤没有万神院小键：%s" % str(_ms()._sub_btns.keys())); _st = 99; return false
			_sub("pantheon"); _wait = 30; _st = 26
		26:
			var p := _page()
			L("万神院页：%s" % _labels_under(p).replace("\n", " ").left(500))
			L("　　神殿：%s" % _temples_line())
			L("　　排版：%s" % _overflow(p))
			shot("pantheon_page")
			_hi = 0; _st = 27
		27:
			if _hi >= GODS.size(): _hover_at(Vector2(5, 5)); _wait = 20; _st = 28; return false
			var t := _named("Temple_" + GODS[_hi]) as Button
			L("　　%s 悬浮窗「%s」" % [GODS[_hi], t.tooltip_text.replace("\n", " / ")])
			_hi += 1
		28:
			_click(_named("Temple_hunt")); _wait = 20; _st = 29
		29:
			L("点狩猎（没落成）：%s" % _temples_line())
			shot("pick_hunt")
			_click(_named("Temple_brute")); _wait = 20; _st = 30
		30:
			L("点蛮神：%s" % _temples_line())
			shot("pick_brute")
			_click(_named("Unlock")); _wait = 30; _st = 31
		31:
			L("真点【确认拜访】：%s；%s" % [_pline(), _herald()])
			L("　　拜访后再点日神：%s" % str(Pantheon.can_unlock(_flow.meta, &"sun")))
			L("　　神殿：%s；排版 %s" % [_temples_line(), _overflow(_page())])
			shot("after_unlock")
			# 告示栏保底：测试辅助开几方的常规，再把栏贴满灰灯一方
			var bk := _bk()
			for f in Commissions.factions():
				if not f.listed: continue
				bk.arrived[String(f.id)] = 0
				if f.permit != &"": _assist_done([String(f.permit)])
				if f.id != Pantheon.FACTION: bk.rep[String(f.id)] = maxi(bk.rep_of(f.id), 100)
			NoticeBoard._ensure_pins(bk)
			for i in bk.pins.size():
				if String(bk.pins[i]) != "" and bk.state_of(StringName(String(bk.pins[i]))) == "": bk.notes.erase(String(bk.pins[i])); bk.pins[i] = ""
			var r := RandomNumberGenerator.new(); r.seed = 966
			var gl := Commissions.faction(&"greylamp")
			while bk.pins.has("") and NoticeBoard._post(bk, r, gl): pass
			_flow.sync_commissions(); _flow.save_meta(); _flow.meta.changed.emit()
			L("测试辅助：各方到营地、许可单办成、声望 100（万神院不动）；告示栏只贴灰灯：%s" % _board())
			L("　　%s" % _herald())
			_tab("commissions"); _wait = 40; _st = 32
		32:
			var cp := _cp()
			if cp.sub() != "regular": cp.show_sub("regular"); _wait = 25; return false
			shot("board_before")
			var t := _cp().find_child("Take_pantheon_first_rite", true, false) as Button
			if _bk().state_of(&"pantheon_first_rite") == "" :
				_tab("commissions"); cp.show_sub("story"); _wait = 25; _st = 33; return false
			_st = 34
		33:
			var t := _cp().find_child("Take_pantheon_first_rite", true, false) as Button
			L("剧情页：%s" % _story_line())
			if t != null and t.is_visible_in_tree() and not t.disabled: _click(t); _wait = 30
			_st = 34
		34:
			L("出征前：%s" % _herald())
			_tab("expedition"); _wait = 30; _st = 35
		35:
			if scr == GameFlow.Screen.META: _start_click(); _wait = 40
			_st = 36
		36:
			if scr == GameFlow.Screen.META: _wait = 20; return false
			if scr == GameFlow.Screen.SETUP:
				for n in root.find_children("*", "", true, false):
					if n.has_method("step_difficulty") and n.has_method("depart"):
						if n.god_book() != null: n.close_god_book(); _wait = 20; return false
						var gc = n.god_coach()
						if gc != null: gc.next(); _wait = 15; return false
						if not get_meta("chose", false):
							set_meta("chose", true)
							var fp = n.faith_panel()
							var keys := []
							if fp != null:
								for b in (fp as Node).find_children("Choose_*", "Button", true, false):
									keys.append("%s「%s」%s" % [String(b.name).trim_prefix("Choose_"), (b as Button).text, "（灰）" if (b as Button).disabled else ""])
							L("出征屏：现在奉「%s」；信仰条「%s」；键 %s" % [String(n.chosen_faith()), n.faith_head_text(), str(keys)])
							shot("depart_locked")
							L("　　试着改奉日神 choose_god(sun) = %s；之后奉「%s」" % [str(n.choose_god(&"sun")), String(n.chosen_faith())])
				_setup_go(); _wait = 20; return false
			if get_meta("stepped", false):
				L("第 5 局奉「%s」、走了一步（屏 %d）；测试辅助判战败 fail = %s" % [String(_flow.run.selected_faith), scr, str(_flow.run.fail(&"vitality_depleted"))])
				_flow.resume(); _wait = 60; _st = 37; return false
			if not _settle(): _wait = 10; return false
			if _flow.run.phase == RunState.Phase.PICK_SPAWN: _game.base().pick_spawn(_flow.run.map.entry_ids[0]); _wait = 20; return false
			if not get_meta("stepped", false):
				set_meta("stepped", true)
				var moves: Array = _flow.run.travel.available_moves()
				var pick := int(moves[0])
				for mv in moves:
					if not (NodeEvents.effective_type(_flow.run.map.get_node(int(mv))) in [&"battle", &"elite", &"core"]): pick = int(mv); break
				_flow.step_to(pick); _wait = 60; return false
			L("第 5 局奉「%s」开局、走了一步；测试辅助判战败 fail = %s" % [String(_flow.run.selected_faith), str(_flow.run.fail(&"vitality_depleted"))])
			_flow.resume(); _wait = 60; _st = 37
		37:
			if scr == GameFlow.Screen.RESULT:
				L("第 5 局结算（战败）：成功撤离 %d 局" % _bk().formal_extractions)
				shot("result_defeat")
				_game.base().proceed(); _wait = 60; _st = 38; return false
			if scr == GameFlow.Screen.EVENT or scr == GameFlow.Screen.MAP: _settle(); _wait = 10
		38:
			if scr != GameFlow.Screen.META: return false
			L("战败回营地：%s；解锁了 %s；这一局拜访完的 %s；%s" % [_herald(), str(_flow.meta.temples), String(_flow.last_visited), _pline()])
			L("　　告示栏刷新以后：%s" % _board())
			_tab("logistics"); _wait = 30; _st = 381
		381:
			_sub("pantheon"); _wait = 30; _st = 382
		382:
			L("战败后万神院页：%s" % _temples_line())
			shot("pantheon_after")
			_tab("commissions"); _wait = 40; _st = 39
		39:
			var cp := _cp()
			if cp.sub() != "story": cp.show_sub("story"); _wait = 25; return false
			L("剧情页：%s" % _story_line())
			shot("story_after_defeat")
			for c in Commissions.of_faction(Pantheon.FACTION):
				var fb := cp.find_child("Finish_" + String(c.id), true, false) as Button
				if fb != null and fb.is_visible_in_tree():
					L("　　真点《%s》【完成】：%s" % [c.display_name, str(cp.finish(c.id).get("ok", false))])
			L("　　之后：%s；声望 %d；还可拜访 %d 次" % [_herald(), _bk().rep_of(Pantheon.FACTION), Pantheon.chances(_flow.meta)])
			cp.show_sub("regular"); _wait = 25; _st = 40
		40:
			L("常规页排版：%s" % _overflow(_cp()))
			shot("board_after")
			L("完 err=0"); quit(0); return true
		99:
			L("完 err=1"); quit(1); return true
	return false
