extends SceneTree
## 游戏测试 v8.21（PR #874，报告 383 第四批）：材料倾向跟着出生点走。参数 <outdir>
## 新档（倾向没开）看第三屏 → 测试辅助开倾向 → 第三屏：每个出生点的偏向、各不相同、图标、难度块宽 → 挑出生点看提示窗与选中的偏向 → 换章看
## → 返回再进（换种子）→ 出发看这一局的倾向 → 存档退出、继续看存着
const TAG := "SB874"
##HEAD##


func _sp() -> Node:
	return _game.base() if _flow.screen == GameFlow.Screen.SETUP else null


func _start_click() -> void:
	var sb: Button = _ms().get("_new_run_btn")
	if sb != null and sb.is_visible_in_tree(): _click(sb)
	elif sb != null: sb.pressed.emit()


func _p3(sp, tagname: String) -> String:
	var b: Dictionary = sp.spawn_biases()
	var ents: Array = sp.preview().entry_ids()
	var vals := {}
	for k in b: vals[String(b[k])] = true
	var db: Control = sp._diff_block
	return "%s：章「%s」规模 %s、种子 %d；出生点 %s；偏向 %s（%d 种不同）；预览 biases 同 %s；选中 %d → %s；难度块宽 %.0f；方向组件 %s；last_bias 标记 %s" % [tagname, String(sp.chapter().id), String(sp.scale_id), sp.run_seed, str(ents), str(b), vals.size(), str(sp.preview().biases == b), sp.spawn_id, String(sp.chosen_bias()), db.size.x if db != null else -1.0, str(sp.find_child("BiasBlock", true, false) != null), str(_flow.meta.flags.has("last_bias") or _flow.meta.flags.has(&"last_bias"))]


func _settle() -> bool:
	var scr := _flow.screen
	if scr == GameFlow.Screen.EVENT:
		if bool(_flow.last_payload.get("briefing", false)): _flow.close_briefing()
		else:
			var top = _game.overlay() if _game.overlay() != null else _game.base()
			if top != null and top.has_method("choose_event"): top.choose_event(0)
			elif top != null and top.has_method("proceed"): top.proceed()
			else: _flow.resume()
		return false
	if scr != GameFlow.Screen.MAP: return false
	for c in root.find_children("*", "CoachOverlay", true, false):
		(c as CoachOverlay).next(); return false
	return true


func _process(_d: float) -> bool:
	_f += 1
	if _flow == null:
		_flow = _game.flow
		return false
	if _f > 8000:
		L("超时 st %d 屏 %d" % [_st, _flow.screen]); shot("timeout"); quit(1); return true
	if _wait > 0:
		_wait -= 1
		return false
	if _st < 3:
		if _boot(): _st = 3
		return false
	_wait = 20
	match _st:
		3:
			_tab("expedition"); _st = 4
		4:
			_start_click(); _wait = 30; _st = 5
		5:
			var sp := _sp()
			if sp == null: return false
			sp.show_page(2); _st = 6
		6:
			var sp := _sp()
			L(_p3(sp, "倾向没开"))
			shot("p3_bias_closed")
			sp.cancel(); _st = 7
		7:
			if _flow.screen != GameFlow.Screen.META: return false
			_flow.meta.commissions.grants["bias"] = true
			L("测试辅助：开材料倾向")
			_start_click(); _wait = 30; _st = 8
		8:
			var sp := _sp()
			if sp == null: return false
			sp.show_page(2); _st = 9
		9:
			var sp := _sp()
			L(_p3(sp, "倾向开了"))
			L("　　第三页排版：%s" % _overflow(sp._pages[2]))
			shot("p3_spawn_bias")
			var ents: Array = sp.preview().entry_ids()
			sp.pick_spawn(int(ents[0])); set_meta("e", ents); _st = 10
		10:
			var sp := _sp()
			L("挑出生点 %d：选着的偏向 %s；提示窗：%s" % [sp.spawn_id, String(sp.chosen_bias()), _labels_under(sp.hint_card()).replace("\n", " / ").left(300)])
			shot("p3_pick_spawn")
			var ents: Array = get_meta("e")
			if ents.size() > 1: sp.pick_spawn(int(ents[1]))
			_st = 11
		11:
			var sp := _sp()
			L("改挑出生点 %d：选着的偏向 %s；提示窗：%s" % [sp.spawn_id, String(sp.chosen_bias()), _labels_under(sp.hint_card()).replace("\n", " / ").left(200)])
			shot("p3_pick_spawn2")
			var chs := []
			for i in sp._chapters.size():
				sp.choose_chapter(i); sp._sync_preview()
				chs.append("%s：%s" % [String(sp.chapter().id), str(sp.spawn_biases().values())])
			L("各章：%s" % "；".join(chs))
			sp.cancel(); _st = 12
		12:
			if _flow.screen != GameFlow.Screen.META: return false
			_start_click(); _wait = 30; _st = 13
		13:
			var sp := _sp()
			if sp == null: return false
			sp.show_page(2); _st = 14
		14:
			var sp := _sp()
			L(_p3(sp, "返回再进（新种子）"))
			var ents: Array = sp.preview().entry_ids()
			sp.pick_spawn(int(ents[ents.size() - 1])); set_meta("want", String(sp.chosen_bias())); _st = 15
		15:
			var sp := _sp()
			L("挑出生点 %d（偏 %s）后出发" % [sp.spawn_id, String(sp.chosen_bias())])
			sp.depart(); _wait = 40; _st = 16
		16:
			if not _settle(): return false
			var r := _flow.run
			L("开局：这一局倾向 %s（应是 %s）；spawn_bias %s；出生点 %d" % [String(r.material_bias), str(get_meta("want")), str(r.spawn_bias), r.travel.current if "travel" in r and r.travel != null and "current" in r.travel else -1])
			shot("run_map")
			L("存档退出：%s" % str(_flow.save_and_quit())); _wait = 40; _st = 17
		17:
			_flow.continue_game(); _wait = 40; _st = 18
		18:
			if not _settle(): return false
			L("继续游戏：倾向 %s；spawn_bias %s" % [String(_flow.run.material_bias), str(_flow.run.spawn_bias)])
			_st = 99
		_:
			quit(0); return true
	return false
