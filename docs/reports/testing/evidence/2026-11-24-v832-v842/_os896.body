extends SceneTree
## 游戏测试 v8.36（PR #896，报告 390）：老档换算。参数 <outdir> <mode>
## make_free：新档拒教程 → 出发 → 走到相邻普通战斗点、停在战前屏 → 记对手生命 / 耐力、我方生命 → 存档退出
## make_tut：新档接受教程 → 进序章图 → 记图上写死敌人数值的点 → 存档退出
## check：主菜单【继续】读档 → 记同样的数
const TAG := "OS896"
##HEAD##
var _mode := ""
var _hops := 0


func _foe_line(content: Dictionary) -> String:
	var ev := _flow.run.events
	var sp := EnemyKit.spec_of(content, ev.enemies, ev.pool, ev.items)
	return "%s：写死 %s，编译后生命 %s" % [String(content.get("enemy", "?")), JSON.stringify(content.get("base_stats", null)), str(sp.max_hp_int()) if sp != null else "-"]


func _dump() -> void:
	var r := _flow.run
	L("章节 %s，屏 %d，存档里的战斗版本 %s" % [String(r.chapter.id), _flow.screen, str(r.to_dict().get("battle_scale", "（没有这个键）"))])
	var me := r.compile_player()
	L("我方：生命上限 %d" % me.max_hp_int())
	if not r.events.pending_battle.is_empty():
		L("战前屏这一场：%s" % _foe_line(r.events.pending_battle.get("content", {})))
		var ps := r.events.pending_battle_spec()
		L("　　pending_battle_spec 生命 %d" % (ps.max_hp_int() if ps != null else -1))
	var n := 0
	for id in r.map.node_ids():
		var c: Dictionary = r.map.get_node(id).content
		if c.get("base_stats", null) is Dictionary:
			n += 1
			if n <= 6: L("　　点 %d %s" % [id, _foe_line(c)])
	L("图上写死敌人数值的点：%d 个" % n)



func _ev() -> void:
	if bool(_flow.last_payload.get("briefing", false)): _flow.close_briefing(); return
	var top = _game.overlay() if _game.overlay() != null else _game.base()
	if top != null and top.has_method("choose_event"): top.choose_event(0)
	elif top != null and top.has_method("proceed"): top.proceed()
	else: _flow.resume()

func _process(_d: float) -> bool:
	_f += 1
	if _flow == null:
		_flow = _game.flow
		var a := OS.get_cmdline_user_args()
		_mode = a[1] if a.size() > 1 else "check"
		return false
	if _f > 8000:
		L("超时 st %d 屏 %d" % [_st, _flow.screen]); shot("timeout"); quit(1); return true
	if _wait > 0:
		_wait -= 1
		return false
	var scr := _flow.screen
	if _mode == "check":
		match _st:
			0:
				if _f < 90: return false
				L("主菜单【继续】：%s" % str(_flow.continue_game())); _wait = 90; _st = 1
			1:
				if _flow.run == null: L("（没读到局）屏 %d" % scr); _st = 99; return false
				for c in root.find_children("*", "CoachOverlay", true, false):
					(c as CoachOverlay).next(); _wait = 10; return false
				_dump(); shot("loaded"); _st = 99
			99:
				L("完 err=0"); quit(0); return true
		return false
	if _mode == "make_tut":
		match _st:
			0:
				if _f < 60: return false
				_flow.start_new_game(); _st = 1
			1:
				var b = _game.base()
				if b != null and b.has_method("tutorial_ask_open") and b.tutorial_ask_open():
					b.accept_tutorial(); _wait = 120; _st = 2
				elif _f > 300:
					L("（没看到教程询问，直接 accept_tutorial）"); _flow.accept_tutorial(); _wait = 120; _st = 2
			2:
				if scr == GameFlow.Screen.EVENT:
					_ev()
					_wait = 20; return false
				if scr != GameFlow.Screen.MAP or _flow.run == null: return false
				_dump(); shot("before_save")
				L("存档退出：%s" % str(_flow.save_and_quit())); _wait = 60; _st = 99
			99:
				L("完 err=0"); quit(0); return true
		return false
	# make_free
	if _st < 3:
		if _boot(): _st = 3
		return false
	match _st:
		3:
			_tab("expedition"); _wait = 30; _st = 4
		4:
			var sb: Button = _ms().get("_new_run_btn")
			sb.pressed.emit(); _wait = 40; _st = 5
		5:
			if scr == GameFlow.Screen.SETUP:
				for n in root.find_children("*", "", true, false):
					if n.has_method("step_difficulty") and n.has_method("depart"):
						if n.needs_spawn(): n.pick_spawn(n._preview.entry_ids()[0])
						elif not n.next_page(): n.depart()
						break
				_wait = 20; return false
			if scr == GameFlow.Screen.EVENT:
				_ev()
				_wait = 10; return false
			if scr != GameFlow.Screen.MAP: return false
			for c in root.find_children("*", "CoachOverlay", true, false):
				(c as CoachOverlay).next(); _wait = 10; return false
			var lv := LevelModule.of(_flow.run)
			if lv != null and lv.pending() > 0:
				var p = _game.base().get("_level_pick_panel")
				if p != null: p.choose(0); _wait = 20; return false
			if _flow.run.phase == RunState.Phase.PICK_SPAWN:
				_game.base().pick_spawn(_flow.run.map.entry_ids[0]); _wait = 20; return false
			var pick := -1
			for mv in _flow.run.travel.available_moves():
				if NodeEvents.effective_type(_flow.run.map.get_node(int(mv))) == &"battle": pick = int(mv); break
			if pick < 0:
				_hops += 1
				if _hops > 6: L("走了 6 步还没碰到普通战斗点"); _dump(); _flow.save_and_quit(); _wait = 60; _st = 99; return false
				var mv0 := -1
				for mv in _flow.run.travel.available_moves():
					if not (NodeEvents.effective_type(_flow.run.map.get_node(int(mv))) in [&"elite", &"core", &"extract"]): mv0 = int(mv); break
				L("相邻没有普通战斗点，先走到 %d" % mv0); _flow.step_to(mv0); _wait = 60; return false
			_flow.step_to(pick); _wait = 60; _st = 6
		6:
			if scr != GameFlow.Screen.PREBATTLE: L("（没进战前屏，屏 %d）" % scr)
			_dump(); shot("prebattle")
			L("存档退出：%s" % str(_flow.save_and_quit())); _wait = 60; _st = 99
		99:
			L("完 err=0"); quit(0); return true
	return false
